# --------------------------------------------------------------------------
# irc-tail: a debugging aid, no tvchat needed.  Connects one account and
# prints its events as plain text; a typed line is sent to the newest
# channel or query ("/join #chan" and "/quit" also work).
# --------------------------------------------------------------------------
def _tail_format(fields):
    etype, rest = fields[0], fields[1:]
    if etype == "msg":
        _, conv, when, _, who, flags, text = rest
        hhmm = time.strftime("%H:%M", time.localtime(parse_server_time(when) or 0))
        where = conv.split("/", 1)[1]
        if "a" in flags:
            return "%s %s * %s %s" % (hhmm, where, who, text)
        if "n" in flags and not who:
            return "%s %s -- %s" % (hhmm, where, text)
        mark = "-%s-" if "n" in flags else "<%s>"
        return "%s %s %s %s" % (hhmm, where, mark % who, text)
    return "** %s %s" % (etype, " ".join(str(x) for x in rest))


def cmd_irc_tail(a):
    chat = _chat()
    acct = chat.account(a.account)
    if acct.protocol != "irc":
        raise UserError("%s is not an IRC account" % acct.id)
    loop = chat.loop
    out = sys.stdout
    if a.raw:
        chat.adapter(acct).raw_tap = lambda d, t: out.write("%s %s\n" % (d, t))
    cur = [None]
    seen = [None]
    fd = sys.stdin.fileno()

    def pump():
        for seq, fields in chat.events.drain(seen[0]):
            seen[0] = seq
            if fields[0] == "conv-new" and fields[2] != "server":
                cur[0] = fields[1]
            out.write(_tail_format(fields) + "\n")
        out.flush()
        loop.call_later(0.1, pump)

    def on_stdin():
        data = os.read(fd, 4096)
        if not data:
            loop.stop()
            return
        for ln in data.decode("utf-8", "replace").splitlines():
            try:
                if ln.startswith("/quit"):
                    loop.stop()
                elif ln.startswith("/join "):
                    cur[0] = chat.adapter(acct).join(ln[6:]).id
                elif ln.strip() and cur[0]:
                    chat.adapter(acct).send(chat.conv(cur[0]), ln)
                elif ln.strip():
                    out.write("** nothing to send to yet - /join a channel\n")
            except UserError as e:
                out.write("** %s\n" % e)

    chat.connect(acct)
    loop.add_reader(fd, on_stdin)
    loop.call_later(0, pump)
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    finally:
        chat.close()
        for seq, fields in chat.events.drain(seen[0]):
            out.write(_tail_format(fields) + "\n")
    return 0


# --------------------------------------------------------------------------
# serve: the persistent co-process tvchat talks to.  Same framing as
# tvmail-backend serve, but stdin is one of several sources in the selectors
# loop, so incoming chat traffic is read (and queued) while the UI is idle.
# Every request is answered at once - anything slow (connecting) replies
# immediately and reports progress as events - so a reply always beats the
# UI's 8 s read timeout.
# --------------------------------------------------------------------------
class _CapStream:
    """stdout stand-in while a verb runs: its output becomes the reply body."""

    def __init__(self):
        self.buffer = io.BytesIO()

    def write(self, s):
        self.buffer.write(s.encode("utf-8", "replace") if isinstance(s, str) else s)
        return len(s)

    def flush(self):
        pass

    def isatty(self):
        return False


_SERVE_BLOCKED = frozenset(("serve", "irc-tail"))


def dispatch(parser, argv):
    """Run one request argv.  Returns (status:int, body:bytes)."""
    if argv and argv[0] in _SERVE_BLOCKED:
        return 2, ("tvchat-backend: '%s' is not available in serve mode\n"
                   % argv[0]).encode("utf-8")
    real = sys.stdout
    cap = _CapStream()
    sys.stdout = cap
    try:
        ns = parser.parse_args(argv)
        return (ns.fn(ns) or 0), cap.buffer.getvalue()
    except UserError as e:
        return 1, (str(e) + "\n").encode("utf-8", "replace")
    except SystemExit as e:                      # argparse: unknown verb &c
        code = e.code
        if isinstance(code, str):
            cap.write(code if code.endswith("\n") else code + "\n")
            return 2, cap.buffer.getvalue()
        return (int(code) if code else 0), cap.buffer.getvalue()
    except Exception as e:                       # keep the server alive
        cap.write("tvchat-backend: %s: %s\n" % (type(e).__name__, e))
        return 2, cap.buffer.getvalue()
    finally:
        sys.stdout = real


class _ArgParser(argparse.ArgumentParser):
    """argparse that says what went wrong in the reply body (serve mode has
    stderr pointed at /dev/null) instead of printing usage to stderr."""

    def error(self, message):
        raise SystemExit("%s: %s" % (self.prog, message))


def cmd_serve(a):
    raw_out = getattr(sys.stdout, "buffer", sys.stdout)
    try:                                         # stray output mustn't hit the TUI
        sys.stderr = open(os.devnull, "w")
    except OSError:
        pass
    parser = build_parser()
    chat = _chat()
    loop = chat.loop
    fd = sys.stdin.fileno()
    pending = [b""]

    def emit(status, body):
        raw_out.write(("%d %d\n" % (status, len(body))).encode("ascii") + body)
        raw_out.flush()

    def handle(text):
        text = text.strip()
        if not text:
            return
        if text in ("quit", "exit"):
            loop.stop()
            return
        try:
            argv = shlex.split(text)
        except ValueError:
            emit(2, b"tvchat-backend serve: unparseable request line\n")
            return
        t0 = time.monotonic()
        try:
            st, body = dispatch(parser, argv)
        except Exception as e:
            _log.exception("request %r failed", text)
            st, body = 2, ("tvchat-backend serve: %s\n" % e).encode("utf-8")
        emit(st, body)
        # the UI polls `events` every 250 ms: only a poll that brought
        # something is worth a line
        if argv[:1] != ["events"] or body:
            _log.debug("request: %s -> %d, %d bytes, %.1f ms%s", text, st, len(body),
                       (time.monotonic() - t0) * 1000,
                       (": " + body.decode("utf-8", "replace").strip()[:300])
                       if st else "")

    def on_stdin():
        data = os.read(fd, 65536)
        if not data:                             # parent closed the pipe
            if pending[0]:
                handle(pending[0].decode("utf-8", "replace"))
            loop.stop()
            return
        pending[0] += data
        while b"\n" in pending[0] and loop.running:
            req, pending[0] = pending[0].split(b"\n", 1)
            handle(req.decode("utf-8", "replace"))

    emit(0, b"ready")                            # handshake banner
    loop.add_reader(fd, on_stdin)
    chat.start()                                 # [chat] autoconnect
    try:
        loop.run()
    finally:
        loop.remove_reader(fd)
        chat.close()
    return 0


def build_parser():
    ap = _ArgParser(prog="tvchat-backend", add_help=True)
    ap.add_argument("--version", action="version",
                    version="tvchat-backend %s" % __version__)
    ap.add_argument("--debug", nargs="?", const="debug.tvchat.backend.log", metavar="FILE",
                    help="write diagnostic logging to FILE (default: debug.tvchat.backend.log)")
    ap.add_argument("--trace", nargs="?", const="trace.tvchat.backend.log", metavar="FILE",
                    help="write cProfile data to FILE (default: trace.tvchat.backend.log)")
    sub = ap.add_subparsers(dest="cmd", parser_class=_ArgParser)
    sub.required = True

    p = sub.add_parser("accounts"); p.set_defaults(fn=cmd_accounts)
    p = sub.add_parser("connect"); p.add_argument("account"); p.set_defaults(fn=cmd_connect)
    p = sub.add_parser("disconnect"); p.add_argument("account"); p.set_defaults(fn=cmd_disconnect)
    p = sub.add_parser("convs"); p.add_argument("account", nargs="?"); p.set_defaults(fn=cmd_convs)
    p = sub.add_parser("join"); p.add_argument("account"); p.add_argument("target"); p.set_defaults(fn=cmd_join)
    p = sub.add_parser("invite"); p.add_argument("account"); p.set_defaults(fn=cmd_invite)
    p = sub.add_parser("invites"); p.set_defaults(fn=cmd_invites)
    p = sub.add_parser("new-group"); p.add_argument("account"); p.add_argument("name"); p.add_argument("addrs", nargs="*"); p.set_defaults(fn=cmd_new_group)
    p = sub.add_parser("group-add"); p.add_argument("conv"); p.add_argument("addr"); p.set_defaults(fn=cmd_group_add)
    p = sub.add_parser("group-remove"); p.add_argument("conv"); p.add_argument("addr"); p.set_defaults(fn=cmd_group_remove)
    p = sub.add_parser("group-rename"); p.add_argument("conv"); p.add_argument("name"); p.set_defaults(fn=cmd_group_rename)
    p = sub.add_parser("accept-invite"); p.add_argument("account"); p.add_argument("sender"); p.set_defaults(fn=cmd_accept_invite)
    p = sub.add_parser("decline-invite"); p.add_argument("account"); p.add_argument("sender"); p.set_defaults(fn=cmd_decline_invite)
    p = sub.add_parser("part"); p.add_argument("conv"); p.set_defaults(fn=cmd_part)
    p = sub.add_parser("send"); p.add_argument("conv"); p.add_argument("text"); p.set_defaults(fn=cmd_send)
    p = sub.add_parser("answer"); p.add_argument("conv"); p.set_defaults(fn=cmd_answer)
    p = sub.add_parser("keys"); p.add_argument("conv"); p.add_argument("text"); p.set_defaults(fn=cmd_keys)
    p = sub.add_parser("history"); p.add_argument("conv"); p.add_argument("--before")
    p.add_argument("--limit", type=int, default=50); p.set_defaults(fn=cmd_history)
    p = sub.add_parser("members"); p.add_argument("conv"); p.set_defaults(fn=cmd_members)
    p = sub.add_parser("mark-read"); p.add_argument("conv"); p.add_argument("msgid", nargs="?")
    p.set_defaults(fn=cmd_mark_read)
    p = sub.add_parser("events"); p.add_argument("--after", type=int); p.set_defaults(fn=cmd_events)
    p = sub.add_parser("ping"); p.set_defaults(fn=cmd_ping)
    p = sub.add_parser("serve"); p.set_defaults(fn=cmd_serve)
    p = sub.add_parser("irc-tail"); p.add_argument("account")
    p.add_argument("--raw", action="store_true", help="also print every IRC line")
    p.set_defaults(fn=cmd_irc_tail)
    return ap


_COMMANDS = frozenset(("accounts", "connect", "disconnect", "convs", "join", "part",
                       "send", "history", "members", "mark-read", "events", "ping",
                       "serve", "irc-tail"))


def _normalize_cli(argv):
    """Keep a bare diagnostic flag from consuming the sub-command as a path
    (the same rule as tvmail-backend)."""
    out = []
    for i, value in enumerate(argv):
        if value in ("--debug", "--trace"):
            nxt = argv[i + 1] if i + 1 < len(argv) else None
            if nxt is None or nxt.startswith("-") or nxt in _COMMANDS:
                out.append(value + ("=debug.tvchat.backend.log" if value == "--debug" else "=trace.tvchat.backend.log"))
                continue
        out.append(value)
    return out


def main():
    a = build_parser().parse_args(_normalize_cli(sys.argv[1:]))
    if a.debug:
        logging.basicConfig(filename=a.debug, level=logging.DEBUG,
                            format="%(asctime)s %(levelname)s %(message)s")
        _log.debug("tvchat-backend %s, python %s: %s", __version__,
                   sys.version.split()[0], " ".join(sys.argv[1:]))

    def run():
        try:
            sys.exit(a.fn(a))
        except UserError as e:
            sys.exit("tvchat-backend: %s" % e)
        except BrokenPipeError:
            sys.exit(0)
        except KeyboardInterrupt:
            sys.exit(130)

    if a.trace:
        import cProfile
        profiler = cProfile.Profile()
        try:
            profiler.enable()
            run()
        finally:
            profiler.disable()
            profiler.dump_stats(a.trace)
    else:
        run()


if __name__ == "__main__":
    main()
