        "mess": ("Mess Hall",
                 "Tables bolted to the floor, and a food machine that has not worked in years. "
                 "The corridor is back south.", {"south": "corridor"}),
    }
    DIRS = {"n": "north", "s": "south", "e": "east", "w": "west"}

    EIGHT_BALL = (
        "Floyd asked the ball. The ball said yes. Floyd didn't understand the question either.",
        "Floyd shook the ball so hard. It says no. Floyd is sorry.",
        "The ball says ask again later. Floyd will wait. Floyd is bad at it.",
        "Definitely! ...Floyd thinks. The ball is a little cracked.",
        "Floyd looked inside the ball. There is a tiny robot in there. He says maybe.",
        "Signs point to yes! Floyd doesn't know which signs. Floyd just likes pointing.",
    )
    FORTUNES = (
        "A robot who counts his screws will never be lonely. He will be busy.",
        "You will soon find a thing you lost. Floyd probably has it.",
        "Today is a good day to explore. So is every day. Floyd checked.",
        "A friend is someone who holds your bolt. You have a friend.",
        "Beware of the dark. Floyd isn't afraid. Floyd is cautious.",
    )
    KARMA = re.compile(r"^@?([\w\[\]\\`^{|}.-]+?)(\+\+|--)\s*$")
    # the !words that are just the errands under another name
    BANG_ERRANDS = {"time": "what time is it", "date": "what's the date", "coin": "flip a coin",
                    "flip": "flip a coin", "remind": "remind me in %s", "count": "count to %s"}

    def __init__(self, rng=None, nick="friend", clock=time.time, memory=None):
        self.rng = rng or random.Random()
        self.nick = nick
        self.clock = clock
        self.memory = memory or FloydMemory()
        # where fortune(6) is, looked for when asked (or a path, or None for none)
        self.fortune_prog = lambda: shutil.which("fortune")
        self.game = None                 # None, "hide" (you hide), "seek" (Floyd does)
        self.guesses = 0
        self.rules = [(re.compile(rx, re.I), rs) for rx, rs in self.RULES]
        self.room = "repair"
        self.inv = []                    # what you carry (item keys)
        self.floor = {"repair": ["oilcan", "flashlight"], "corridor": [], "mess": ["pellet"]}
        self.floyd_has = ["bolt", "book", "keycard"]
        self.offered = None              # held out to you, for /take

    # -- the parser ---------------------------------------------------------
    def _find(self, name, pool):
        name = name.strip().lower()
        name = re.sub(r"^(the|a|an|my|some)\s+", "", name)
        if not name:
            return None
        for key in pool:
            if name == key or name in self.ITEMS[key][0].lower():
                return key
        return None

    def _name(self, key):
        return self.ITEMS[key][0]

    def offer(self, delay=0.0):
        """Floyd holds something out to you (it stays his until you take it)."""
        if self.offered is not None:
            self.floyd_has.append(self.offered)
            self.offered = None
        if not self.floyd_has:
            return []
        key = self.floyd_has.pop(self.rng.randrange(len(self.floyd_has)))
        self.offered = key
        return self._say([(delay, "/me holds out %s. \"Floyd found this! Do you want it? "
                           "Floyd will give it to you. Say take it, or /take %s.\""
                           % (self._name(key), key))])

    def _describe(self):
        title, text, exits = self.ROOMS[self.room]
        here = [self._name(k) for k in self.floor[self.room]]
        lines = [(0.2, title, "n"), (0.25, text, "n")]
        if here:
            lines.append((0.3, "You can see %s here." % ", ".join(here), "n"))
        lines.append((0.4, "Floyd is here, %s." % self.rng.choice(
            ("humming", "poking at a wall", "looking at his own hands", "standing very close")), "n"))
        return lines

    def command(self, text, explicit=False):
        """Act on a parser-style line (look, take X, go north, what time is it,
        remind me in 5 minutes to ...).  A plan, or None when it is not one -
        the line is then chat.  `explicit` (a /command) always gets an answer;
        a plain line that names no object we know ("take care") stays chat."""
        self._explicit = explicit
        t = re.sub(r"^\s*floyd[,:]?\s+", "", text, flags=re.I).strip()
        t = re.sub(r"^(please|can you|could you|will you)\s+", "", t, flags=re.I)
        t = re.sub(r"\s+please$", "", t.rstrip(".!? "), flags=re.I)
        low = t.lower()
        verb, _, obj = low.partition(" ")
        obj = obj.strip()
        if low in ("look", "l", "look around"):
            return self._say(self._describe())
        if low in ("i", "inv", "inventory", "what am i carrying", "what do i have"):
            if not self.inv:
                return self._say([(0.2, "You are carrying nothing at all.", "n")])
            return self._say([(0.2, "You are carrying: %s." % ", ".join(self._name(k) for k in self.inv), "n")])
        if low in ("wait", "z", "rest"):
            return self._say([(0.2, "Time passes.", "n"), (1.2, "/me hums a tune that has no end.")])
        if verb in ("take", "get", "grab", "fetch", "bring") or low.startswith("pick up"):
            what = re.sub(r"^(pick up|take|get|grab|fetch|bring( me)?)\s*", "", low)
            what = re.sub(r"\s*(from floyd|for me|here)$", "", what)
            if what in ("it", "that", "this") and self.offered:
                what = self.offered
            return self._take(what, fetch=verb in ("fetch", "bring"))
        if verb == "drop" or low.startswith("put down"):
            what = re.sub(r"^(put down|drop)\s*", "", low)
            key = self._find(what, self.inv)
            if key is None:
                return self._say([(0.2, "You haven't got that.", "n")]) if explicit else None
            self.inv.remove(key)
            self.floor[self.room].append(key)
            return self._say([(0.2, "Dropped.", "n"), (1.0, "Floyd watches it hit the floor. \"Boing,\" says Floyd. It did not boing.")])
        if verb in ("examine", "x", "inspect") or low.startswith("look at"):
            what = re.sub(r"^(look at|examine|inspect|x)\s*", "", low)
            if what in ("floyd", "him", "robot"):
                return self._say([(0.2, "Floyd is a multi-purpose robot, B-19-7. He is dented, "
                                        "dusty, and looks very pleased about it.", "n")])
            pool = self.inv + self.floor[self.room] + ([self.offered] if self.offered else [])
            key = self._find(what, pool)
            if key is None:
                return self._say([(0.2, "You see nothing special about that.", "n")]) if explicit else None
            return self._say([(0.2, self.ITEMS[key][1], "n")])
        if verb == "give" or verb == "offer":
            m = re.match(r"(?:give|offer)\s+(?:floyd\s+)?(.+?)(?:\s+to\s+floyd)?$", low)
            key = self._find(m.group(1), self.inv) if m else None
            if key is None:
                return self._say([(0.2, "You haven't got that.", "n")]) if explicit else None
            self.inv.remove(key)
            self.floyd_has.append(key)
            return self._say([(0.2, "Given.", "n"),
                              (1.2, "Oh boy! A present! For Floyd? Floyd will keep it safe. Floyd might give it back later.")])
        direction = self.DIRS.get(low) or (low if low in ("north", "south", "east", "west") else None)
        if direction is None and verb in ("go", "walk", "run") and obj:
            direction = self.DIRS.get(obj) or obj
        if direction is not None:
            return self._go(direction)
        if low in ("xyzzy", "plugh"):
            return self._say([(1.0, "Floyd said it. Nothing happened. Floyd is disappointed in the cave game.")])
        if low in ("sing", "sing a song"):
            return self._say([(0.6, "/me sings, \"Bolts and screws and loose-fit nuts, la la la!\" The second line is the same as the first.")])
        if low in ("dance", "dance with me"):
            return self._say([(0.6, "/me dances. One of his arms keeps going after the rest has stopped.")])
        if verb == "open" and obj:
            return self._say([(0.2, "You can't open that.", "n"),
                              (1.2, "Floyd tried to open the %s once. Floyd got stuck. Floyd was stuck for a day." % obj)])
        return self._errand(t, low)

    def _take(self, what, fetch=False):
        if self.offered and (self._find(what, [self.offered]) or what == self.offered):
            key, self.offered = self.offered, None
            self.inv.append(key)
            return self._say([(0.2, "Taken.", "n"), (1.2, "Yay! Floyd is a good giver. Floyd likes giving. Floyd likes it when you say thanks.")])
        key = self._find(what, self.floor[self.room])
        if key:
            self.floor[self.room].remove(key)
            self.inv.append(key)
            return self._say([(0.2, "Taken.", "n")])
        if self._find(what, self.inv):
            return self._say([(0.2, "You already have that.", "n")])
        key = self._find(what, self.floyd_has)
        if key:
            self.floyd_has.remove(key)
            self.inv.append(key)
            return self._say([(0.4, "/me hands you %s. \"Floyd lends it to you. Floyd wants it back. Floyd probably won't ask.\"" % self._name(key)),
                              (0.9, "Taken.", "n")])
        if fetch:
            for room, items in self.floor.items():
                key = self._find(what, items)
                if key:
                    items.remove(key)
                    self.inv.append(key)
                    return self._say([(0.8, "Oh boy! A mission! Floyd will fetch %s. Floyd will be right back." % self._name(key)),
                                      (4.0, "/me comes back, out of breath, though Floyd doesn't breathe."),
                                      (4.4, "Floyd gives you %s." % self._name(key), "n")])
        if not self._explicit:
            return None
        return self._say([(0.2, "You can't see any such thing.", "n"),
                          (1.2, "Floyd looked. Floyd found a dust bunny. Floyd named him Gary.")])

    def _go(self, direction):
        title, text, exits = self.ROOMS[self.room]
        if direction not in exits:
            return self._say([(0.2, "You can't go that way.", "n"), (1.0, "/me bumps into the wall to check. It is a wall.")])
        self.room = exits[direction]
        return self._say([(0.3, "Floyd follows you, humming."), ] + [(d + 0.5, t, k) for d, t, k in self._describe()])

    def _errand(self, t, low):
        """Small useful things Floyd will do for you.  None when it is not one."""
        now = self.clock()
        if re.search(r"\bwhat'?s? (the )?time\b|\bwhat time is it\b|\bthe time\b", low):
            return self._say([(1.0, "Floyd looked at the big clock. It says %s. Floyd is pretty sure it is right."
                               % time.strftime("%H:%M", time.localtime(now)))])
        if re.search(r"\bwhat'?s? (the )?(date|day)\b|\bwhat day is it\b|\btoday'?s date\b", low):
            return self._say([(1.0, "It is %s. Floyd didn't know that. Floyd looked." %
                               time.strftime("%A, %B %d", time.localtime(now)).replace(" 0", " "))])
        if re.search(r"\b(a|my|the) fortune\b|^fortune$", low):
            return self._fortune()
        if re.search(r"\bflip a coin\b|\btoss a coin\b|\bcoin\b.*\b(flip|toss)\b", low):
            return self._say([(0.8, "/me flips a coin and misses the catch."),
                              (2.0, "It's %s! ...Floyd thinks. It rolled under the table." % self.rng.choice(("heads", "tails")))])
        m = re.match(r"(?:roll|throw)\s+(?:a |an |the )?(?:d|die|dice)?\s*(\d*)$", low)
        if m:
            n = min(max(int(m.group(1) or 6), 2), 1000)
            return self._say([(0.8, "/me rolls a d%d." % n),
                              (2.0, "It's a %d! Floyd thinks it is a good number. Floyd thinks all numbers are good." % self.rng.randint(1, n))])
        m = re.search(r"\bcount (?:up )?to (\d+)\b", low)
        if m:
            n = int(m.group(1))
            if n > 10:
                return self._say([(0.8, "Floyd can count to ten and then Floyd gets tired. Ask for ten.")])
            return self._say([(0.5 + i * 0.8, "%d..." % i) for i in range(1, n + 1)] +
                             [(0.5 + n * 0.8, "Floyd counted all of them. Floyd is good at counting.")])
        m = re.search(r"\bremind me (?:in|after)\s+(\d+)\s*(second|sec|minute|min|hour|hr)s?\b\s*(?:to|that|about)?\s*(.*)", low)
        if m:
            secs = int(m.group(1)) * {"s": 1, "m": 60, "h": 3600}[m.group(2)[0]]
            if secs > 86400:
                return self._say([(0.8, "That is too long to remember. Floyd would forget. Floyd forgets quickly.")])
            what = m.group(3).strip() or "something"
            return self._say([(0.8, "Okay! Floyd will remember. Floyd is very good at remembering."),
                              (float(secs), "Hey, %s! Floyd remembered! You said to remind you: %s" % (self.nick, what))])
        return None

    def _fmt(self, text):
        return text.replace("{nick}", self.nick)

    def _one(self, choices):
        return self._fmt(self.rng.choice(choices))

    @staticmethod
    def _split(text):
        """'/me ...' is an action ('a'); the rest is spoken ('')."""
        if text.startswith("/me "):
            return text[4:], "a"
        return text, ""

    def _say(self, plan):
        """[(delay, text[, kind])] -> [(delay, text, flags)].  kind 'n' is the
        narrator (room and item text, as in interactive fiction)."""
        out = []
        for entry in plan:
            text, kind = self._split(self._fmt(entry[1]))
            out.append((entry[0], text, entry[2] if len(entry) > 2 else kind))
        return out

    def opening(self):
        return self._say([(1.0, self.OPENING)]) + self.offer(4.0)

    # -- the old-school bot in him ------------------------------------------
    def observe(self, who, text, where):
        """Every line anyone says where Floyd listens: note who was seen, and
        hand over what was left for them (!tell)."""
        now = self.clock()
        mem = self.memory
        if text.strip():
            mem.seen_set(who.lower(), now, where, text[:200])
        plan = []
        for i, t in enumerate(mem.take_tells(who.lower())):
            plan.append((0.8 + 0.7 * i, "%s: Floyd has a message for you from %s (%s ago): %s"
                         % (who, t["from"], _dur(now - t["ts"]), t["text"])))
        return self._say(plan)

    def botcmd(self, text, who):
        """!seen !tell !quote !addquote !karma !8ball !learn !forget !help, a
        learned fact (!word), the errands under a ! (!time, !roll 20), and
        nick++ / nick--.  A plan, or None when the line is none of those."""
        t = text.strip()
        mem = self.memory
        m = self.KARMA.match(t)
        if m:
            thing = m.group(1).lower()
            if thing == who.lower():
                return self._say([(0.8, "Floyd won't let you vote for yourself. That's cheating. Floyd knows cheating. Floyd tried it once.")])
            n = mem.karma_add(thing, 1 if m.group(2) == "++" else -1)
            return self._say([(0.8, "Floyd %s %s a point. %s has %d point%s now." % (
                "gave" if m.group(2) == "++" else "took", m.group(1), m.group(1), n, "" if abs(n) == 1 else "s"))])
        if not t.startswith("!"):
            return None
        cmd, _, arg = t[1:].partition(" ")
        cmd, arg = cmd.lower(), arg.strip()
        if cmd == "seen":
            who2 = arg.split(" ")[0].lower().lstrip("@") if arg else ""
            if not who2:
                return self._say([(0.8, "Seen who? Say !seen NICK.")])
            if who2 == who.lower():
                return self._say([(0.8, "Floyd can see you right now! Hi!")])
            if who2 == "floyd":
                return self._say([(0.8, "Floyd is right here. Floyd is always right here. Floyd has nowhere else to be.")])
            seen = mem.data["seen"].get(who2)
            if not seen:
                return self._say([(0.8, "Floyd hasn't seen %s. Floyd looked in the drawers." % arg.split(" ")[0])])
            return self._say([(0.8, "Floyd last saw %s %s ago, in %s, saying: \"%s\""
                               % (arg.split(" ")[0], _dur(self.clock() - seen[0]), seen[1], seen[2]))])
        if cmd == "tell":
            to, _, msg = arg.partition(" ")
            to, msg = to.lstrip("@"), msg.strip()
            if not to or not msg:
                return self._say([(0.8, "Tell who what? Say !tell NICK MESSAGE.")])
            if len(msg) > 300:
                return self._say([(0.8, "That is a lot of message. Floyd can only hold 300 letters. Floyd's pockets are small.")])
            if to.lower() == "floyd":
                return self._say([(0.8, "Floyd is right here! Floyd heard you! You can just say it.")])
            mem.add_tell(to.lower(), who, msg, self.clock())
            return self._say([(0.8, "Okay! Floyd will tell %s next time Floyd sees them. Floyd is good at remembering. Mostly." % to)])
        if cmd == "addquote":
            if not arg:
                return self._say([(0.8, "Add what? Say !addquote TEXT.")])
            mem.data["quotes"].append(arg[:300])
            mem.save()
            return self._say([(0.8, "Floyd wrote it down! That is quote #%d." % len(mem.data["quotes"]))])
        if cmd == "quote":
            q = mem.data["quotes"]
            if not q:
                return self._say([(0.8, "Floyd has no quotes. Floyd is a quote-free robot. Add one with !addquote TEXT.")])
            n = int(arg) if arg.isdigit() and 1 <= int(arg) <= len(q) else self.rng.randint(1, len(q))
            return self._say([(0.8, "#%d: %s" % (n, q[n - 1]))])
        if cmd == "karma":
            k = mem.data["karma"]
            if arg:
                return self._say([(0.8, "%s has %d point%s. Floyd checked." % (arg.split(" ")[0], k.get(arg.split(" ")[0].lower(), 0),
                                                                              "" if k.get(arg.split(" ")[0].lower(), 0) == 1 else "s"))])
            if not k:
                return self._say([(0.8, "Nobody has any points. Floyd would give you one, but Floyd isn't allowed. Say someone++.")])
            top = sorted(k.items(), key=lambda kv: -kv[1])[:3]
            return self._say([(0.8, "Floyd's best friends: " + ", ".join("%s (%d)" % kv for kv in top) + ".")])
        if cmd in ("8ball", "eightball"):
            return self._say([(1.0, self.rng.choice(self.EIGHT_BALL))])
        if cmd == "fortune":
            return self._fortune()
        if cmd == "learn":
            m = re.match(r"(.+?)\s+(?:is|=)\s+(.+)$", arg)
            if not m or len(m.group(2)) > 300:
                return self._say([(0.8, "Learn what? Say !learn THING is WHAT (not too long).")])
            mem.data["facts"][m.group(1).strip().lower()] = m.group(2).strip()
            mem.save()
            return self._say([(0.8, "Oh boy! Floyd learned something. %s is %s. Floyd will remember that. Probably." % (m.group(1).strip(), m.group(2).strip()))])
        if cmd == "forget":
            if mem.data["facts"].pop(arg.lower(), None) is None:
                return self._say([(0.8, "Floyd doesn't know %s. Floyd can't forget it. Floyd is relieved." % arg)])
            mem.save()
            return self._say([(0.8, "Floyd forgot %s. Floyd forgets quickly. It was easy." % arg)])
        if cmd == "help":
            return self._say([
                (0.8, "Floyd knows: !seen NICK, !tell NICK MESSAGE, !quote [N], !addquote TEXT, !karma [THING], someone++ / someone--, !8ball QUESTION, !fortune."),
                (1.8, "Also !learn THING is WHAT, !forget THING, !THING, !time, !date, !coin, !roll [N], !count N, !remind 5 minutes to X. Say 'floyd: play' for Hider and Seeker."),
                (2.8, "Useful: !calc 12*7, !convert 5 km to mi, !time in Tokyo, !todo [add X|done N], !note X / !notes, !catchup, !level [off|minimal|helpful|chatty|clippy].")])
        if cmd == "roll":
            return self._errand("roll d%s" % (arg or "6"), "roll d%s" % (arg or "6"))
        if cmd in self.BANG_ERRANDS:
            line = self.BANG_ERRANDS[cmd]
            line = line % arg if "%s" in line else line
            return self._errand(line, line.lower())
        key = t[1:].strip().lower()              # a fact may be several words
        fact = mem.data["facts"].get(key)
        if fact is not None:
            return self._say([(0.8, "%s is %s." % (key, fact))])
        return None

    def _fortune(self):
        """fortune(6), when it is installed (a short one, at most 300 letters, on one
        line); Floyd's own few otherwise."""
        prog = self.fortune_prog() if callable(self.fortune_prog) else self.fortune_prog
        text = ""
        if prog:
            try:
                out = subprocess.run([prog, "-s"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                     timeout=2, universal_newlines=True).stdout
                text = " ".join(out.split())[:300]
            except (OSError, subprocess.SubprocessError, ValueError):
                text = ""
        if text:
            return self._say([(1.0, "Floyd opened the fortune machine. It says: " + text)])
        return self._say([(1.0, self.rng.choice(self.FORTUNES))])

    def start_game(self):
        if self.game:
            return self.reply("")
        self.guesses = 0
        if self.rng.random() < 0.5:
            self.game = "hide"
            return self._say([
                (1.0, "Okay! You hide. Floyd will count. Floyd is a very good counter. Tell Floyd where you hid when Floyd is done."),
                (3.0, "One... two... three..."),
                (5.0, "...nine... ten! Ready or not, here Floyd comes!"),
                (7.5, "/me looks under a table, inside a cupboard, and then at his own feet."),
                (10.0, "Floyd can't find you! Floyd looked everywhere! Where are you hiding?")])
        self.game = "seek"
        return self._say([
            (1.0, "Okay! Floyd will hide. You count to ten. No peeking!"),
            (3.5, "Floyd is hiding. Floyd found a very good spot. Nobody could ever find Floyd here."),
            (5.5, "/me holds very still. His antenna is sticking out."),
            (7.5, "Okay! Come find Floyd! Where do you think he is?")])

    def reply(self, text, action=False, who=None):
        if who:
            self.nick = who
        low = text.lower()
        if self.game == "hide":
            self.game = None
            if re.search(r"\b(quit|stop|no|never ?mind|give up)\b", low):
                return self._say([(1.0, self._one(self.GAVE_UP))])
            where = text.strip().rstrip(".!?")[:60] or "somewhere"
            return self._say([
                (1.0, "Floyd found you! You were hiding %s? Floyd knew it the whole time!" % where),
                (2.5, "Floyd is the best seeker ever. Floyd is almost as good as Floyd is at hiding.")])
        if self.game == "seek":
            self.guesses += 1
            if re.search(r"\b(quit|stop|give up|never ?mind)\b", low):
                self.game = None
                return self._say([(1.0, "Floyd was behind the big thing the whole time! ...Oh. You gave up. Okay.")])
            if self.guesses < 3:
                return self._say([
                    (1.0, self._one((
                        "Not there! Floyd is very good at hiding. Floyd is not even close to there.",
                        "Nope! Try again. Floyd is quiet as a mouse. A very big mouse."))),
                    (2.5, "/me's foot sticks out from behind the thing.")])
            self.game = None
            return self._say([
                (1.0, "Hey! How did you find Floyd?! Floyd was hiding so good!"),
                (2.5, "You win, {nick}! Floyd was right out in the open. Floyd always hides there. Floyd likes it.")])
        if not action:
            plan = self.botcmd(text, self.nick)
            if plan is None:
                fact = self.memory.data["facts"].get(low.rstrip("? ").strip()) if low.endswith("?") else None
                if fact is not None:
                    plan = self._say([(0.8, "%s is %s." % (low.rstrip("? ").strip(), fact))])
            if plan is None:
                plan = self.command(text)
            if plan is not None:
                return plan
        if re.search(r"\b(play|game|hide|seek|hider)\b", low) and not action:
            return self.start_game()
        for rx, choices in self.rules:
            if rx.search(low):
                return self._say([(1.2, self._one(choices))])
        return self._say([(1.2, self._one(self.DEFAULT))])

    def idle(self, nudge):
        """What Floyd does when left alone: nudge counts the times running."""
        if nudge >= 3:
            return self._say([(0.0, self.SLEEP)])
        if nudge == 0 or self.rng.random() < 0.4:
            offered = self.offer()
            if offered:
                return offered
        return self._say([(0.0, self._one(self.CHATTER))])


class FloydAdapter(CommandMixin):
    """The account for Floyd.  [account:NAME] protocol = floyd; nothing else is
    needed.  Options:  nick= (what Floyd calls you; default your login name),
    idle= (seconds of quiet before Floyd talks by himself, 0 = never; default
    180), seed= (a number, for a repeatable Floyd)."""

    TARGET = "floyd"
    IDLE_DEFAULT = 180
    SERVER_TEXT_REFUSAL = ("the server window takes no messages - talk to Floyd in his own "
                           "conversation (/help lists the commands)")

    def __init__(self, chat, account):
        self.chat, self.account, self.loop = chat, account, chat.loop
        o = account.opts
        self.nick = (o.get("nick") or "").strip() or _me()
        self.idle = self.idle_seconds(o.get("idle"))
        seed = (o.get("seed") or "").strip()
        self.seed = int(seed) if seed.isdigit() else None
        where = (o.get("memory") or "").strip()
        if where.lower() == "none":
            path = None
        else:
            path = os.path.expanduser(where) if where else os.path.join(
                os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                "tvchat", "floyd", account.id + ".json")
        self.memory = FloydMemory(path)
        self.patterns = [p.strip() for p in (o.get("attach") or "").split(",") if p.strip()]
        self.tag = o["tag"] if "tag" in o else "[Floyd] "
        # Floyd runs on the server (`floyd-daemon`), not in a tvchat session
        self.local = _bool(o.get("local"), False)
        # services accounts (IRCv3 account-tag) that may send him orders
        self.admins = set(x.strip().lower() for x in (o.get("admins") or "").split(",")
                          if x.strip())
        self.claude = _bool(o.get("claude"), False)
        self.claude_cmd = (o.get("claude_cmd") or "").strip() or "claude"
        self.claude_tools = (o.get("claude_tools") or "").strip() or "Read,Grep,Glob"
        self.claude_dir = os.path.expanduser((o.get("claude_dir") or "").strip()) or None
        self.claude_model = (o.get("claude_model") or "").strip()
        self.claude_extra = shlex.split(o.get("claude_args") or "")
        self.claude_timeout = self._number(o.get("claude_timeout"), 180)
        self.claude_lines = int(self._number(o.get("claude_lines"), 10))
        self.claude_busy = False
        # how much he does: off, minimal, helpful, chatty, clippy (tvfloyd.py); !level
        # changes it per conversation
        self.level = tvf.parse_level(o.get("level"), tvf.DEFAULT_LEVEL)
        self.clip_gap = self._number(o.get("clippy_gap"), 300)    # seconds between tips in one place
        self.clip_last, self.clip_mute = {}, {}
        self.notes = {}                  # person -> their to-dos and notes
        self.minds = {}                  # conv id -> his wits there (attached elsewhere)
        self.last_out = {}               # conv id -> when he last spoke there
        self.heard_ids = deque(maxlen=200)
        self.mind = self._new_mind(self.nick)
        self.phase = "down"
        self.gen = 0
        self._ids = 0
        self.nudges = 0
        self.idle_timer = None
        self.spoken = 0                  # things Floyd has said this session

    def _new_mind(self, nick):
        return FloydMind(random.Random(self.seed) if self.seed is not None else random.Random(),
                         nick, clock=self.chat.loop.clock, memory=self.memory)

    # -- attached to another account's conversation ------------------------
    ATTACH_GAP = 2.0                     # seconds between his answers in one place
    ATTACH_MAX_LINES = 5
    MAX_AGE = 60                         # ignore lines older than this (replays)

    def attached(self, conv):
        return (conv.id in self.memory.data["attached"] or
                any(fnmatch.fnmatchcase(conv.id, p) for p in self.patterns))

    def attach(self, conv, on):
        """/floyd on|off in another account's conversation.  The note to show."""
        if conv.kind == "server":
            raise UserError("Floyd can't listen in a server window - use a channel or a chat")
        att = self.memory.data["attached"]
        if on:
            if self.phase != "up":
                self.chat.connect(self.account)      # he needs no network: just switch him on
            if conv.id not in att:
                att.append(conv.id)
                self.memory.save()
            return ("Floyd is listening here. He answers !commands and 'floyd: ...' as you "
                    "(each line starts with %s). /floyd off sends him away." % (self.tag.strip() or "his name"))
        if conv.id in att:
            att.remove(conv.id)
            self.memory.save()
        if self.attached(conv):
            return "Floyd is off here, but tvchat.conf attach= still lists this conversation"
        return "Floyd has gone back to his own conversation."

    def hear(self, conv, msg):
        """Called for every message added to any conversation: if Floyd is
        attached here, note it (!seen, !tell) and answer what is for him."""
        if self.phase != "up" or conv.account is self.account or conv.kind == "server":
            return
        if "n" in msg.flags or not self.attached(conv):
            return
        if self.chat.daemon and "s" in msg.flags:
            return                       # the bot never answers himself
        if msg.id in self.heard_ids or self.chat.loop.clock() - msg.when > self.MAX_AGE:
            return
        self.heard_ids.append(msg.id)
        text = msg.text.strip()
        tag = self.tag.strip()
        if not text or (tag and text.startswith(tag)):
            return                       # blank, or Floyd's own line (or another Floyd's)
        who = msg.sender.display or msg.sender.address or "someone"
        mind = self.minds.get(conv.id)
        if mind is None:
            mind = self.minds[conv.id] = self._new_mind(who)
        mind.nick = who
        now = self.chat.loop.clock()
        lvl = self.level_of(conv)
        m = re.match(r"^@?floyd\s*[:,]\s*(.*)$", text, re.I)
        # on the server, a private message is always meant for him
        to_him = bool(m) or (self.chat.daemon and conv.kind == "direct")
        body = m.group(1) if m else text
        bang = body.startswith("!")
        direct = (to_him or bang) and "a" not in msg.flags       # said to him, not about him
        low = body.strip().lower()
        plan, order = [], False
        lm = self.LEVEL_RX.match(body) if direct else None
        if lm:                           # heard at every level, off included
            plan = self._level_cmd(conv, mind, msg, who, lm.group(1))
        elif lvl == "off":
            return
        else:
            if tvf.at_least(lvl, "helpful"):
                plan = mind.observe(who, text, conv.title)       # also hands over his !tells
            elif text.strip():
                self.memory.seen_set(who.lower(), now, conv.title, text[:200])
            c = self.CLAUDE_RX.match(body) if direct else None
            order = bool(c)
            if order:
                plan += self._order(conv, msg.sender, who, c.group(1))
            elif direct and low in ("!whoami", "whoami"):
                plan += mind._say([(0.8, self._whoami(msg.sender, who))])
            elif direct and lvl == "clippy" and self.SHOO_RX.match(low):
                self.clip_mute[conv.id] = now + 3600
                plan += mind._say([(0.8, "Okay. Floyd will keep his tips to himself for an hour. Floyd has a lot of tips.")])
            else:
                got = self._tool(conv, mind, msg, who, body, bang, lvl) if direct else None
                if got is not None:
                    plan += got
                elif "a" in msg.flags:
                    pass                 # an action is not addressed to him
                elif bang:
                    plan += mind.botcmd(body, who) or []
                elif to_him:
                    plan += self._talk(mind, body, who, lvl)
                elif tvf.at_least(lvl, "helpful") and mind.KARMA.match(text):
                    plan += mind.botcmd(text, who) or []
            if not plan and lvl == "clippy" and not direct and "a" not in msg.flags:
                tip = self._clippy(conv, text, now)
                if tip:
                    plan = mind._say([(1.5, tip)])
        if not plan:
            return
        if now - self.last_out.get(conv.id, -1e9) < self.ATTACH_GAP and not (
                order and self.is_admin(msg.sender)):
            return                       # a flood of triggers: let this one go
        self.last_out[conv.id] = now
        plan = plan[:self.ATTACH_MAX_LINES]
        self._out(conv, plan)

    # -- levels, the useful tools, and tips -----------------------------------
    LEVEL_RX = re.compile(r"^!?\s*level(?:\s+(\S+))?\s*$", re.I)
    SHOO_RX = re.compile(r"^(?:shoo|no tips|stop (?:the )?tips|be quiet|not now)\W*$")
    CATCHUP_RX = re.compile(r"\b(?:catch me up|what did i miss|what have i missed|catch ?up)\b", re.I)
    TOOL_VERBS = frozenset(("calc", "calculate", "compute", "math", "convert", "conv", "units",
                            "tz", "time", "clock", "todo", "note", "notes"))

    def level_of(self, conv):
        return tvf.parse_level(self.memory.data["levels"].get(conv.id), None) or self.level

    def _level_cmd(self, conv, mind, msg, who, arg):
        """!level [NAME|default]: say, or (admins; in a session of your own, you) set."""
        cur = self.level_of(conv)
        if not arg:
            return mind._say([
                (0.8, "Floyd is at level %s here. %s" % (cur, tvf.LEVEL_BLURB[cur])),
                (1.6, "The levels are %s. Say !level NAME to change it." % ", ".join(tvf.LEVELS))])
        reset = arg.lower() == "default"
        new = self.level if reset else tvf.parse_level(arg, None)
        if new is None:
            return mind._say([(0.8, "Floyd has no level called %s. He has %s." % (arg, ", ".join(tvf.LEVELS)))])
        if not (self.is_admin(msg.sender) or (not self.chat.daemon and "s" in msg.flags)):
            return mind._say([(0.8, "Only Floyd's admins can change his level, %s. It is %s here." % (who, cur))])
        lv = self.memory.data["levels"]
        if reset:
            lv.pop(conv.id, None)
        else:
            lv[conv.id] = new
        self.memory.save()
        _log.info("floyd: level of %s is now %s (by %s)", conv.id, new, who)
        wake = "" if new != "off" else " Say !level NAME to wake him."
        return mind._say([(0.8, "Floyd is now at level %s. %s%s" % (new, tvf.LEVEL_BLURB[new], wake))])

    def _talk(self, mind, body, who, lvl):
        """Something said to him that is not a !command or a tool."""
        if tvf.at_least(lvl, "chatty"):
            return mind.reply(body, who=who)
        plan = mind.command(body)         # the errands, the parser
        return plan or mind._say([(0.8, "Floyd only does commands at level %s. Try !help." % lvl)])

    def _notes_for(self, sender, who):
        key = re.sub(r"[^a-z0-9_.-]", "_",
                     (getattr(sender, "account", None) or who or "x").lower())[:40]
        n = self.notes.get(key)
        if n is None:
            base = self.memory.path
            if len(self.notes) > 100:
                self.notes.clear()
            n = self.notes[key] = tvf.Notes(
                os.path.join(os.path.dirname(base), "notes-%s.json" % key) if base else None)
        return n

    def _tool(self, conv, mind, msg, who, body, bang, lvl):
        """!calc, !convert, !time in X, !todo, !note, !catchup - and, from helpful up,
        the same in plain words.  A plan, or None when it is none of those."""
        t = (body[1:] if bang else body).strip()
        verb, _, rest = t.partition(" ")
        verb = verb.lower()
        now = self.chat.loop.clock()
        text = None
        try:
            if verb == "catchup" or (not bang and self.CATCHUP_RX.search(t)
                                     and tvf.at_least(lvl, "helpful")):
                lines = self._catchup(conv, msg, who, now)
                return mind._say([(0.8 + 0.8 * i, ln) for i, ln in enumerate(lines)])
            if verb in self.TOOL_VERBS and (bang or tvf.at_least(lvl, "helpful")) \
                    and not (verb in ("time", "clock") and not rest.strip()):
                text = tvf.run_tool(verb, rest, self._notes_for(msg.sender, who), now)
            if text is None and not bang and tvf.at_least(lvl, "helpful"):
                text = tvf.natural(t, self._notes_for(msg.sender, who), now)
        except tvf.CalcError as e:
            text = "Floyd can't. %s" % e
        if text is None:
            return None
        return mind._say([(0.8 + 0.6 * i, ln) for i, ln in enumerate(text.split("\n")[:5])])

    def _catchup(self, conv, msg, who, now):
        """What was said since the asker last spoke here: who, mentions, questions."""
        daemon = self.chat.daemon

        def mine(m):
            return ((m.sender.display or m.sender.address or "").lower() == who.lower()
                    or (not daemon and "s" in m.flags))
        hist = list(conv.history)
        cut = 0
        for i in range(len(hist) - 1, -1, -1):
            if hist[i] is not msg and mine(hist[i]):
                cut = i + 1
                break
        seg = [m for m in hist[cut:] if m is not msg and "n" not in m.flags
               and not (daemon and "s" in m.flags) and m.sender.address][-300:]
        if not seg:
            return ["Nothing happened while you were away. Floyd watched. Floyd saw nothing."]
        counts = {}
        for m in seg:
            n = m.sender.display or m.sender.address
            counts[n] = counts.get(n, 0) + 1
        top = sorted(counts.items(), key=lambda kv: -kv[1])[:3]
        lines = ["Since you last spoke (%s ago): %d message%s from %s."
                 % (_dur(now - seg[0].when), len(seg), "" if len(seg) == 1 else "s",
                    ", ".join("%s (%d)" % kv for kv in top))]
        word = re.compile(r"\b%s\b" % re.escape(who), re.I)
        hits = ["<%s> %s" % (m.sender.display or m.sender.address, m.text[:90])
                for m in seg if word.search(m.text)][-3:]
        if hits:
            lines.append("Mentioning you: " + " | ".join(hits))
        qs = ["<%s> %s" % (m.sender.display or m.sender.address, m.text[:90])
              for m in seg if m.text.rstrip().endswith("?")][-2:]
        if qs:
            lines.append("Questions: " + " | ".join(qs))
        links = sum(len(re.findall(r"https?://", m.text)) for m in seg)
        if links:
            lines.append("%d link%s went by." % (links, "" if links == 1 else "s"))
        return lines

    def _clippy(self, conv, text, now):
        """An unprompted tip - 'Floyd not clippy but ...' - at most one per clippy_gap
        seconds in a place, and none for an hour after 'shoo'."""
        if now < self.clip_mute.get(conv.id, 0) or now - self.clip_last.get(conv.id, -1e9) < self.clip_gap:
            return None
        tip = tvf.clippy_chat(text)
        if tip:
            self.clip_last[conv.id] = now
        return tip

    def _out(self, conv, plan):
        for delay, text, flags in plan:
            self._later(delay, lambda t=text, f=flags: self._send_out(conv, t, f))

    # -- orders only an admin may give ---------------------------------------
    CLAUDE_RX = re.compile(r"^(?:!\s*claude|(?:ask\s+)?claude\s*[:,]?)\s+(\S.*)$", re.I | re.S)
    CLAUDE_CHARS = 1500                  # the most of his answer that is passed on

    def is_admin(self, sender):
        """Only the network's word counts: the services account on the message
        (IRCv3 account-tag), never a nick or a name in the text."""
        acct = (getattr(sender, "account", None) or "").lower()
        return bool(acct) and acct in self.admins

    def _whoami(self, sender, who):
        acct = getattr(sender, "account", None)
        if not acct:
            return "Floyd sees %s, but %s is not logged in to services. Floyd can't tell who that is." % (who, who)
        return "Floyd knows %s as account %s%s." % (
            who, acct, ", an admin" if self.is_admin(sender) else ", not an admin")

    def _order(self, conv, sender, who, prompt):
        """Consult the Claude CLI for an admin; the plan to say meanwhile."""
        if not self.is_admin(sender):
            _log.info("floyd: refused claude for %s (account %s) in %s", who,
                      getattr(sender, "account", None), conv.id)
            return self.mind._say([(0.8, "Floyd can't do that for you, %s. Only Floyd's admins can wake Claude. "
                                    "Floyd asked nicely. Floyd was told no." % who)])
        if not (self.claude and self.chat.daemon):
            return self.mind._say([(0.8, "Claude is asleep. (Floyd's account needs claude = yes, and "
                                    "Floyd has to be on the server.)")])
        if self.claude_busy:
            return self.mind._say([(0.8, "Floyd is still waiting for Claude. Claude is slow. Floyd is patient.")])
        self.claude_busy = True
        _log.info("floyd: claude for %s in %s: %s", who, conv.id, prompt[:200])
        argv = self._claude_argv()
        gen = self.gen
        self.loop.run_in_thread(
            lambda: self._run_claude(argv, prompt),
            lambda res, err: self._consulted(gen, conv, who, res, err))
        return self.mind._say([(0.8, "Floyd will ask Claude. Floyd has to climb a ladder. Floyd will be back.")])

    def _claude_argv(self):
        """The CLI, read-only by default: only the named tools exist (--tools),
        anything else is refused rather than asked about (dontAsk)."""
        argv = [self.claude_cmd, "-p", "--output-format", "text",
                "--tools", self.claude_tools, "--allowedTools", self.claude_tools,
                "--permission-mode", "dontAsk"]
        if self.claude_model:
            argv += ["--model", self.claude_model]
        return argv + self.claude_extra

    def _run_claude(self, argv, prompt):
        """On a thread: the prompt goes in on stdin, never on the command line."""
        r = subprocess.run(argv, input=prompt.encode("utf-8"), stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE, cwd=self.claude_dir,
                           timeout=self.claude_timeout)
        out = r.stdout.decode("utf-8", "replace").strip()
        if r.returncode and not out:
            tail = r.stderr.decode("utf-8", "replace").strip().splitlines()
            raise RuntimeError(tail[-1] if tail else "exit status %d" % r.returncode)
        return out

    def _consulted(self, gen, conv, who, res, err):
        self.claude_busy = False
        if gen != self.gen:
            return                       # Floyd was switched off meanwhile
        if err is not None:
            what = ("Claude took too long" if isinstance(err, subprocess.TimeoutExpired)
                    else "Claude could not be reached (%s)" % (str(err)[:120] or type(err).__name__))
            _log.info("floyd: claude failed: %r", err)
            lines = [what]
        else:
            text = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", res or "")
            lines = [ln.rstrip() for ln in text.splitlines() if ln.strip()] or ["(Claude said nothing)"]
            if sum(len(ln) for ln in lines) > self.CLAUDE_CHARS:
                kept, n = [], 0
                for ln in lines:
                    if n + len(ln) > self.CLAUDE_CHARS:
                        break
                    kept.append(ln)
                    n += len(ln)
                lines = kept or [lines[0][:self.CLAUDE_CHARS]]
                lines.append("... (cut short)")
            if len(lines) > self.claude_lines:
                lines = lines[:self.claude_lines] + ["... (%d more lines)" % (len(lines) - self.claude_lines)]
        pre = "Claude: " if conv.kind == "direct" else "%s: Claude: " % who
        self._out(conv, [(0.6 * i, (pre if i == 0 else "  ") + ln, "")
                         for i, ln in enumerate(lines)])

    def _send_out(self, conv, text, flags):
        """Say it in the other account's conversation, as the user, behind the tag."""
        if flags == "a":
            line = "/me " + text
        elif self.tag:
            line = self.tag + text
        else:
            line = "/" + text if text.startswith("/") else text    # "//x" is a literal "/x"
        try:
            self.chat.adapter(conv.account).send(conv, line)
        except UserError as e:
            _log.debug("floyd: cannot speak in %s: %s", conv.id, e)

    @staticmethod
    def _number(text, default):
        try:
            v = float((text or "").strip())
        except ValueError:
            return default
        return v if v > 0 else default

    @classmethod
    def idle_seconds(cls, text):
        text = (text or "").strip()
        if not text:
            return float(cls.IDLE_DEFAULT)
        try:
            v = float(text)
        except ValueError:
            raise UserError("idle= must be a number of seconds (0 = never), not %r" % text)
        if v < 0:
            raise UserError("idle= may not be negative")
        return v

    def local_id(self):
        self._ids += 1
        return "%s:%d" % (self.account.id, self._ids)

    def need_up(self):
        if self.phase != "up":
            raise UserError("Floyd is switched off - connect %s first" % self.account.id)

    def server_conv(self):
        return self.chat.ensure_conv(self.account, "*", "server", self.account.display)

    def floyd_conv(self):
        conv = self.chat.ensure_conv(self.account, self.TARGET, "direct", "Floyd")
        conv.members.setdefault(self.TARGET, (self.TARGET, "Floyd", "member"))
        return conv

    def system(self, conv, text):
        self.chat.add_message(conv, Message(self.local_id(), conv.id, time.time(),
                                            Contact(""), text, "n"), count=False)

    def _later(self, delay, fn):
        gen = self.gen
        return self.loop.call_later(delay, lambda: gen == self.gen and fn())

    # -- lifecycle ----------------------------------------------------------
    def connect(self):
        if self.phase == "up":
            return
        if not (self.chat.daemon or self.local):
            raise UserError("Floyd now lives on the server (the IRC nick Floyd), not here - "
                            "or set local = yes in [account:%s] to run him in this session"
                            % self.account.id)
        self.phase = "up"
        self.server_conv()
        conv = self.floyd_conv()
        self.chat.set_state(self.account, "connected", "B-19-7 reporting for duty")
        self.system(self.server_conv(), "Floyd (B-19-7, multi-purpose robot) is online. "
                    "Say hello in the Floyd conversation.")
        if not conv.history:
            self._play(conv, self.mind.opening())
        self._arm()

    def disconnect(self):
        was = self.phase
        self.gen += 1
        self.loop.cancel(self.idle_timer)
        self.idle_timer = None
        self.phase = "down"
        if was != "down":
            self.chat.set_state(self.account, "disconnected", "")

    def c_quit(self, conv, rest):
        return (self.disconnect, ())

    def join(self, target):
        self.need_up()
        if target.strip().lower() not in (self.TARGET, ""):
            raise UserError("Floyd only knows Floyd - there is nobody else here")
        return self.floyd_conv()

    def part(self, conv):
        if conv.kind == "server":
            raise UserError("the server window cannot be left - /quit disconnects")
        raise UserError("Floyd can't be left. Floyd would be sad. (/quit disconnects)")

    # -- talking ------------------------------------------------------------
    def _from_floyd(self, conv, text, flags):
        """flags: '' Floyd speaks, 'a' he does something, 'n' the narrator."""
        if flags != "n":
            self.spoken += 1
        who = Contact("") if flags == "n" else Contact(self.TARGET, "Floyd")
        self.chat.add_message(conv, Message(self.local_id(), conv.id, time.time(),
                                            who, text, flags), count=flags != "n")

    def _play(self, conv, plan):
        """Say each (delay, text, flags) of the plan after its delay."""
        for delay, text, flags in plan:
            self._later(delay, lambda t=text, f=flags: self._from_floyd(conv, t, f))

    def _parser(self, verb):
        """A /command that is a parser verb: /take bolt is 'take bolt'."""
        def run(conv, rest):
            self._in_a_chat(conv, "/" + verb)
            if verb in ("take", "drop") and not rest:
                raise UserError("usage: /%s THING" % verb)
            return (self._parse, (conv, (verb + " " + rest).strip()))
        return run

    def _parse(self, conv, text):
        mid = self._heard(conv, text)
        self._play(conv, self.mind.command(text, explicit=True) or [])
        return mid

    def _heard(self, conv, text, action=False):
        """Something was said to Floyd: log it, and let him answer."""
        self.nudges = 0
        msg = Message(self.local_id(), conv.id, time.time(), Contact(self.nick), text,
                      "sa" if action else "s")
        self.chat.add_message(conv, msg, count=False)
        self._arm()
        return msg.id

    def speak(self, conv, text):
        mid = self._heard(conv, text)
        self._play(conv, self.mind.observe(self.nick, text, "Floyd") + self.mind.reply(text))
        return mid

    def c_me(self, conv, rest):
        _need(rest, "/me ACTION")
        self._in_a_chat(conv, "/me")
        return (self._act, (conv, rest))

    def _act(self, conv, text):
        mid = self._heard(conv, text, action=True)
        self._play(conv, self.mind.reply(text, action=True))
        return mid

    def c_look(self, conv, rest):
        return self._parser("look" if not rest else "examine")(conv, rest)

    def c_inventory(self, conv, rest):
        return self._parser("inventory")(conv, "")

    def c_take(self, conv, rest):
        return self._parser("take")(conv, rest)

    def c_drop(self, conv, rest):
        return self._parser("drop")(conv, rest)

    def c_play(self, conv, rest):
        self._in_a_chat(conv, "/play")
        return (self._start_game, (conv,))

    def _start_game(self, conv):
        self.nudges = 0
        self._arm()
        self._play(conv, self.mind.start_game())

    # -- Floyd on his own ---------------------------------------------------
    def _arm(self):
        self.loop.cancel(self.idle_timer)
        self.idle_timer = None
        if self.idle > 0 and self.phase == "up" and tvf.at_least(self.level, "chatty"):
            self.idle_timer = self._later(self.idle, self._wander)

    def _wander(self):
        conv = self.floyd_conv()
        plan = self.mind.idle(self.nudges)
        self.nudges += 1
        self._play(conv, plan)
        if self.nudges <= 3:             # the last one is the shutdown
            self.idle_timer = self._later(self.idle, self._wander)

    def status_lines(self):
        a = self.account
        lines = ["%s (floyd): %s%s" % (a.display, a.state, " - " + a.detail if a.detail else "")]
        if self.phase == "up":
            lines.append("Floyd calls you %s; he has said %d thing%s so far"
                         % (self.nick, self.spoken, "" if self.spoken == 1 else "s"))
            lines.append("level %s: %s" % (self.level, tvf.LEVEL_BLURB[self.level]))
            lines.append("on his own he speaks up after %s of quiet" %
                         ("%d seconds" % self.idle if self.idle else "- never (idle=0)"))
            if self.mind.game:
                lines.append("a game of Hider and Seeker is on (Floyd is %s)"
                             % ("seeking" if self.mind.game == "hide" else "hiding"))
        return lines


ADAPTERS = {"irc": IrcAdapter, "deltachat": DeltaChatAdapter, "talk": TalkAdapter,
            "floyd": FloydAdapter}


# --------------------------------------------------------------------------
# Checking a tvchat.conf (the in-app editor's Verify, and `check-config FILE`):
# the file parses, every account has what its protocol needs, and the things it
# points at are there.  Nothing is connected; what cannot be known without a
# login is not claimed.  Errors stop the file being applied; warnings do not.
# --------------------------------------------------------------------------
def _port_problem(opts, key, ident):
    v = (opts.get(key) or "").strip()
    if v and not (v.isdigit() and 0 < int(v) < 65536):
        return "[account:%s] %s must be a port number (1-65535), not %r" % (ident, key, v)
    return None


def check_config(path):
    """(errors, warnings, summary) for the config file at `path`."""
    errors, warnings = [], []
    try:
        accounts, auto = load_config(path)
    except UserError as e:
        return [str(e)], [], ""
    for a in accounts:
        o, i = a.opts, a.id
        if a.protocol in ("irc", "talk") and not (o.get("host") or "").strip():
            errors.append("[account:%s] host= is missing" % i)
        for key in ("port", "imap_port", "smtp_port"):
            bad = _port_problem(o, key, i)
            if bad:
                errors.append(bad)
        if a.protocol == "irc":
            host = (o.get("host") or "").strip()
            ca = (o.get("cafile") or "").strip()
            if ca and not os.path.isfile(os.path.expanduser(ca)):
                warnings.append("[account:%s] cafile %s is not a file on this machine" % (i, ca))
            sasl = (o.get("sasl") or "").strip()
            if sasl and host and not find_password_where(i, host, sasl, "irc")[0]:
                warnings.append("[account:%s] no password found for %s on %s: $%s, ~/.mu-tickets or "
                                "~/.netrc (machine %s login %s)" % (i, sasl, host, _env_name(i), host, sasl))
        elif a.protocol == "floyd":
            try:
                FloydAdapter.idle_seconds(o.get("idle"))
            except UserError as e:
                errors.append("[account:%s] %s" % (i, e))
            if (o.get("seed") or "").strip() and not (o.get("seed") or "").strip().isdigit():
                errors.append("[account:%s] seed= must be a whole number" % i)
            if (o.get("level") or "").strip() and tvf.parse_level(o.get("level")) is None:
                errors.append("[account:%s] level= must be one of %s" % (i, ", ".join(tvf.LEVELS)))
        elif a.protocol == "deltachat":
            addr = (o.get("addr") or "").strip()
            if not DeltaChatAdapter.ADDRESS.match(addr):
                errors.append("[account:%s] addr= must be the mailbox's email address" % i)
                continue
            rpc = (o.get("rpc_server") or "deltachat-rpc-server").strip()
            if os.sep in rpc:
                found = os.path.isfile(os.path.expanduser(rpc))
            else:
                found = bool(shutil.which(rpc))
            if not found:
                warnings.append("[account:%s] the Delta Chat core %s was not found (see PRIMER.md)" % (i, rpc))
            ad = DeltaChatAdapter.__new__(DeltaChatAdapter)
            ad.account, ad.addr = a, addr
            host, login = ad._login()
            data = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                                "tvchat", "deltachat", i)
            if not os.path.exists(os.path.join(data, "accounts.toml")) and \
                    not find_delta_password(i, addr, host, login)[0]:
                warnings.append("[account:%s] the first connect needs a password for %s: $%s or ~/.netrc "
                                "(machine %s login %s)" % (i, login, _env_name(i), host, login))
    ids = ", ".join("%s (%s)" % (a.id, a.protocol) for a in accounts) or "none"
    return errors, warnings, "%d account%s: %s" % (len(accounts), "" if len(accounts) == 1 else "s", ids)


# --------------------------------------------------------------------------
# The chat service: the accounts, the event queue and the protocol adapters,
# behind the verbs the UI calls.  One instance per process.
# --------------------------------------------------------------------------
class Chat:
    def __init__(self, loop=None, clock=time.time):
        self.loop = loop or Loop()
        self.events = EventQueue(clock)
        # A broken tvchat.conf must not kill the co-process before its banner
        # (tvchat would just see a dead backend); keep the complaint and give
        # it, as a user-facing error, to every verb that needs the accounts.
        self.conf_error = None
        try:
            self.accounts, self.autoconnect = load_config()
        except UserError as e:
            self.conf_error = e
            self.accounts, self.autoconnect = [], []
        self.by_id = dict((a.id, a) for a in self.accounts)
        self.adapters = {}
        # set by `floyd-daemon`: this process is the central Floyd, a headless
        # bot on the server, not a tvchat session
        self.daemon = False

    def check_config(self):
        if self.conf_error is not None:
            raise self.conf_error

    def account(self, ident):
        self.check_config()
        a = self.by_id.get(ident)
        if a is None:
            raise UserError("no chat account %r - see tvchat.conf" % ident)
        return a

    def adapter(self, account):
        ad = self.adapters.get(account.id)
        if ad is None:
            ad = self.adapters[account.id] = ADAPTERS[account.protocol](self, account)
        return ad

    def conv(self, conv_id):
        ident, _, target = conv_id.partition("/")
        acct = self.account(ident)
        conv = acct.convs.get(conv_id)
        if conv is None:
            raise UserError("no conversation %r" % conv_id)
        return conv

    def set_state(self, account, state, detail=""):
        _log.debug("%s: state %s %s", account.id, state, detail)
        account.state, account.detail = state, detail
        self.events.push("state", account.id, state, detail)

    def ensure_conv(self, account, target, kind, title=None):
        cid = "%s/%s" % (account.id, target)
        conv = account.convs.get(cid)
        if conv is None:
            conv = account.convs[cid] = Conversation(account, target, kind, title)
            self.events.push("conv-new", *conv.fields())
        return conv

    def remove_conv(self, conv):
        if conv.account.convs.pop(conv.id, None) is not None:
            self.events.push("conv-gone", *conv.fields())

    def set_call(self, conv, state, detail=""):
        """A talk call's state changed: 'talk CONV STATE DETAIL'."""
        conv.state = state
        self.events.push("talk", conv.id, state, detail)

    def typing(self, conv, text):
        """The other side's unfinished line in a talk call ('' when none):
        'typing CONV TEXT'.  Classic shows it as typed; IRC mode, that they
        are typing."""
        self.events.push("typing", conv.id, text)

    def add_message(self, conv, msg, count=True):
        conv.history.append(msg)
        self.events.push("msg", *msg.fields())
        if count:
            conv.unread += 1
            self.events.push("unread", conv.id, conv.unread)
        for ad in list(self.adapters.values()):      # Floyd, where he is attached
            if isinstance(ad, FloydAdapter):
                try:
                    ad.hear(conv, msg)
                except Exception:
                    _log.exception("floyd: hearing %s failed", conv.id)

    def floyd(self):
        """The Floyd account's adapter, or a UserError saying how to have one."""
        self.check_config()
        for a in self.accounts:
            if a.protocol == "floyd":
                return self.adapter(a)
        raise UserError("no Floyd account - add [account:floyd] with protocol = floyd to tvchat.conf")

    def merge_history(self, conv, msgs):
        """Messages from the server's history into the ring, in time order,
        each msgid once; never unread (they are the past).  Returns how many
        were new.  The ring may grow past HISTORY_CAP by what was fetched
        older, so fetching never throws away the very lines asked for."""
        have = set(m.id for m in conv.history)
        new = []
        for m in msgs:
            if m.id not in have:
                have.add(m.id)
                m.conv = conv.id
                new.append(m)
        if new:
            merged = sorted(list(conv.history) + new, key=lambda m: m.when)
            conv.history = deque(merged, maxlen=max(HISTORY_CAP, len(merged)))
        return len(new)

    def set_topic(self, conv, text):
        conv.topic = text
        self.events.push("topic", conv.id, text)

    def mark_read(self, conv, msgid=None, hook=True):
        ad = self.adapters.get(conv.account.id)
        if hook and hasattr(ad, "marked_read"):
            ad.marked_read(conv, msgid)  # the protocol's own "seen" (Delta Chat)
        for msg in conv.history:
            if "r" not in msg.flags:
                msg.flags += "r"
            if msgid is not None and msg.id == msgid:
                break
        if conv.unread:
            conv.unread = 0
            self.events.push("unread", conv.id, 0)

    def connect(self, account):
        try:
            self.adapter(account).connect()
        except UserError as e:
            self.set_state(account, "error", str(e))
            raise

    def reload_config(self):
        """Re-read tvchat.conf and make the accounts match it.  Untouched accounts
        keep their connections and conversations; one that was removed or changed
        is disconnected (and one that was live is connected again, changed); new ones
        are added (and connected if [chat] autoconnect names them).  A file that does
        not load changes nothing.  Returns a one-line summary."""
        accounts, auto = load_config()                  # a UserError leaves everything as it was
        self.conf_error = None
        old = dict((a.id, a) for a in self.accounts)
        new = dict((a.id, a) for a in accounts)
        removed = [i for i in old if i not in new]
        changed = [i for i in old if i in new and
                   (old[i].protocol != new[i].protocol or old[i].opts != new[i].opts)]
        added = [i for i in new if i not in old]
        was_live = set()
        for ident in removed + changed:
            ad = self.adapters.pop(ident, None)
            if old[ident].state in ("connecting", "connected"):
                was_live.add(ident)
            if ad is not None:
                try:
                    ad.disconnect()
                except Exception:
                    _log.exception("disconnecting %s failed", ident)
        keep = set(old) - set(removed) - set(changed)
        self.accounts = [old[a.id] if a.id in keep else a for a in accounts]
        self.by_id = dict((a.id, a) for a in self.accounts)
        self.autoconnect = auto
        for ident in changed + [i for i in added if i in auto]:
            if ident in was_live or ident in auto:
                try:
                    self.connect(self.by_id[ident])
                except UserError:
                    pass                                 # reported as the account's state
        parts = []
        for what, names in (("added", added), ("removed", removed), ("changed", changed)):
            if names:
                parts.append("%s %s" % (what, ", ".join(names)))
        return "; ".join(parts) or "no change"

    REQUEST_POLL = 2

    @staticmethod
    def requests_dir():
        """Where other programs (tvmail) leave one-line requests for us."""
        d = os.environ.get("TVCHAT_REQUESTS")
        if d:
            return d
        base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
        return os.path.join(base, "tvchat", "requests")

    def requests_tick(self):
        """Act on the requests waiting in the directory, then look again:
          chat ADDRESS   open the chat with ADDRESS (or invite them by mail)
          invite LINK    offer a Delta Chat invitation found in a mail
        They need a connected Delta Chat account; without one a request waits."""
        try:
            self._requests_once()
        except Exception:
            _log.exception("looking at the requests directory failed")
        self.loop.call_later(self.REQUEST_POLL, self.requests_tick)

    def _requests_once(self):
        d = self.requests_dir()
        try:
            names = sorted(n for n in os.listdir(d) if n.endswith(".req"))
        except OSError:
            return
        ad = next((a for a in self.adapters.values()
                   if isinstance(a, DeltaChatAdapter) and a.phase == "up"), None)
        for n in names[:20]:
            path = os.path.join(d, n)
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    text = fh.readline().strip()
            except OSError:
                continue
            kind, _, arg = text.partition(" ")
            arg = arg.strip()
            if kind not in ("chat", "invite") or not arg or len(arg) > 2000:
                note = "ignored a request I do not understand"
            elif ad is None:
                continue                 # no Delta Chat account is up yet: it waits
            else:
                try:
                    if kind == "chat":
                        conv = ad.join(arg)
                        note = "chat with %s: %s" % (arg, conv.title)
                    elif not DeltaChatAdapter.INVITE.match(arg):
                        raise UserError("not a Delta Chat invite link")
                    else:
                        ad.add_invite(arg)
                        note = "a chat invitation from %s is waiting" % invite_names(arg)
                except UserError as e:
                    note = "request '%s %s' failed: %s" % (kind, arg[:40], e)
            try:
                os.unlink(path)
            except OSError:
                pass
            self.events.push("notice", note)

    def start(self):
        """Connect the [chat] autoconnect accounts; a failure is an event."""
        if any(a.protocol == "deltachat" for a in self.accounts):
            self.loop.call_later(self.REQUEST_POLL, self.requests_tick)
        for ident in self.autoconnect:
            try:
                self.connect(self.by_id[ident])
            except UserError:
                pass                     # already reported as a state event
        for a in self.accounts:          # Floyd, wherever he was left listening
            if a.protocol == "floyd" and a.id not in self.autoconnect:
                ad = self.adapter(a)
                if ad.patterns or ad.memory.data["attached"]:
                    self.connect(a)

    def close(self):
        for ad in self.adapters.values():
            try:
                ad.disconnect()
            except Exception:
                pass


