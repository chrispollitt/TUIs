    }
    ROOMS = {
        "repair": ("Repair Room",
                   "A cramped room full of cheerfully broken machines. Floyd's tools hang on the wall, "
                   "most of them in the wrong order.", {"north": "corridor"}),
        "corridor": ("Corridor",
