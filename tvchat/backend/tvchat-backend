COMMAND_WORDS = {}
for _n, (_al, _by) in COMMAND_TABLE.items():
    COMMAND_WORDS[_n] = _n
    for _a in _al:
        COMMAND_WORDS[_a] = _n
PROTO_LABEL = {"irc": "IRC", "talk": "talk", "deltachat": "Delta Chat", "floyd": "Floyd"}


def _variant(name, proto):
    by = COMMAND_TABLE[name][1]
    return by.get(proto) or by.get("*")


def resolve_command(word, proto):
    """The command a typed word means for this protocol; UserError when it is
    unknown or means nothing here."""
    name = COMMAND_WORDS.get(word.lower())
    if name is None:
        raise UserError("unknown command /%s - /help lists them; //text sends a line starting with /"
                        % word)
    if _variant(name, proto) is None:
        raise UserError("/%s is not available for %s - /help lists what is" % (name, PROTO_LABEL.get(proto, proto)))
    return name


def help_lines(proto, arg=""):
    """/help: the commands for this protocol, or one explained."""
    arg = arg.strip().lstrip("/")
    if arg:
        name = COMMAND_WORDS.get(arg.lower())
        if name is None:
            raise UserError("no command /%s - /help lists them" % arg)
        v = _variant(name, proto)
        if v is None:
            others = ", ".join(PROTO_LABEL[k] for k in sorted(COMMAND_TABLE[name][1]) if k in PROTO_LABEL)
            raise UserError("/%s is not available for %s (it is for %s)" % (name, PROTO_LABEL.get(proto, proto), others))
        out = [v[0], "    " + v[1]]
        if COMMAND_TABLE[name][0]:
            out.append("    also: " + ", ".join("/" + a for a in COMMAND_TABLE[name][0]))
        return out
    out = ["%s commands (//text sends a line that starts with /):" % PROTO_LABEL.get(proto, proto)]
    aliases = []
    for name in COMMAND_ORDER:
        v = _variant(name, proto)
        if v is None:
            continue
        out.append("  %-27s %s" % (v[0], v[1]))
        aliases += ["/" + a for a in COMMAND_TABLE[name][0]]
    out.append("also " + " ".join(aliases) + " - /help COMMAND explains one")
    return out


def _need(cond, usage):
    if not cond:
        raise UserError("usage: %s" % usage)


def _dur(secs):
    secs = int(max(0, secs))
    d, secs = divmod(secs, 86400)
    h, secs = divmod(secs, 3600)
    m, secs = divmod(secs, 60)
    return ("%dd" % d if d else "") + ("%dh" % h if h or d else "") + ("%dm" % m if m or h or d else "") + "%ds" % secs


def account_counts(account):
    convs = [c for c in account.convs.values() if c.kind != "server"]
    unread = sum(c.unread for c in convs)
    return "%d conversation%s, %d unread" % (len(convs), "" if len(convs) == 1 else "s", unread)


class CommandMixin(object):
    """What every adapter shares in typing: send() splits the text into lines,
    each a /command (answered by a c_<name> method that returns a plan - a
    function and its arguments, run once the whole text is known to be good) or
    a message (speak()).  A bad line refuses the whole text before anything is sent,
    so it can be fixed and sent again.  Needs: need_up(), speak(conv, text),
    system(conv, text), status_lines(), SERVER_TEXT_REFUSAL."""

    SERVER_TEXT_REFUSAL = "the server window takes no messages - only /commands (/help lists them)"

    def send(self, conv, text):
        self.need_up()
        todo = []
        for ln in text.split("\n"):
            ln = ln.rstrip("\r")
            if not ln.strip():
                continue
            if ln.startswith("/") and not ln.startswith("//"):
                todo.append(self._command(conv, ln))
            elif conv.kind == "server":
                raise UserError(self.SERVER_TEXT_REFUSAL)
            else:
                todo.append((self.speak, (conv, ln[1:] if ln.startswith("//") else ln)))
        if not todo:
            raise UserError("nothing to send")
        msgid = ""
        for fn, args in todo:
            msgid = fn(*args) or msgid
        return msgid

    def _command(self, conv, ln):
        word, _, rest = ln[1:].partition(" ")
        name = resolve_command(word, self.account.protocol)
        fn = getattr(self, "c_" + name, None)
        if fn is None:
            raise UserError("/%s is not implemented for %s yet" % (name, PROTO_LABEL.get(self.account.protocol)))
        return fn(conv, rest.strip())

    def _notes(self, conv, lines):
        for ln in lines:
            self.system(conv, ln)

    def _in_a_chat(self, conv, what):
        if conv.kind == "server":
            raise UserError("%s needs a conversation, not the server window" % what)

    # -- the same everywhere ------------------------------------------------------
    def c_help(self, conv, rest):
        return (self._notes, (conv, help_lines(self.account.protocol, rest)))

    def c_status(self, conv, rest):
        return (self._notes, (conv, self.status_lines()))

    def c_shrug(self, conv, rest):
        self._in_a_chat(conv, "/shrug")
        return (self.speak, (conv, (rest + " " if rest else "") + "\xaf\\_(\u30c4)_/\xaf"))

    def c_floyd(self, conv, rest):
        """/floyd [on|off|status]: have Floyd listen in this conversation (he
        answers !commands and 'floyd: ...', speaking as you, tagged)."""
        self._in_a_chat(conv, "/floyd")
        word = rest.strip().lower() or "on"
        if word not in ("on", "off", "status"):
            raise UserError("usage: /floyd [on|off|status]")
        ad = self.chat.floyd()
        return (self._floyd_cmd, (ad, conv, word))

    def _floyd_cmd(self, ad, conv, word):
        if word == "status":
            note = "Floyd is %s here" % ("listening" if ad.attached(conv) and ad.phase == "up"
                                         else "not listening")
        else:
            note = ad.attach(conv, word == "on")
        self.system(conv, note)

    def c_clear(self, conv, rest):
        return (self._clear_cmd, (conv,))

    def _clear_cmd(self, conv):
        """Forget the in-memory log (the UI re-reads it: empty); Delta Chat's own
        history stays in the core and PgUp brings it back."""
        conv.history.clear()
        conv.history_done = False
        self.chat.events.push("history", conv.id, "latest")

    def counts(self):
        return account_counts(self.account)


# --------------------------------------------------------------------------
# The IRC adapter: one non-blocking socket (TLS by default) on the shared
# loop.  Everything server-specific is negotiated (CAP LS 302, ISUPPORT),
# never assumed, so the same code serves Libera.Chat today and a home Ergo
# server later.
# --------------------------------------------------------------------------
class IrcAdapter(CommandMixin):
    # requested when the server offers them; sasl only with an account name
    # and a password to send
    WANT_CAPS = ("sasl", "server-time", "message-tags", "echo-message", "batch",
                 "chathistory", "draft/chathistory", "away-notify",
                 "account-tag", "multi-prefix", "labeled-response")
    TIMEOUT = 60                         # connect + TLS + registration
    # keepalive: our own PING after this long without a byte from the
    # server, and the connection is dead if nothing comes back in GRACE
    PING_IDLE = 90
    PING_GRACE = 30
    # reconnect after losing a connection that was up: 2, 4, 8 ... 300 s;
    # one that stayed up this long starts the count again
    RETRY_FIRST = 2
    RETRY_MAX = 300
    RETRY_STABLE = 60
    # flood control once registered: a burst of this many lines, then one
    # every RATE seconds (PONG, our PING and QUIT go first, unqueued)
    BURST = 5
    RATE = 0.5
    HISTORY_FETCH = 50                   # CHATHISTORY: messages per request
    SERVER_TEXT_REFUSAL = ("the server window takes no messages - only "
                           "/commands (/join, /msg, /nick, /quote ... /help lists them)")

    def __init__(self, chat, account):
        self.chat = chat
        self.account = account
        self.loop = chat.loop
        o = account.opts
        self.host = (o.get("host") or "").strip()
        self.tls = _bool(o.get("tls"), True)
        self.port = int(o.get("port") or (6697 if self.tls else 6667))
        self.verify = _bool(o.get("verify"), True)
        self.cafile = os.path.expanduser((o.get("cafile") or "").strip()) or None
        self.want_nick = (o.get("nick") or "").strip() or _me()
        self.username = (o.get("username") or "").strip() or self.want_nick
        self.realname = (o.get("realname") or "").strip() or self.want_nick
        self.sasl_user = (o.get("sasl") or "").strip()
        self.channels = [c.strip() for c in (o.get("channels") or "").split(",")
                         if c.strip()]
        self.gen = 0                     # bumped on close: stale callbacks no-op
        self._ids = 0
        self.raw_tap = None              # irc-tail --raw: fn(direction, line)
        # reconnecting survives _reset(): it spans several connections
        self.retry_timer = None
        self.attempt = 0                 # reconnects tried since the last good one
        self.auto = False                # reconnecting by ourselves (not asked)
        self._reset()

    def _reset(self):
        self.sock = None
        self.phase = "down"              # down, resolving, connecting, tls,
        self.rbuf = b""                  # registering, up
        self.wbuf = b""
        self.pings = {}                  # /ping tokens -> (sent, conv id, nick)
        self.outq = deque()              # encoded lines waiting for flood control
        self.tokens = float(self.BURST)
        self.t_tok = None
        self.pump_timer = None
        self.ka_timer = None
        self.ping_out = None             # when our keepalive PING went out
        self.t_welcome = None
        self.batches = {}                # open BATCH ref -> [type, target, msgs]
        self.fetching = {}               # conv id -> "latest" / "before": asked
        self.timer = None
        self.addrs = []
        self.nick = self.want_nick
        self.caps = set()
        self.offered = {}
        self.ls_acc = []
        self.cap_done = False
        self.password = self.password_from = None
        self.server = self.host
        self.casemapping = "rfc1459"
        self.chantypes = "#&"
        self.history_max = 0             # ISUPPORT CHATHISTORY=N (0: no limit given)
        self.prefixes = dict(_PREFIX_ROLE)
        # for the log: why a connection ended is easier to tell with these
        self.t_up = None                 # when the TCP connection was made
        self.t_in = None                 # when the server last sent anything
        self.n_in = self.n_out = 0       # bytes read / written

    def _later(self, delay, fn):
        """call_later for this connection only: a no-op once it is closed."""
        gen = self.gen
        return self.loop.call_later(delay, lambda: gen == self.gen and fn())

    # -- lifecycle ----------------------------------------------------------
    def connect(self):
        if self.phase != "down":
            return
        self.loop.cancel(self.retry_timer)   # asked to now: no need to wait
        self.retry_timer = None
        if not self.host:
            raise UserError("[account:%s] has no host=" % self.account.id)
        self.password = self.password_from = None
        if self.sasl_user:
            self.password, self.password_from = find_password_where(
                self.account.id, self.host, self.sasl_user, "irc")
            if not self.password:
                raise UserError(
                    "no SASL password for %s on %s - add it to ~/.netrc "
                    "(machine %s login %s password ...), ~/.mu-tickets, or "
                    "set $%s; or drop sasl= from [account:%s]"
                    % (self.sasl_user, self.host, self.host, self.sasl_user,
                       _env_name(self.account.id), self.account.id))
        self.server_conv()
        self.phase = "resolving"
        gen = self.gen
        self.timer = self.loop.call_later(self.TIMEOUT,
                                          lambda: self._fail("timed out"))
        self.chat.set_state(self.account, "connecting",
                            "looking up %s" % self.host)
        host, port = self.host, self.port
        self.loop.run_in_thread(
            lambda: socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM),
            lambda res, err: gen == self.gen and self._resolved(res, err))

    def _resolved(self, res, err):
        if err is not None or not res:
            self._fail("cannot look up %s: %s" % (self.host, err))
            return
        self.addrs = list(res)
        self._try_next(None)

    def _try_next(self, why):
        while self.addrs:
            family, stype, proto, _, addr = self.addrs.pop(0)
            try:
                s = socket.socket(family, stype, proto)
            except OSError as e:
                why = e
                continue
            s.setblocking(False)
            rc = s.connect_ex(addr)
            _log.debug("%s: connect %s port %d -> %s", self.account.id, addr[0],
                       self.port, errno.errorcode.get(rc, rc) if rc else "ok")
            if rc in (0, errno.EINPROGRESS, errno.EWOULDBLOCK):
                self.sock = s
                self.phase = "connecting"
                self.chat.set_state(self.account, "connecting",
                                    "connecting to %s port %d" % (addr[0], self.port))
                self.loop.watch(s, on_write=self._connected)
                return
            why = os.strerror(rc)
            s.close()
        self._fail("cannot connect to %s port %d: %s" % (self.host, self.port, why))

    def _connected(self):
        err = self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR)
        if err:
            _log.debug("%s: connect failed: %s", self.account.id, os.strerror(err))
            self.loop.watch(self.sock)
            self.sock.close()
            self.sock = None
            self._try_next(os.strerror(err))
            return
        self.t_up = self.t_in = self.loop.clock()
        try:
            _log.debug("%s: connected %s -> %s", self.account.id,
                       self.sock.getsockname(), self.sock.getpeername())
        except OSError:
            pass
        if not self.tls:
            self._register()
            return
        try:
            if self.verify and self.cafile and not os.path.isfile(self.cafile):
                self._fail("cafile %s does not exist on this machine (account %s: put the server's "
                           "certificate there, or change cafile = in tvchat.conf; ~ is your home)"
                           % (self.cafile, self.account.id))
                return
            if self.verify:
                ctx = ssl.create_default_context(cafile=self.cafile)
            else:
                ctx = ssl.create_default_context()
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
            raw = self.sock
            self.loop.watch(raw)
            self.sock = ctx.wrap_socket(raw, server_hostname=self.host,
                                        do_handshake_on_connect=False)
        except (OSError, ssl.SSLError) as e:
            self._fail("TLS: %s" % e)
            return
        self.phase = "tls"
        self._handshake()

    def _handshake(self):
        try:
            self.sock.do_handshake()
        except ssl.SSLWantReadError:
            self.loop.watch(self.sock, on_read=self._handshake)
            return
        except ssl.SSLWantWriteError:
            self.loop.watch(self.sock, on_write=self._handshake)
            return
        except (OSError, ssl.SSLError, ssl.CertificateError) as e:
            self._fail("TLS: %s" % (getattr(e, "reason", None) or e))
            return
        _log.debug("%s: TLS %s %s (verify=%s)", self.account.id, self.sock.version(),
                   (self.sock.cipher() or ("?",))[0], self.verify)
        self._register()

    def _register(self):
        self.phase = "registering"
        self.chat.set_state(self.account, "connecting", "registering")
        self.send_raw("CAP LS 302")
        self.send_raw("NICK %s" % self.nick)
        self.send_raw("USER %s 0 * :%s" % (self.username, self.realname))

    def disconnect(self, message="tvchat"):
        if self.phase in ("registering", "up") and self.sock is not None:
            while self.outq:             # what you typed still goes, then QUIT
                self.wbuf += self.outq.popleft()
            self.send_raw("QUIT :%s" % message, urgent=True)
            try:                         # best effort: one push of what's queued
                self.sock.setblocking(True)
                self.sock.settimeout(2)
                self.sock.sendall(self.wbuf)
            except (OSError, ssl.SSLError):
                pass
        was = self.phase
        retrying = self.retry_timer is not None or self.auto
        self._stop_retrying()
        self._close()
        if was != "down" or retrying:
            self.chat.set_state(self.account, "disconnected", "")

    def _stop_retrying(self):
        self.loop.cancel(self.retry_timer)
        self.retry_timer = None
        self.auto = False
        self.attempt = 0

    def _close(self):
        self.gen += 1
        self.loop.cancel(self.timer)
        self.loop.cancel(self.pump_timer)
        self.loop.cancel(self.ka_timer)
        if self.sock is not None:
            try:
                self.loop.watch(self.sock)
            except (OSError, ValueError, KeyError):
                pass
            try:
                self.sock.close()
            except OSError:
                pass
        for conv in self.account.convs.values():
            if conv.members:
                conv.members.clear()
                self.chat.events.push("members", conv.id)
        self._reset()

    def _ended(self, how, why):
        now = self.loop.clock()
        _log.debug("%s: %s in phase %s: %s (up %s s, %s s since the server last "
                   "sent anything, %d bytes in, %d out, %d unsent, %d queued)",
                   self.account.id, how, self.phase, why,
                   "%.1f" % (now - self.t_up) if self.t_up else "-",
                   "%.1f" % (now - self.t_in) if self.t_in else "-",
                   self.n_in, self.n_out, len(self.wbuf), len(self.outq))

    def _drop_queue(self):
        """Lines flood control still held when the connection went: said in
        the server window, since a local echo may already show them."""
        if self.outq:
            n = len(self.outq)
            self.outq.clear()
            self.system(self.server_conv(), "%d line%s not sent: the connection was lost"
                        % (n, "" if n == 1 else "s"))

    def _fail(self, why):
        """A connection attempt that did not get through."""
        self._ended("failed", why)
        self._drop_queue()
        self._close()
        if self.auto:
            self._retry(why)
        else:
            self.chat.set_state(self.account, "error", why)

    def _lost(self, why):
        """A connection that was made and is gone.  One that was up (or is
        a reconnect) is tried again, with backoff; a first attempt that the
        server hung up on is not - that is for the user to retry."""
        self._ended("lost", why)
        again = self.phase == "up" or self.auto
        if self.t_welcome is not None and \
                self.loop.clock() - self.t_welcome >= self.RETRY_STABLE:
            self.attempt = 0             # it had been fine for a while
        self._drop_queue()
        self._close()
        if again:
            self._retry(why)
        else:
            self.chat.set_state(self.account, "disconnected", why)

    def _retry(self, why):
        """Wait 2, 4, 8 ... 300 s, then connect again.  The account stays
        'connecting' meanwhile, so the UI keeps polling quickly and lists
        it under Disconnect; on_welcome rejoins the open channels."""
        delay = min(self.RETRY_MAX, self.RETRY_FIRST * 2 ** min(self.attempt, 16))
        self.attempt += 1
        self.auto = True
        what = "%s - reconnecting in %s s" % (why, ("%g" % delay))
        self.system(self.server_conv(), what)
        self.chat.set_state(self.account, "connecting", what)
        self.retry_timer = self.loop.call_later(delay, self._reconnect)

    def _reconnect(self):
        self.retry_timer = None
        if not self.auto or self.phase != "down":
            return
        try:
            self.connect()
        except UserError as e:           # e.g. the password is gone now
            self._stop_retrying()
            self.chat.set_state(self.account, "error", str(e))

    # -- the socket ---------------------------------------------------------
    def send_raw(self, text, secret=False, urgent=False):
        """Queue one line.  Before registration completes, and for urgent
        lines (PONG, our PING, QUIT), it goes straight out; after that,
        flood control paces it - the server would cut us off for a burst
        (a long paste)."""
        data = text.encode("utf-8", "replace")[:510] + b"\r\n"
        shown = text.split(" ", 1)[0] + " <redacted>" if secret else text
        _log.debug("%s >> %s", self.account.id, shown)
        if self.raw_tap:
            self.raw_tap(">>", shown)
        if urgent or self.phase != "up":
            self.wbuf += data
        else:
            self.outq.append(data)
            self._pump()
        self._rewatch()

    def _pump(self):
        """Move queued lines to the socket as the token bucket allows; if
        some must wait, come back when the next token is due."""
        self.loop.cancel(self.pump_timer)
        self.pump_timer = None
        now = self.loop.clock()
        if self.t_tok is not None:
            self.tokens = min(float(self.BURST),
                              self.tokens + (now - self.t_tok) / self.RATE)
        self.t_tok = now
        moved = False
        while self.outq and self.tokens >= 1:
            self.wbuf += self.outq.popleft()
            self.tokens -= 1
            moved = True
        if self.outq:
            self.pump_timer = self._later((1 - self.tokens) * self.RATE, self._pump)
        if moved:
            self._rewatch()

    def _rewatch(self):
        if self.sock is not None and self.phase in ("registering", "up"):
            self.loop.watch(self.sock, on_read=self._on_read,
                            on_write=self._on_write if self.wbuf else None)

    def _on_write(self):
        try:
            n = self.sock.send(self.wbuf)
            self.wbuf = self.wbuf[n:]
            self.n_out += n
        except (BlockingIOError, ssl.SSLWantWriteError, ssl.SSLWantReadError):
            pass
        except (OSError, ssl.SSLError) as e:
            _log.debug("%s: send failed: %r", self.account.id, e)
            self._lost(str(e))
            return
        self._rewatch()

    def _on_read(self):
        gen = self.gen
        gone = None
        while True:                      # drain the socket (and TLS's buffer)
            try:
                data = self.sock.recv(16384)
            except (BlockingIOError, ssl.SSLWantReadError, ssl.SSLWantWriteError):
                break
            except (OSError, ssl.SSLError) as e:
                _log.debug("%s: recv failed: %r", self.account.id, e)
                gone = str(e)
                break
            if not data:
                gone = "connection closed by the server"
                break
            self.rbuf += data
            self.n_in += len(data)
            self.t_in = self.loop.clock()
            self.ping_out = None         # anything at all answers a keepalive
        # what arrived before a hang-up still counts - above all the server's
        # ERROR line, which says why it hung up
        while b"\n" in self.rbuf and gen == self.gen:
            raw, self.rbuf = self.rbuf.split(b"\n", 1)
            text = raw.decode("utf-8", "replace").rstrip("\r")
            _log.debug("%s << %s", self.account.id, text)
            if self.raw_tap:
                self.raw_tap("<<", text)
            m = parse_line(text)
            if m is not None:
                try:
                    self.handle(m)
                except Exception:        # one bad line, not the connection
                    _log.exception("%s: handling %r failed", self.account.id, text)
        if gone is not None and gen == self.gen:
            self._lost(gone)

    # -- the shared model ---------------------------------------------------
    def lower(self, s):
        return irc_lower(s, self.casemapping)

    def is_channel(self, target):
        return bool(target) and target[0] in self.chantypes

    def is_me(self, nick):
        return self.lower(nick) == self.lower(self.nick)

    def server_conv(self):
        return self.chat.ensure_conv(self.account, "*", "server", self.account.display)

    def conv_for(self, target, kind=None):
        kind = kind or ("channel" if self.is_channel(target) else "direct")
        return self.chat.ensure_conv(self.account, self.lower(target), kind, target)

    def find_conv(self, target):
        return self.account.convs.get("%s/%s" % (self.account.id, self.lower(target)))

    def local_id(self):
        self._ids += 1
        return "%s:%d" % (self.account.id, self._ids)

    def system(self, conv, text, when=None):
        self.chat.add_message(conv, Message(
            self.local_id(), conv.id, when or time.time(),
            Contact(self.server), text, "n"), count=False)

    # -- protocol -----------------------------------------------------------
    def handle(self, m):
        ref = m.tags.get("batch")
        if ref and ref in self.batches and self.batches[ref][0] == "chathistory":
            if m.command in ("PRIVMSG", "NOTICE"):
                self.on_PRIVMSG(m, notice=m.command == "NOTICE", into=self.batches[ref][2])
            return                       # replayed JOINs &c: not asked for
        fn = getattr(self, "on_" + m.command, None)
        if fn is not None:
            fn(m)
        elif m.command.isdigit():
            self.on_numeric(m)

    def on_PING(self, m):
        self.send_raw("PONG :%s" % (m.params[-1] if m.params else ""), urgent=True)

    def _keepalive(self):
        """Every connection that is up: after PING_IDLE s of silence send a
        PING; nothing back within PING_GRACE s and the connection is dead
        (a NAT that forgot it, a laptop that slept) - _lost reconnects."""
        self.ka_timer = None
        if self.phase != "up":
            return
        now = self.loop.clock()
        if self.ping_out is not None:
            if now - self.ping_out >= self.PING_GRACE:
                self._lost("no reply from the server for %d s" % round(now - self.t_in))
                return
            due = self.ping_out + self.PING_GRACE
        elif now - self.t_in >= self.PING_IDLE:
            self.ping_out = now
            self.send_raw("PING :tvchat", urgent=True)
            due = now + self.PING_GRACE
        else:
            due = self.t_in + self.PING_IDLE
        self.ka_timer = self._later(max(0.01, due - now), self._keepalive)

    def on_ERROR(self, m):
        self._lost(m.params[-1] if m.params else "ERROR")

    def on_CAP(self, m):
        sub = m.params[1].upper() if len(m.params) > 1 else ""
        if sub == "LS":
            if len(m.params) > 3 and m.params[2] == "*":   # more LS lines follow
                self.ls_acc.append(m.params[3])
                return
            self.ls_acc.append(m.params[-1])
            for tok in " ".join(self.ls_acc).split():
                k, _, v = tok.partition("=")
                self.offered[k] = v
            self.ls_acc = []
            want = [c for c in self.WANT_CAPS if c in self.offered]
            if "sasl" in want:
                mechs = self.offered["sasl"]
                if not (self.sasl_user and self.password) or \
                        (mechs and "PLAIN" not in mechs.upper().split(",")):
                    want.remove("sasl")
            if want:
                self.send_raw("CAP REQ :%s" % " ".join(want))
            else:
                self.cap_end()
        elif sub == "ACK":
            for c in m.params[-1].split():
                if c.startswith("-"):
                    self.caps.discard(c[1:])
                else:
                    self.caps.add(c)
            if "sasl" in self.caps and self.phase == "registering" and not self.cap_done:
                self.send_raw("AUTHENTICATE PLAIN")
            else:
                self.cap_end()
        elif sub == "NAK":
            self.cap_end()
        elif sub == "DEL":
            for c in m.params[-1].split():
                self.caps.discard(c)

    def cap_end(self):
        if not self.cap_done and self.phase == "registering":
            self.cap_done = True
            self.send_raw("CAP END")

    def on_AUTHENTICATE(self, m):
        if m.params and m.params[0] == "+":
            blob = ("%s\0%s\0%s" % (self.sasl_user, self.sasl_user,
                                    self.password)).encode("utf-8")
            b64 = base64.b64encode(blob).decode("ascii")
            for i in range(0, len(b64), 400):
                self.send_raw("AUTHENTICATE %s" % b64[i:i + 400], secret=True)
            if len(b64) % 400 == 0:
                self.send_raw("AUTHENTICATE +")

    def on_numeric(self, m):
        n = m.command
        p = m.params
        if n in ("903", "907"):          # SASL ok / already authenticated
            self.cap_end()
        elif n in ("902", "904", "905", "906", "908"):
            self.system(self.server_conv(), "SASL login failed: %s (password for %s from %s)"
                        % (p[-1], self.sasl_user, self.password_from))
            self.cap_end()
        elif n in ("432", "433", "436", "437") and self.phase == "registering":
            self.nick = self.nick + "_"
            self.send_raw("NICK %s" % self.nick)
        elif n == "001":
            self.on_welcome(m)
        elif n == "005":
            self.on_isupport(m)
        elif n == "332" and len(p) >= 3:
            conv = self.find_conv(p[1])
            if conv is not None:
                self.chat.set_topic(conv, strip_formatting(p[2]))
        elif n == "353" and len(p) >= 3:
            conv = self.find_conv(p[-2])
            if conv is not None:
                for name in p[-1].split():
                    role, i = "member", 0
                    while i < len(name) and name[i] in self.prefixes:
                        if role == "member":
                            role = self.prefixes[name[i]]
                        i += 1
                    nick = name[i:].split("!", 1)[0]
                    conv.members[self.lower(nick)] = (nick, nick, role)
        elif n == "366" and len(p) >= 2:
            conv = self.find_conv(p[1])
            if conv is not None:
                self.chat.events.push("members", conv.id)
        elif n in ("333", "329", "315", "352", "900", "901"):
            if n == "900":
                self.system(self.server_conv(), p[-1])
        else:                            # MOTD, errors &c: the server window
            self.system(self.server_conv(), " ".join(p[1:]),
                        parse_server_time(m.tags.get("time")))

    def on_welcome(self, m):
        self.phase = "up"
        self.nick = m.params[0] if m.params else self.nick
        self.server = m.prefix or self.host
        self.loop.cancel(self.timer)
        self.timer = None
        self.cap_done = True
        self.t_welcome = self.t_tok = self.loop.clock()
        self.tokens = float(self.BURST)
        if self.auto:                    # a reconnect that worked
            self.system(self.server_conv(), "reconnected")
        self.auto = False
        self._keepalive()
        self.chat.set_state(self.account, "connected", self.server)
        self.system(self.server_conv(), " ".join(m.params[1:]))
        # the configured channels, plus any still open from before a reconnect
        want = list(self.channels)
        for conv in self.account.convs.values():
            if conv.kind == "channel" and conv.title not in want:
                want.append(conv.title)
        for ch in want:
            self.send_raw("JOIN %s" % ch)

    def on_isupport(self, m):
        for tok in m.params[1:-1]:
            k, _, v = tok.partition("=")
            if k == "CASEMAPPING" and v:
                self.casemapping = v.lower()
            elif k == "CHANTYPES" and v:
                self.chantypes = v
            elif k == "CHATHISTORY" and v.isdigit() and int(v) > 0:
                self.history_max = int(v)
            elif k == "PREFIX" and v.startswith("("):
                modes, _, syms = v[1:].partition(")")
                names = {"q": "owner", "a": "admin", "o": "op", "h": "halfop",
                         "v": "voice"}
                self.prefixes = dict((s, names.get(md, "op"))
                                     for md, s in zip(modes, syms))

    def on_JOIN(self, m):
        if not m.params:
            return
        chan = m.params[0]
        if self.is_me(m.nick):
            conv = self.conv_for(chan, "channel")
            conv.title = chan
            conv.members.clear()
            self.fetch_history(conv, "latest")   # what was said before (or while away)
        else:
            conv = self.find_conv(chan)
            if conv is None:
                return
            conv.members[self.lower(m.nick)] = (m.nick, m.nick, "member")
            self.chat.events.push("members", conv.id)
        self.system(conv, "%s has joined %s" % (m.nick, chan), self.when(m))

    def on_PART(self, m):
        conv = self.find_conv(m.params[0]) if m.params else None
        if conv is None:
            return
        if self.is_me(m.nick):
            self.chat.remove_conv(conv)
            return
        conv.members.pop(self.lower(m.nick), None)
        self.chat.events.push("members", conv.id)
        why = " (%s)" % m.params[1] if len(m.params) > 1 and m.params[1] else ""
        self.system(conv, "%s has left%s" % (m.nick, why), self.when(m))

    def on_KICK(self, m):
        conv = self.find_conv(m.params[0]) if m.params else None
        if conv is None or len(m.params) < 2:
            return
        victim = m.params[1]
        why = m.params[2] if len(m.params) > 2 else ""
        conv.members.pop(self.lower(victim), None)
        if self.is_me(victim):
            conv.members.clear()
        self.chat.events.push("members", conv.id)
        self.system(conv, "%s was kicked by %s (%s)" % (victim, m.nick, why),
                    self.when(m))

    def on_QUIT(self, m):
        why = m.params[0] if m.params else ""
        key = self.lower(m.nick)
        for conv in list(self.account.convs.values()):
            if key in conv.members or (conv.kind == "direct" and conv.target == key):
                if conv.members.pop(key, None) is not None:
                    self.chat.events.push("members", conv.id)
                self.system(conv, "%s has quit (%s)" % (m.nick, why), self.when(m))

    def on_NICK(self, m):
        new = m.params[0] if m.params else ""
        if not new:
            return
        old = self.lower(m.nick)
        if self.is_me(m.nick):
            self.nick = new
            self.system(self.server_conv(), "you are now known as %s" % new)
        for conv in list(self.account.convs.values()):
            ent = conv.members.pop(old, None)
            if ent is not None:
                conv.members[self.lower(new)] = (new, new, ent[2])
                self.chat.events.push("members", conv.id)
                self.system(conv, "%s is now known as %s" % (m.nick, new), self.when(m))

    def on_TOPIC(self, m):
        conv = self.find_conv(m.params[0]) if m.params else None
        if conv is None:
            return
        text = strip_formatting(m.params[1] if len(m.params) > 1 else "")
        self.chat.set_topic(conv, text)
        self.system(conv, "%s set the topic: %s" % (m.nick, text), self.when(m))

    def on_MODE(self, m):
        if len(m.params) >= 2 and self.is_channel(m.params[0]):
            conv = self.find_conv(m.params[0])
            if conv is not None:
                self.system(conv, "%s sets mode %s" % (m.nick, " ".join(m.params[1:])),
                            self.when(m))
                if len(m.params) > 2:    # a user's role may have changed
                    self.send_raw("NAMES %s" % m.params[0])

    def when(self, m):
        return parse_server_time(m.tags.get("time")) or time.time()

    # -- server-side history (IRCv3 chathistory) ------------------------------
    def has_history(self):
        return "batch" in self.caps and bool(
            self.caps & {"chathistory", "draft/chathistory"})

    def fetch_history(self, conv, which):
        """Ask the server for history: 'latest' (on joining - it overlaps
        what we have, msgids sort that out) or 'before' the oldest we have.
        The answer is a BATCH; on_BATCH merges it.  False: nothing asked."""
        if not self.has_history() or self.phase != "up" or conv.kind == "server" \
                or conv.id in self.fetching:
            return False
        n = min(self.HISTORY_FETCH, self.history_max or self.HISTORY_FETCH)
        if which == "before":
            oldest = next((x for x in conv.history if not self.is_local(x.id)), None)
            if oldest is None:
                return False
            ref = "msgid=%s" % oldest.id
        else:
            ref = "*"
        self.fetching[conv.id] = which
        self.send_raw("CHATHISTORY %s %s %s %d" % (which.upper(), conv.title, ref, n))
        return True

    def is_local(self, msgid):
        """Our own ids (no server msgid): ACCOUNT:N."""
        return msgid.startswith(self.account.id + ":")

    def on_BATCH(self, m):
        if not m.params:
            return
        ref = m.params[0]
        if ref.startswith("+"):
            kind = m.params[1] if len(m.params) > 1 else ""
            target = m.params[2] if len(m.params) > 2 else ""
            self.batches[ref[1:]] = [kind, target, []]
            return
        b = self.batches.pop(ref[1:], None)
        if b is None or b[0] != "chathistory":
            return
        conv = self.find_conv(b[1])
        if conv is None:                 # left meanwhile
            return
        which = self.fetching.pop(conv.id, "latest")
        new = self.chat.merge_history(conv, b[2])
        if which == "before" and not new:
            conv.history_done = True     # the server has nothing older either
        self.chat.events.push("history", conv.id, which)

    def on_FAIL(self, m):
        """IRCv3 standard replies: FAIL COMMAND CODE [context ...] :text.
        A refused CHATHISTORY must not leave its request hanging."""
        p = m.params
        text = p[-1] if p else "FAIL"
        if p and p[0] == "CHATHISTORY":
            for cid, which in list(self.fetching.items()):
                del self.fetching[cid]
                conv = self.account.convs.get(cid)
                if conv is not None:
                    if which == "before":
                        conv.history_done = True
                    self.chat.events.push("history", cid, which)
        self.system(self.server_conv(), "%s failed: %s" % (p[0] if p else "?", text))

    def on_PRIVMSG(self, m, notice=False, into=None):
        if len(m.params) < 2:
            return
        target, text = m.params[0], m.params[1]
        flags = "n" if notice else ""
        if text.startswith("\x01"):      # CTCP
            inner = text.strip("\x01")
            verb, _, rest = inner.partition(" ")
            if verb.upper() == "PING" and notice and self._pong(rest, m.nick):
                return
            if verb.upper() != "ACTION":
                if verb.upper() == "VERSION" and not notice and not self.is_me(m.nick) \
                        and into is None:
                    self.send_raw("NOTICE %s :\x01VERSION tvchat %s\x01"
                                  % (m.nick, __version__))
                return
            text, flags = rest, flags + "a"
        mine = self.is_me(m.nick)
        bare = target.lstrip("".join(self.prefixes))      # STATUSMSG: @#chan
        if into is not None:             # replayed history: the batch's conv
            flags += "s" if mine else ""
            into.append(Message(m.tags.get("msgid") or self.local_id(), "", self.when(m),
                                Contact(m.nick), strip_formatting(text), flags + "r"))
            return
        if self.is_channel(bare):
            conv = self.conv_for(bare, "channel")
        elif "!" not in m.prefix and not mine or self.phase != "up" or target == "*":
            conv = self.server_conv()    # server notices
        elif mine:
            conv = self.conv_for(target, "direct")         # our echo of a query
        else:
            conv = self.conv_for(m.nick, "direct")
        if mine:
            flags += "s"
        msg = Message(m.tags.get("msgid") or self.local_id(), conv.id, self.when(m),
                      Contact(m.nick, account=m.tags.get("account") or None),
                      strip_formatting(text), flags)
        self.chat.add_message(conv, msg, count=not mine and conv.kind != "server")

    def on_NOTICE(self, m):
        self.on_PRIVMSG(m, notice=True)

    # -- what the UI asks for -----------------------------------------------
    def need_up(self):
        if self.phase != "up":
            raise UserError("%s is not connected" % self.account.display)

    def join(self, target):
        self.need_up()
        target = target.strip()
        if not target or " " in target or "," in target:
            raise UserError("not a channel or nick: %r" % target)
        if self.is_channel(target):
            self.send_raw("JOIN %s" % target)
            return self.conv_for(target, "channel")
        conv = self.conv_for(target, "direct")
        if not conv.history:
            self.fetch_history(conv, "latest")
        return conv

    def part(self, conv):
        if conv.kind == "server":
            raise UserError("the server window cannot be left - disconnect instead")
        if conv.kind == "channel" and self.phase == "up":
            self.send_raw("PART %s" % conv.title)
        self.chat.remove_conv(conv)

    def speak(self, conv, text):
        return self._say(conv, text)

    def _say(self, conv, text, action=False):
        """PRIVMSG text to conv, split to fit; ours goes in the log at once
        unless the server echoes it (echo-message)."""
        msgid = None
        for piece in split_utf8(text, 400):
            body = "\x01ACTION %s\x01" % piece if action else piece
            self.send_raw("PRIVMSG %s :%s" % (conv.title, body))
            msgid = self.local_id()
            if "echo-message" not in self.caps:
                self.chat.add_message(conv, Message(
                    msgid, conv.id, time.time(), Contact(self.nick), piece,
                    "sa" if action else "s"), count=False)
        return msgid

    # -- the typed commands (the shared table is COMMAND_TABLE) -----------------------
    def c_me(self, conv, rest):
        _need(rest, "/me ACTION")
        if conv.kind == "server":
            raise UserError("/me needs a channel or a person, not the server window")
        return (self._say, (conv, rest, True))

    def c_join(self, conv, rest):
        _need(rest and len(rest.split()) <= 2, "/join #CHANNEL [KEY]")
        chan, _, key = rest.partition(" ")
        if not self.is_channel(chan):
            raise UserError("/join: %s is not a channel (to talk to a person: /query or /msg)" % chan)
        return (self._join_cmd, (chan, key.strip()))

    def c_query(self, conv, rest):
        nick, _, said = rest.partition(" ")
        _need(nick and "," not in nick and not self.is_channel(nick), "/query NICK [TEXT]")
        return (self._msg_cmd, (nick, said.strip()))

    def c_msg(self, conv, rest):
        nick, _, said = rest.partition(" ")
        _need(nick and said.strip() and "," not in nick, "/msg NICK TEXT")
        return (self._msg_cmd, (nick, said.strip()))

    def c_leave(self, conv, rest):
        target = conv
        if rest and self.is_channel(rest.split()[0]):
            chan, _, rest = rest.partition(" ")
            target = self.find_conv(chan)
            if target is None:
                raise UserError("/leave: not in %s" % chan)
        elif conv.kind == "server":
            raise UserError("usage: /leave #CHANNEL [REASON] (in the server window)")
        return (self._part_cmd, (target, rest.strip()))

    def c_nick(self, conv, rest):
        _need(rest and " " not in rest, "/nick NEWNICK")
        return (self.send_raw, ("NICK %s" % rest,))

    def c_topic(self, conv, rest):
        if conv.kind != "channel":
            raise UserError("/topic needs a channel")
        if not rest:                     # just show it
            return (self.system, (conv, "topic: %s" % (conv.topic or "(none)")))
        return (self.send_raw, ("TOPIC %s :%s" % (conv.title, rest),))

    def c_quote(self, conv, rest):
        _need(rest, "/quote RAW IRC LINE")
        return (self.send_raw, (rest,))

    def c_invite(self, conv, rest):
        nick, _, chan = rest.partition(" ")
        chan = chan.strip() or (conv.title if conv.kind == "channel" else "")
        _need(nick and chan and self.is_channel(chan), "/invite NICK [#CHANNEL]")
        return (self.send_raw, ("INVITE %s %s" % (nick, chan),))

    def c_whois(self, conv, rest):
        _need(rest and " " not in rest, "/whois NICK")
        return (self._whois_cmd, (conv, rest))

    def _whois_cmd(self, conv, nick):
        self.send_raw("WHOIS %s" % nick)
        self.system(conv, "asked the server about %s - the answer is in the server messages" % nick)

    def c_away(self, conv, rest):
        return (self.send_raw, ("AWAY :%s" % rest if rest else "AWAY",))

    def c_names(self, conv, rest):
        return (self._notes, (conv, self._names_lines(conv)))

    def _names_lines(self, conv):
        if conv.kind != "channel" or not conv.members:
            return ["no list of names here"]
        sym = {"owner": "~", "admin": "&", "op": "@", "halfop": "%", "voice": "+"}
        people = sorted(conv.members.values(), key=lambda e: (ROLE_RANK.get(e[2], 9), e[0].lower()))
        return ["%d here: %s" % (len(people), ", ".join(sym.get(r, "") + d for _a, d, r in people))]

    def c_ping(self, conv, rest):
        _need(" " not in rest, "/ping [NICK]")
        return (self._ping_cmd, (conv, rest))

    def _ping_cmd(self, conv, nick):
        token = "%d" % int(time.time() * 1000)
        self.pings[token] = (time.time(), conv.id, nick)
        if nick:
            self.send_raw("PRIVMSG %s :\x01PING %s\x01" % (nick, token), urgent=True)
        else:
            self.send_raw("PING :tvping%s" % token, urgent=True)
        self.system(conv, "pinging %s..." % (nick or self.server or "the server"))

    def _pong(self, token, who):
        """A ping we sent came back: tell how long it took."""
        sent = self.pings.pop(token, None)
        if sent is None:
            return False
        conv = self.account.convs.get(sent[1]) or self.server_conv()
        self.system(conv, "ping reply from %s: %d ms" % (who, round((time.time() - sent[0]) * 1000)))
        return True

    def on_PONG(self, m):
        token = m.params[-1] if m.params else ""
        if token.startswith("tvping"):
            self._pong(token[6:], m.nick or self.server or "the server")

    def c_quit(self, conv, rest):
        return (self.disconnect, (rest or "tvchat",))

    def status_lines(self):
        a = self.account
        lines = ["%s (irc): %s%s" % (a.display, a.state, " - " + a.detail if a.detail else "")]
        if self.phase == "up":
            lines.append("you are %s on %s:%d (%s), up %s" % (
                self.nick, self.host, self.port, "TLS" if self.tls else "plain, no TLS",
                _dur(self.loop.clock() - self.t_up) if self.t_up else "?"))
        lines.append(self.counts())
        return lines

    def _join_cmd(self, chan, key):
        self.send_raw("JOIN %s%s" % (chan, " " + key if key else ""))
        self.conv_for(chan, "channel")

    def _part_cmd(self, conv, reason):
        if conv.kind == "channel":
            self.send_raw("PART %s%s" % (conv.title, " :" + reason if reason else ""))
        self.chat.remove_conv(conv)

    def _msg_cmd(self, nick, text):
        target = self.conv_for(nick, "channel" if self.is_channel(nick) else "direct")
        return self._say(target, text) if text else None


# --------------------------------------------------------------------------
# The talk(1) adapter.  chrispollitt/POSIX chat-setup's talkd, on the LAN
# master, does the talk protocol and carries every conversation; this is a
# client of its control protocol (TCP, one line each way):
#   HELLO USER -> OK USER@HOST   CALL CID TARGET -> STATE CID ..., CONNECT/GONE
#   RING ID WHO (a call for us)  ACCEPT / DECLINE / HANGUP ID   PING -> PONG
# and of the second connection a CONNECT asks for: "ATTACH TOKEN", then the
# session's raw bytes - each side's three edit characters first, as talk
# does.  One conversation per person (kind direct); its call's state rides
# on the 'talk' event, the other side's unfinished line on 'typing'.
# --------------------------------------------------------------------------
TALK_EDIT = "\x7f\x15\x17"               # ours: erase (DEL), kill (^U), word-erase (^W)
TALK_LINE_MAX = 1000                     # a line nobody ends is cut here
TALK_TIMEOUT = 20                        # to reach talkd and be greeted


def _edit_line(line, ch, erase, kill, werase):
    """One typed character applied to an unfinished line: (line, done) -
    done is the finished line (on a newline) or None."""
    if ch in ("\n", "\r"):
        return "", line
    if ch == erase or ch in ("\x08", "\x7f"):
        return line[:-1], None
    if ch == kill:
        return "", None
    if ch == werase:
        return line.rstrip(" ").rpartition(" ")[0] + (" " if " " in line.rstrip(" ") else ""), None
    if ch == "\t" or ch >= " ":
        line += ch
        if len(line) >= TALK_LINE_MAX:
            return "", line
        return line, None
    return line, None                    # bell, ^L and the like: nothing to show


class TalkCall:
    """One call: tid is the id talkd knows it by (cN: ours, tN: talkd's)."""

    def __init__(self, conv, tid, outgoing):
        self.conv, self.tid, self.outgoing = conv, tid, outgoing
        self.data = None                 # the session's socket, once CONNECTed
        self.wbuf = b""
        self.edit = None                 # their erase, kill, word-erase
        self.head = b""                  # their first bytes, until the three are in
        self.dec = codecs.getincrementaldecoder("utf-8")("replace")
        self.theirs = ""                 # their unfinished line
        self.mine = ""                   # ours, as keys typed it
        self.after_cr = False            # a "\n" right after "\r" is the same newline
        self.done = False


class TalkAdapter(CommandMixin):
    def __init__(self, chat, account):
        self.chat, self.account, self.loop = chat, account, chat.loop
        o = account.opts
        self.host = (o.get("host") or "").strip()
        self.port = int(o.get("port") or 518)
        self.user = (o.get("user") or "").strip() or _me()
        self.gen = 0
        self._ids = 0
        self.calls = {}                  # tid -> TalkCall
        self._reset()

    def _reset(self):
        self.sock = None
        self.phase = "down"              # down, connecting, hello, up
        self.rbuf = b""
        self.wbuf = b""
        self.home = ""                   # talkd's host name, from its OK
        self.timer = None

    def local_id(self):
        self._ids += 1
        return "%s:%d" % (self.account.id, self._ids)

    def server_conv(self):
        return self.chat.ensure_conv(self.account, "*", "server", self.account.display)

    def system(self, conv, text):
        self.chat.add_message(conv, Message(self.local_id(), conv.id, time.time(),
                                            Contact(""), text, "n"), count=False)

    # -- the control connection ---------------------------------------------
    def connect(self):
        if self.phase != "down":
            return
        if not self.host:
            raise UserError("[account:%s] has no host= (the host running chat-setup's talkd)"
                            % self.account.id)
        self.server_conv()
        self.phase = "connecting"
        gen = self.gen
        self.timer = self.loop.call_later(TALK_TIMEOUT,
                                          lambda: gen == self.gen and self._fail("timed out"))
        self.chat.set_state(self.account, "connecting",
                            "talkd on %s port %d" % (self.host, self.port))
        host, port = self.host, self.port
        self.loop.run_in_thread(
            lambda: socket.getaddrinfo(host, port, socket.AF_INET, socket.SOCK_STREAM),
            lambda res, err: gen == self.gen and self._resolved(res, err))

    def _resolved(self, res, err):
        if err is not None or not res:
            self._fail("cannot look up %s: %s" % (self.host, err))
            return
        family, stype, proto, _, addr = res[0]
        s = socket.socket(family, stype, proto)
        s.setblocking(False)
        rc = s.connect_ex(addr)
        if rc not in (0, errno.EINPROGRESS, errno.EWOULDBLOCK):
            s.close()
            self._fail("cannot connect to %s port %d: %s" % (self.host, self.port, os.strerror(rc)))
            return
        self.sock = s
        self.loop.watch(s, on_write=self._connected)

    def _connected(self):
        err = self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR)
        if err:
            self._fail("cannot connect to talkd on %s port %d: %s (is it set up there? "
                       "chat-setup/scripts/configure-talkd.sh)" % (self.host, self.port,
                                                                   os.strerror(err)))
            return
        self.phase = "hello"
        self.say("HELLO %s" % self.user)

    def say(self, text):
        _log.debug("%s >> %s", self.account.id, text)
        self.wbuf += (text + "\n").encode("utf-8")
        self._rewatch()

    def _rewatch(self):
        if self.sock is not None:
            self.loop.watch(self.sock, on_read=self._on_read,
                            on_write=self._on_write if self.wbuf else None)

    def _on_write(self):
        try:
            n = self.sock.send(self.wbuf)
            self.wbuf = self.wbuf[n:]
        except (BlockingIOError, InterruptedError):
            pass
        except OSError as e:
            self._lost(str(e))
            return
        self._rewatch()

    def _on_read(self):
        gen = self.gen
        try:
            data = self.sock.recv(4096)
        except (BlockingIOError, InterruptedError):
            return
        except OSError as e:
            data, why = b"", str(e)
        else:
            why = "talkd closed the connection"
        if not data:
            self._lost(why)
            return
        self.rbuf += data
        while b"\n" in self.rbuf and gen == self.gen:
            raw, self.rbuf = self.rbuf.split(b"\n", 1)
            text = raw.decode("utf-8", "replace").rstrip("\r")
            _log.debug("%s << %s", self.account.id, text)
            try:
                self._line(text)
            except Exception:
                _log.exception("%s: handling %r failed", self.account.id, text)

    def _line(self, text):
        word, _, rest = text.partition(" ")
        if word == "OK" and self.phase == "hello":
            self.phase = "up"
            self.home = rest.partition("@")[2]
            self.loop.cancel(self.timer)
            self.timer = None
            self.chat.set_state(self.account, "connected", rest)
            self.system(self.server_conv(), "talkd on %s: you are %s" % (self.host, rest))
            return
        if word == "ERR":
            if self.phase == "hello":
                self._fail("talkd: %s" % rest)
            else:
                self.system(self.server_conv(), "talkd: %s" % rest)
            return
        tid, _, arg = rest.partition(" ")
        call = self.calls.get(tid)
        if word == "RING" and arg:
            self._incoming(tid, arg)
        elif word == "STATE" and call is not None:
            self.chat.set_call(call.conv, "ringing" if arg.startswith("ringing") else "calling", arg)
            self.system(call.conv, arg)
        elif word == "CONNECT" and call is not None and arg:
            self._attach(call, arg)
        elif word == "GONE" and call is not None:
            self._ended(call, arg or "gone")

    def disconnect(self):
        for call in list(self.calls.values()):
            if call.data is None and not call.outgoing:
                self.say("DECLINE %s" % call.tid)
            self._ended(call, "you disconnected", tell=True)
        was = self.phase
        self._close()
        if was != "down":
            self.chat.set_state(self.account, "disconnected", "")

    def _close(self):
        self.gen += 1
        self.loop.cancel(self.timer)
        if self.sock is not None:
            try:
                if self.wbuf:            # a last HANGUP / DECLINE, best effort
                    self.sock.setblocking(True)
                    self.sock.settimeout(1)
                    self.sock.sendall(self.wbuf)
            except OSError:
                pass
            _close_sock(self.loop, self.sock)
        self._reset()

    def _fail(self, why):
        self._close()
        self.chat.set_state(self.account, "error", why)

    def _lost(self, why):
        # calls still ringing die with the connection; ones in progress
        # carry on - their bytes go over their own connections
        for call in list(self.calls.values()):
            if call.data is None:
                self._ended(call, "lost talkd: %s" % why)
        self._close()
        self.chat.set_state(self.account, "disconnected", why)

    # -- calls -------------------------------------------------------------
    def peer(self, who):
        """user@host as a conversation names them: just the user when the
        host is talkd's own."""
        user, _, host = who.partition("@")
        if host and host.lower() in (self.home.lower(), self.home.split(".")[0].lower(),
                                     self.host.lower(), "localhost"):
            return user
        return who

    def conv_for(self, who):
        p = self.peer(who)
        return self.chat.ensure_conv(self.account, p.lower(), "direct", p)

    def call_of(self, conv):
        for call in self.calls.values():
            if call.conv is conv and not call.done:
                return call
        return None

    def need_up(self):
        if self.phase != "up":
            raise UserError("%s is not connected" % self.account.display)

    def join(self, target):
        """Call someone: USER, or USER@HOST (another host's own talkd)."""
        self.need_up()
        target = target.strip()
        user, _, host = target.partition("@")
        if not user or len(user) > 12 or any(c.isspace() for c in target):
            raise UserError("not a talk user: %r (USER or USER@HOST)" % target)
        conv = self.conv_for(target)
        call = self.call_of(conv)
        if call is not None:
            if not call.outgoing and call.data is None:
                self.answer(conv)        # they are calling us already
            return conv
        self._ids += 1
        call = TalkCall(conv, "c%d" % self._ids, True)
        self.calls[call.tid] = call
        self.say("CALL %s %s" % (call.tid, target))
        self.chat.set_call(conv, "calling", "calling %s" % target)
        return conv

    def _incoming(self, tid, who):
        conv = self.conv_for(who)
        call = TalkCall(conv, tid, False)
        self.calls[tid] = call
        self.chat.set_call(conv, "incoming", who)
        self.chat.add_message(conv, Message(self.local_id(), conv.id, time.time(),
                                            Contact(who), "%s wants to talk" % who, "n"))

    def answer(self, conv):
        self.need_up()
        call = self.call_of(conv)
        if call is None or call.outgoing or call.data is not None:
            raise UserError("nobody is calling in %s" % conv.title)
        self.say("ACCEPT %s" % call.tid)
        self.chat.set_call(conv, "incoming", "answering")

    def part(self, conv):
        """Hang up (or decline) the call; with none, leave the conversation."""
        if conv.kind == "server":
            raise UserError("the server window cannot be left - disconnect instead")
        call = self.call_of(conv)
        if call is None:
            self.chat.remove_conv(conv)
            return
        if self.phase == "up":
            self.say("%s %s" % ("DECLINE" if not call.outgoing and call.data is None
                                else "HANGUP", call.tid))
        self._ended(call, "you hung up")

    # -- the session ---------------------------------------------------------
    def _attach(self, call, token):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setblocking(False)
        addr = self.sock.getpeername() if self.sock is not None else (self.host, self.port)
        rc = s.connect_ex(addr)
        if rc not in (0, errno.EINPROGRESS, errno.EWOULDBLOCK):
            s.close()
            self._ended(call, "cannot connect to talkd: %s" % os.strerror(rc))
            return
        call.data = s
        call.wbuf = ("ATTACH %s\n" % token).encode("ascii") + TALK_EDIT.encode("latin-1")
        self.chat.set_call(call.conv, "connected", "")
        self.system(call.conv, "connected")
        self._rewatch_data(call)

    def _rewatch_data(self, call):
        if call.data is not None:
            self.loop.watch(call.data, on_read=lambda: self._data_read(call),
                            on_write=(lambda: self._data_write(call)) if call.wbuf else None)

    def _data_write(self, call):
        try:
            n = call.data.send(call.wbuf)
            call.wbuf = call.wbuf[n:]
        except (BlockingIOError, InterruptedError):
            pass
        except OSError as e:
            self._ended(call, "connection lost: %s" % e)
            return
        self._rewatch_data(call)

    def _data_read(self, call):
        try:
            data = call.data.recv(4096)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            data = b""
        if not data:
            self._ended(call, "%s hung up" % call.conv.title)
            return
        if call.edit is None:            # their three edit characters come first
            call.head += data
            if len(call.head) < 3:
                return
            call.edit = call.head[:3].decode("latin-1")
            data, call.head = call.head[3:], b""
        before = call.theirs
        for ch in call.dec.decode(data):
            if ch == "\n" and call.after_cr:
                call.after_cr = False
                continue
            call.after_cr = ch == "\r"
            call.theirs, done = _edit_line(call.theirs, ch, *call.edit)
            if done:
                self.chat.add_message(call.conv, Message(
                    self.local_id(), call.conv.id, time.time(),
                    Contact(call.conv.title), done, ""))
        if call.theirs != before:
            self.chat.typing(call.conv, call.theirs)

    def _ended(self, call, why, tell=False):
        if call.done:
            return
        call.done = True
        if call.theirs:                  # what they had typed still counts
            self.chat.add_message(call.conv, Message(
                self.local_id(), call.conv.id, time.time(), Contact(call.conv.title),
                call.theirs, ""))
            call.theirs = ""
            self.chat.typing(call.conv, "")
        if call.mine:
            self._mine(call.conv, call.mine)
            call.mine = ""
        if tell and call.data is not None and self.phase == "up":
            self.say("HANGUP %s" % call.tid)
        if call.data is not None:
            _close_sock(self.loop, call.data)
            call.data = None
        self.calls.pop(call.tid, None)
        self.chat.set_call(call.conv, "ended", why)
        self.system(call.conv, why)

    def _mine(self, conv, text):
        msgid = self.local_id()
        self.chat.add_message(conv, Message(msgid, conv.id, time.time(), Contact(self.user),
                                            text, "s"), count=False)
        return msgid

    def _session(self, conv):
        if conv.kind == "server":
            raise UserError("the server window takes no messages - call someone (Chat > Join...)")
        call = self.call_of(conv)
        if call is None:
            raise UserError("not talking to %s now - Chat > Join... to call" % conv.title)
        if call.data is None:
            raise UserError("%s has not answered yet" % conv.title if call.outgoing
                            else "%s is calling - answer first" % conv.title)
        return call

    SERVER_TEXT_REFUSAL = "the server window takes no messages - call someone (Chat > Join... or /join USER)"

    def speak(self, conv, text):
        """IRC mode: a whole line.  It goes out with its newline, and is in the
        log at once (talk has no echo)."""
        call = self._session(conv)
        call.wbuf += (text + "\n").encode("utf-8")
        msgid = self._mine(conv, text)
        self._rewatch_data(call)
        return msgid

    # -- the typed commands (see COMMAND_TABLE): talk has calls, not channels --------
    def c_me(self, conv, rest):
        _need(rest, "/me ACTION")
        self._in_a_chat(conv, "/me")
        return (self.speak, (conv, "* %s %s" % (self.user, rest)))

    def c_join(self, conv, rest):
        _need(rest and " " not in rest, "/join USER[@HOST]")
        return (self._call_cmd, (rest,))

    c_query = c_join

    def _call_cmd(self, target):
        self.join(target)

    def c_leave(self, conv, rest):
        if conv.kind == "server":
            raise UserError("the server window cannot be left - /quit disconnects")
        return (self.part, (conv,))

    def c_quit(self, conv, rest):
        return (self.disconnect, ())

    def status_lines(self):
        a = self.account
        lines = ["%s (talk): %s%s" % (a.display, a.state, " - " + a.detail if a.detail else "")]
        if self.phase == "up":
            lines.append("you are %s, through talkd on %s:%d" % (self.user, self.host, self.port))
        live = [c.title + " (" + c.state + ")" for c in a.convs.values() if c.kind != "server" and c.state]
        lines.append("calls: " + (", ".join(live) if live else "none"))
        return lines

    def keys(self, conv, text):
        """Classic: keystrokes as typed - erase (DEL or ^H), kill (^U),
        word-erase (^W) and newlines included.  Sent at once; a finished
        line also goes in the log."""
        call = self._session(conv)
        out = []
        for ch in text:
            if ch == "\x08":
                ch = TALK_EDIT[0]        # talk sees our erase character
            out.append(ch)
            call.mine, done = _edit_line(call.mine, ch, *TALK_EDIT)
            if done:
                self._mine(conv, done)
        call.wbuf += "".join(out).encode("utf-8")
        self._rewatch_data(call)
        return ""


def _close_sock(loop, sock):
    try:
        loop.watch(sock)
    except (OSError, ValueError, KeyError):
        pass
    try:
        sock.close()
    except OSError:
        pass


# --------------------------------------------------------------------------
# Delta Chat invitations by mail.  The core will not write to an address it has
# no key for, and the key comes with an invite link; carrying that link from
# one terminal to another by hand is the painful part.  So `join ADDRESS` mails
# the link (a plain mail with an X-Tvchat-Invite header, over the account's own
# SMTP), and the other tvchat finds it in its INBOX (its own IMAP login, a
# thread: imaplib blocks) and asks the user.  Nothing is accepted by itself: the
# link must name the address it was sent from, and the user says yes.
# --------------------------------------------------------------------------
INVITE_LINK = re.compile(r"(https://i\.delta\.chat/#[^\s<>\"]+|OPENPGP4FPR:[^\s<>\"]+)", re.I)
INVITE_HEADER = "X-Tvchat-Invite"


def invite_names(link):
    """The address a Delta Chat invite link is for (its a= parameter), or ''."""
    m = re.search(r"[&#?]a=([^&\s]*)", link)
    return unquote(m.group(1)) if m else ""


def invite_ok(sender, link):
    """An invitation counts only from the address it names."""
    named = invite_names(link)
    return bool(named) and named.lower() == (sender or "").strip().lower()


def _tls_context(verify):
    ctx = ssl.create_default_context()
    if not verify:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    return ctx


def _imap_open(p):
    """A logged-in imaplib connection from the mail parameters p (a dict)."""
    ctx = _tls_context(p["verify"])
    host, port = p["imap_host"], p["imap_port"]
    for kw in ({"timeout": 20}, {}):                 # timeout= needs Python 3.9
        try:
            if p["imap_security"] == "ssl":
                m = imaplib.IMAP4_SSL(host, port, ssl_context=ctx, **kw)
            else:
                m = imaplib.IMAP4(host, port, **kw)
                if p["imap_security"] == "starttls":
                    m.starttls(ctx)
            break
        except TypeError:
            continue
    m.login(p["imap_user"], p["password"])
    return m


def _text_of(msg):
    if msg.is_multipart():
        return "\n".join(_text_of(part) for part in msg.get_payload())
    payload = msg.get_payload(decode=True)
    return payload.decode(msg.get_content_charset() or "utf-8", "replace") if payload else ""


def scan_invites(p):
    """[(uid, sender, link)] for the invitation mails in the INBOX (a thread)."""
    m = _imap_open(p)
    out = []
    try:
        m.select("INBOX")
        typ, data = m.uid("SEARCH", None, "UNDELETED", "HEADER", INVITE_HEADER, "1")
        for uid in (data[0] or b"").split()[:20]:
            typ, d = m.uid("FETCH", uid, "(BODY.PEEK[])")
            if typ != "OK" or not d or not isinstance(d[0], tuple):
                continue
            msg = email.message_from_bytes(d[0][1])
            sender = email.utils.parseaddr(msg.get("From", ""))[1]
            found = INVITE_LINK.search(_text_of(msg))
            out.append((uid.decode(), sender, found.group(1) if found else ""))
    finally:
        try:
            m.logout()
        except Exception:
            pass
    return out


def delete_mails(p, uids):
    """Remove those mails from the INBOX (a thread)."""
    m = _imap_open(p)
    try:
        m.select("INBOX")
        for uid in uids:
            m.uid("STORE", uid, "+FLAGS", "(\\Deleted)")
        m.expunge()
    finally:
        try:
            m.logout()
        except Exception:
            pass


def send_invite_mail(p, to, link):
    """Mail the invitation (a thread); the reason in the exception if it fails."""
    msg = EmailMessage()
    msg["From"] = p["addr"]
    msg["To"] = to
    msg["Subject"] = "Chat invitation from %s" % p["addr"]
    msg["Date"] = email.utils.formatdate(localtime=True)
    msg["Message-ID"] = email.utils.make_msgid(domain=p["addr"].rpartition("@")[2] or "localhost")
    msg[INVITE_HEADER] = "1"
    msg.set_content(
        "%s invites you to chat, end-to-end encrypted, with Delta Chat.\n\n"
        "In tvchat this shows up as a question (or choose Chat > Accept invite...).\n"
        "In another Delta Chat app, open this link:\n\n%s\n" % (p["addr"], link))
    ctx = _tls_context(p["verify"])
    host, port = p["smtp_host"], p["smtp_port"]
    for kw in ({"timeout": 20}, {}):
        try:
            if p["smtp_security"] == "ssl":
                s_ = smtplib.SMTP_SSL(host, port, context=ctx, **kw)
            else:
                s_ = smtplib.SMTP(host, port, **kw)
            break
        except TypeError:
            continue
    try:
        s_.ehlo()
        if p["smtp_security"] == "starttls":
            s_.starttls(context=ctx)
            s_.ehlo()
        s_.login(p["smtp_user"], p["password"])
        s_.send_message(msg)
    finally:
        try:
            s_.quit()
        except Exception:
            pass


def find_tvmail_backend():
    """tvmail's helper, if tvmail is installed (the link between the two is optional)."""
    found = shutil.which("tvmail-backend")
    if found:
        return found
    for d in ("/usr/local/bin", "~/bin", "~/.local/bin"):
        path = os.path.join(os.path.expanduser(d), "tvmail-backend")
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def mail_through_tvmail(tvmail, to, sender, link):
    """Send the invitation as an ordinary mail through tvmail's own account (a
    thread); the reason in the exception if tvmail refuses."""
    body = ("%s invites you to chat, end-to-end encrypted, with Delta Chat.\n\n"
            "In tvchat: Chat > Join... and paste this link (or, in tvmail, Message > Open\n"
            "chat invite).  In another Delta Chat app, open it:\n\n%s\n" % (sender, link))
    p = subprocess.run([tvmail, "send", "--to", to, "--subject", "Chat invitation from %s" % sender],
                       input=body.encode("utf-8"), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       timeout=90)
    if p.returncode != 0:
        raise RuntimeError((p.stdout.decode("utf-8", "replace").strip() or "tvmail-backend send failed")[:300])


class RpcError(Exception):
    """The Delta Chat core answered a request with an error, or not at all."""


_SYNC = object()                         # a pending request someone is waiting on


def _json_line(raw):
    try:
        msg = json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        return None
    return msg if isinstance(msg, dict) else None


class DeltaChatAdapter(CommandMixin):
    """Delta Chat through the official core: `deltachat-rpc-server` runs as a
    child of the backend and speaks JSON-RPC 2.0, one object per line, on its
    stdin / stdout; the core does the mail, the encryption and its own
    database.  One child (and one accounts directory) per tvchat account.

    Two ways of asking.  The slow calls - the core's first answer, setting up
    the mailbox, and the one long-poll `get_next_event`, which is outstanding
    at all times - are asynchronous, on the shared loop.  Everything the user
    triggers (send, join, history, mark-read) is a local database call that
    takes milliseconds, so it simply waits for its answer in `call()`, with
    other lines held back for the loop; that lets `send` answer the verb with
    the real message id."""

    RETRY_FIRST = 2
    RETRY_MAX = 300
    RETRY_STABLE = 60
    START_TIMEOUT = 30                   # the core's first answer
    SETUP_TIMEOUT = 180                  # autoconfiguration against the mail server
    CALL_TIMEOUT = 10                    # a blocking call to the core
    HISTORY_LOAD = 50                    # messages shown when a chat is opened
    SELF = 1                             # the core's contact id for "me"
    CONNECTED = 3000                     # get_connectivity: working or connected
    INSTALL_HINT = ("install it with `pip install deltachat-rpc-server` or from "
                    "https://github.com/chatmail/core/releases (see INSTALL.md), "
                    "or set rpc_server= in the account")

    def __init__(self, chat, account):
        self.chat, self.account, self.loop = chat, account, chat.loop
        o = account.opts
        self.addr = (o.get("addr") or "").strip()
        self.rpc_server = (o.get("rpc_server") or "deltachat-rpc-server").strip()
        self.gen = 0
        self._ids = 0
        self.attempt = 0
        self.auto = False
        self.retry_timer = None
        self.logf = None
        self.scan_timer = None
        self.invites = {}                # lower-case sender -> {"from", "link", "uids"}
        self.bad_uids = set()            # invitation mails already complained about
        self.done_uids = set()           # ... and the ones answered (a scan in flight may still list them)
        self._reset()

    def _reset(self):
        self.proc = None
        self.rfd = self.wfd = None
        self.phase = "down"              # down, starting, setup, up
        self.rbuf = b""
        self.wbuf = b""
        self.pending = {}                # request id -> callback(result, error) or _SYNC
        self.acct = None                 # the core's id for our account
        self.timer = None
        self.t_up = None
        self.link = None                 # last (state, detail) told for the connectivity
        self.requests = set()            # chat ids that are contact requests

    def local_id(self):
        self._ids += 1
        return "%s:local%d" % (self.account.id, self._ids)

    def server_conv(self):
        return self.chat.ensure_conv(self.account, "*", "server", self.account.display)

    def system(self, conv, text):
        self.chat.add_message(conv, Message(self.local_id(), conv.id, time.time(),
                                            Contact(""), text, "n"), count=False)

    # -- starting and stopping the core ---------------------------------------
    def _find_server(self):
        name = self.rpc_server
        if os.sep in name or (os.altsep and os.altsep in name):
            path = os.path.expanduser(name)
            ok = os.path.isfile(path) and os.access(path, os.X_OK)
        else:
            path = shutil.which(name)
            ok = bool(path)
        if not ok:
            raise UserError("%s not found - %s" % (name, self.INSTALL_HINT))
        return path

    def _dir(self):
        base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
        base = os.path.join(base, "tvchat", "deltachat")
        d = os.path.join(base, self.account.id)
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
            os.chmod(base, 0o700)
            os.chmod(d, 0o700)
        except OSError as e:
            raise UserError("cannot use %s: %s" % (d, e.strerror or e))
        return d

    def connect(self):
        if self.phase != "down":
            return
        if not self.addr:
            raise UserError("[account:%s] has no addr= (the address Delta Chat uses)"
                            % self.account.id)
        path = self._find_server()
        d = self._dir()
        self.server_conv()
        env = dict(os.environ)
        env["DC_ACCOUNTS_PATH"] = d
        if sys.platform == "cygwin" and path.lower().endswith(".exe"):
            try:                         # the Windows build of the core reads Windows paths
                env["DC_ACCOUNTS_PATH"] = subprocess.check_output(
                    ["cygpath", "-w", d]).decode("utf-8", "replace").strip()
            except (OSError, subprocess.CalledProcessError):
                pass
        try:
            self.logf = open(d + ".log", "wb")        # the core's stderr, for a failed start
            self.proc = subprocess.Popen([path], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=self.logf, env=env, bufsize=0,
                                         close_fds=True, start_new_session=True)
        except OSError as e:
            self._close()
            raise UserError("cannot start %s: %s" % (path, e.strerror or e))
        self.rfd, self.wfd = self.proc.stdout.fileno(), self.proc.stdin.fileno()
        os.set_blocking(self.rfd, False)
        os.set_blocking(self.wfd, False)
        self.phase = "starting"
        gen = self.gen
        self.loop.watch(self.rfd, on_read=self._on_read)
        self.timer = self.loop.call_later(
            self.START_TIMEOUT,
            lambda: gen == self.gen and self._fail("the Delta Chat core did not answer"))
        self.chat.set_state(self.account, "connecting", "starting the Delta Chat core")
        self._request("get_system_info", [], self._started)

    def disconnect(self):
        was = self.phase
        retrying = self.retry_timer is not None or self.auto
        self._stop_retrying()
        if was == "up" and self.proc is not None:
            try:                         # let the core finish what it is doing
                self._write({"jsonrpc": "2.0", "method": "stop_io_for_all_accounts",
                             "params": [], "id": 0})
                self._flush_blocking(time.monotonic() + 2)
            except (OSError, RpcError):
                pass
        self._close()
        if was != "down" or retrying:
            self.chat.set_state(self.account, "disconnected", "")

    def _stop_retrying(self):
        self.loop.cancel(self.retry_timer)
        self.retry_timer = None
        self.auto = False
        self.attempt = 0

    def _close(self):
        self.gen += 1
        self.loop.cancel(self.timer)
        self.loop.cancel(self.scan_timer)
        for fd in (self.rfd, self.wfd):
            if fd is not None:
                try:
                    self.loop.watch(fd)
                except (OSError, ValueError, KeyError):
                    pass
        if self.proc is not None:
            for f in (self.proc.stdin, self.proc.stdout):
                try:
                    f.close()
                except OSError:
                    pass
            try:                         # EOF on stdin is how the core is told to go
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
        if self.logf is not None:
            self.logf.close()
            self.logf = None
        self._reset()

    def _core_log(self):
        """What the core last said on stderr (why it would not start)."""
        try:
            with open(self._dir() + ".log", "rb") as fh:
                lines = fh.read().decode("utf-8", "replace").strip().splitlines()
            return lines[-1][:200] if lines else ""
        except (OSError, UserError):
            return ""

    def _exit_reason(self):
        rc = None
        if self.proc is not None:
            try:
                rc = self.proc.wait(1)
            except subprocess.TimeoutExpired:
                pass
        why = "the Delta Chat core exited" + (" (status %s)" % rc if rc is not None else "")
        tail = self._core_log()
        return why + (": " + tail if tail else "")

    def _fail(self, why):
        """A start that did not get through."""
        _log.debug("%s: failed in phase %s: %s", self.account.id, self.phase, why)
        self._close()
        if self.auto:
            self._retry(why)
        else:
            self.chat.set_state(self.account, "error", why)

    def _lost(self, why):
        """The core is gone, or we cannot reach it.  One that was up (or is a
        reconnect) is started again, with backoff; a first start that fell
        over is for the user to retry."""
        _log.debug("%s: lost in phase %s: %s", self.account.id, self.phase, why)
        again = self.phase == "up" or self.auto
        if self.t_up is not None and self.loop.clock() - self.t_up >= self.RETRY_STABLE:
            self.attempt = 0
        self._close()
        if again:
            self._retry(why)
        else:
            self.chat.set_state(self.account, "disconnected", why)

    def _retry(self, why):
        delay = min(self.RETRY_MAX, self.RETRY_FIRST * 2 ** min(self.attempt, 16))
        self.attempt += 1
        self.auto = True
        what = "%s - restarting in %s s" % (why, ("%g" % delay))
        self.system(self.server_conv(), what)
        self.chat.set_state(self.account, "connecting", what)
        self.retry_timer = self.loop.call_later(delay, self._reconnect)

    def _reconnect(self):
        self.retry_timer = None
        if not self.auto or self.phase != "down":
            return
        try:
            self.connect()
        except UserError as e:
            self._stop_retrying()
            self.chat.set_state(self.account, "error", str(e))

    # -- JSON-RPC over the pipes ----------------------------------------------
    def _write(self, obj):
        method = obj.get("method", "")
        _log.debug("%s >> %s%s", self.account.id, method,
                   "" if method == "add_or_update_transport" else " " + json.dumps(obj["params"]))
        self.wbuf += json.dumps(obj).encode("utf-8") + b"\n"
        self._flush()

    def _request(self, method, params, cb):
        self._ids += 1
        rid = self._ids
        self.pending[rid] = cb
        self._write({"jsonrpc": "2.0", "method": method, "params": list(params), "id": rid})
        return rid

    def _flush(self):
        gen = self.gen
        while self.wbuf and self.wfd is not None:
            try:
                n = os.write(self.wfd, self.wbuf)
            except BlockingIOError:
                break
            except OSError:
                self._lost(self._exit_reason())
                return
            self.wbuf = self.wbuf[n:]
        if gen == self.gen and self.wfd is not None:
            self.loop.watch(self.wfd, on_write=self._flush if self.wbuf else None)

    def _flush_blocking(self, deadline):
        gen = self.gen
        while self.wbuf and self.wfd is not None and gen == self.gen:
            self._flush()
            if self.wbuf and gen == self.gen:
                left = deadline - time.monotonic()
                if left <= 0:
                    raise RpcError("the Delta Chat core does not read its input")
                select.select([], [self.wfd], [], left)

    def _on_read(self):
        try:
            data = os.read(self.rfd, 65536)
        except BlockingIOError:
            return
        except OSError:
            data = b""
        if not data:
            self._lost(self._exit_reason())
            return
        self.rbuf += data
        self._process()

    def _process(self):
        gen = self.gen
        while gen == self.gen and b"\n" in self.rbuf:
            raw, _, self.rbuf = self.rbuf.partition(b"\n")
            msg = _json_line(raw)
            if msg is None or "id" not in msg:
                continue
            cb = self.pending.pop(msg["id"], None)
            if cb is None or cb is _SYNC:
                continue                 # not asked for, or the waiter gave up
            err = None
            if msg.get("error"):
                err = RpcError(str((msg["error"] or {}).get("message", msg["error"])))
            try:
                cb(msg.get("result"), err)
            except Exception:
                _log.exception("%s: handler for a core answer failed", self.account.id)

    def call(self, method, *params):
        """Ask the core and wait for the answer (a local call: milliseconds).
        Lines that arrive meanwhile are kept for the loop."""
        if self.proc is None:
            raise RpcError("the Delta Chat core is not running")
        gen = self.gen
        rid = self._request(method, params, _SYNC)
        if gen != self.gen:
            raise RpcError("the Delta Chat core is gone")
        deadline = time.monotonic() + self.CALL_TIMEOUT
        held = []
        try:
            self._flush_blocking(deadline)
            if gen != self.gen:
                raise RpcError("the Delta Chat core is gone")
            while True:
                while b"\n" in self.rbuf:
                    raw, _, self.rbuf = self.rbuf.partition(b"\n")
                    msg = _json_line(raw)
                    if msg is not None and msg.get("id") == rid:
                        if msg.get("error"):
                            raise RpcError("%s: %s" % (method, (msg["error"] or {}).get(
                                "message", msg["error"])))
                        return msg.get("result")
                    held.append(raw)
                left = deadline - time.monotonic()
                if left <= 0:
                    raise RpcError("%s: no answer from the Delta Chat core" % method)
                if select.select([self.rfd], [], [], left)[0]:
                    try:
                        data = os.read(self.rfd, 65536)
                    except BlockingIOError:
                        continue
                    except OSError:
                        data = b""
                    if not data:
                        self._lost(self._exit_reason())
                        raise RpcError("the Delta Chat core exited")
                    self.rbuf += data
        finally:
            if gen == self.gen:
                self.pending.pop(rid, None)
                if held:
                    self.rbuf = b"\n".join(held) + b"\n" + self.rbuf
                    self.loop.call_later(0, lambda: gen == self.gen and self._process())

    # -- setting up -------------------------------------------------------------
    def _started(self, res, err):
        self.loop.cancel(self.timer)
        if err is not None:
            self._fail("the Delta Chat core failed to start: %s" % err)
            return
        _log.debug("%s: core %s", self.account.id, (res or {}).get("deltachat_core_version"))
        self._next_event()
        try:
            ids = self.call("get_all_account_ids")
            self.acct = ids[0] if ids else self.call("add_account")
            if self.call("is_configured", self.acct):
                self._go()
            else:
                self._configure()
        except (RpcError, UserError) as e:
            if self.proc is not None:
                self._fail(str(e))

    def _login(self):
        o = self.account.opts
        host = (o.get("imap_server") or o.get("host") or self.addr.rpartition("@")[2]).strip()
        return host, (o.get("imap_user") or self.addr).strip()

    def _configure(self):
        host, login = self._login()
        pw = find_delta_password(self.account.id, self.addr, host, login)[0]
        if not pw:
            raise UserError("no password for %s: put it in $%s or ~/.netrc (machine %s login %s "
                            "password ..., or login %s)" % (self.addr, _env_name(self.account.id),
                                                           host, login, self.addr))
        o = self.account.opts
        p = {"addr": self.addr, "password": pw}
        for key, name in (("imap_server", "imapServer"), ("smtp_server", "smtpServer"),
                          ("imap_user", "imapUser"), ("smtp_user", "smtpUser")):
            if o.get(key, "").strip():
                p[name] = o[key].strip()
        for key, name in (("imap_port", "imapPort"), ("smtp_port", "smtpPort")):
            if o.get(key, "").strip():
                try:
                    p[name] = int(o[key])
                except ValueError:
                    raise UserError("[account:%s] %s must be a number" % (self.account.id, key))
        if not _bool(o.get("verify"), True):
            p["certificateChecks"] = "acceptInvalidCertificates"
        self.phase = "setup"
        gen = self.gen
        self.timer = self.loop.call_later(
            self.SETUP_TIMEOUT,
            lambda: gen == self.gen and self._fail("setting up %s took too long" % self.addr))
        self.chat.set_state(self.account, "connecting",
                            "setting up %s (the first time takes a minute)" % self.addr)
        self._request("add_or_update_transport", [self.acct, p], self._configured)

    def _configured(self, res, err):
        self.loop.cancel(self.timer)
        if err is not None:
            self._fail("setting up %s failed: %s" % (self.addr, err))
            return
        try:
            self._go()
        except (RpcError, UserError) as e:
            if self.proc is not None:
                self._fail(str(e))

    def _go(self):
        name = (self.account.opts.get("name") or "").strip()
        if name:
            self.call("set_config", self.acct, "displayname", name)
        self.call("start_io", self.acct)
        self.phase = "up"
        self.t_up = self.loop.clock()
        self._load_chats()
        self._connectivity()
        self._watch_invites()

    def _connectivity(self):
        v = self.call("get_connectivity", self.acct)
        now = ("connected", self.addr) if v >= self.CONNECTED else \
            ("connecting", "waiting for the mail server (%s)" % self.addr)
        if now != self.link:
            self.link = now
            self.chat.set_state(self.account, *now)

    # -- the chat list and messages -----------------------------------------------
    def _chat_of(self, cid):
        return self.account.convs.get("%s/%d" % (self.account.id, cid))

    def _conv(self, cid, name, kind, request=False):
        conv = self._chat_of(cid)
        if conv is None:
            conv = self.chat.ensure_conv(self.account, str(cid), kind, name)
            if request:
                self.system(conv, "%s is not in your contacts: a reply accepts the chat" % name)
        elif conv.title != name:
            conv.title = name
        (self.requests.add if request else self.requests.discard)(cid)
        return conv

    def _load_chats(self):
        ids = self.call("get_chatlist_entries", self.acct, 0, None, None)
        items = self.call("get_chatlist_items_by_entries", self.acct, ids)
        for cid in ids:
            it = items.get(str(cid)) or {}
            if it.get("kind") != "ChatListItem" or it.get("isSelfTalk") or it.get("isDeviceTalk"):
                continue
            conv = self._conv(cid, it["name"], "direct" if it["chatType"] == "Single" else "group",
                              it.get("isContactRequest"))
            self.chat.merge_history(conv, self._messages(conv, self._last_ids(cid)))
            self._members(conv)
            fresh = it.get("freshMessageCounter", 0)
            if conv.unread != fresh:
                conv.unread = fresh
                self.chat.events.push("unread", conv.id, fresh)

    def _last_ids(self, cid, before=None):
        ids = self.call("get_message_ids", self.acct, cid, False, False)
        if before is not None:
            ids = [i for i in ids if i < before]
        return ids[-self.HISTORY_LOAD:]

    def _messages(self, conv, ids):
        if not ids:
            return []
        got = self.call("get_messages", self.acct, ids)
        return [self._to_message(conv, got[str(i)]) for i in ids
                if (got.get(str(i)) or {}).get("kind") == "message"]

    def _to_message(self, conv, m):
        mine = m["fromId"] == self.SELF
        flags = ("s" if mine else "") + ("n" if m.get("isInfo") else "") \
            + ("e" if m.get("showPadlock") else "") + ("r" if mine or m.get("state") == 16 else "")
        text = m.get("text") or ""
        if m.get("viewType") not in (None, "Text", "Unknown") or m.get("file"):
            what = "[attachment: %s]" % (m.get("fileName") or m.get("viewType") or "file")
            text = what + (" " + text if text else "")
        who = m.get("sender") or {}
        sender = Contact(who.get("address") or "", who.get("displayName") or None)
        if m.get("isInfo"):
            sender = Contact("")
        return Message("%s:%d" % (self.account.id, m["id"]), conv.id,
                       m.get("sortTimestamp") or m.get("timestamp") or time.time(),
                       sender, text, flags)

    @staticmethod
    def _core_id(msg):
        tail = msg.id.rpartition(":")[2]
        return int(tail) if tail.isdigit() else None

    def _members(self, conv):
        if conv.kind != "group":
            return
        conv.members = {}
        for c in self.call("get_chat_contacts", self.acct, int(conv.target)):
            if c != self.SELF:
                ct = self.call("get_contact", self.acct, c)
                conv.members[ct["address"].lower()] = (ct["address"], ct["displayName"], "member")
        self.chat.events.push("members", conv.id)

    def fetch_history(self, conv, kind):
        """Older messages from the core's database, past the in-memory ring:
        True when there are some (a 'history CONV before' event follows)."""
        if kind != "before" or conv.kind == "server" or self.phase != "up":
            return False
        have = [i for i in (self._core_id(m) for m in conv.history) if i is not None]
        try:
            msgs = self._messages(conv, self._last_ids(int(conv.target),
                                                       min(have) if have else None))
        except RpcError:
            return False
        if not msgs or not self.chat.merge_history(conv, msgs):
            conv.history_done = True
            return False
        self.chat.events.push("history", conv.id, "before")
        return True

    # -- events ---------------------------------------------------------------------
    def _next_event(self):
        self._request("get_next_event", [], self._on_event)

    def _on_event(self, res, err):
        gen = self.gen
        if err is not None:
            self._lost("the Delta Chat core failed: %s" % err)
            return
        try:
            self._event(res["contextId"], res["event"])
        except (RpcError, KeyError, TypeError, ValueError):
            if gen == self.gen:
                _log.exception("%s: event %r failed", self.account.id, res)
        if gen == self.gen:
            self._next_event()

    def _event(self, ctx, ev):
        kind = ev.get("kind")
        _log.debug("%s << event %s", self.account.id, json.dumps(ev))
        if self.acct is not None and ctx != self.acct:
            return
        if kind == "ConfigureProgress" and self.phase == "setup":
            self.chat.set_state(self.account, "connecting", "setting up %s: %d%%" %
                                (self.addr, ev.get("progress", 0) // 10))
        elif kind == "Error" and ev.get("msg"):
            self.system(self.server_conv(), "error: %s" % ev["msg"])
        if self.phase != "up":
            return
        cid = ev.get("chatId", ev.get("chat_id"))
        if kind in ("IncomingMsg", "MsgsChanged") and cid and ev.get("msgId"):
            self._arrived(cid, ev["msgId"], kind == "IncomingMsg")
        elif kind == "MsgFailed" and cid:
            conv = self._chat_of(cid)
            if conv is not None:
                m = self.call("get_message", self.acct, ev["msgId"])
                self.system(conv, "not delivered: %s" % (m.get("error") or "the mail server refused it"))
        elif kind == "ChatModified" and cid:
            info = self.call("get_basic_chat_info", self.acct, cid)
            if self._chat_of(cid) is not None or not self._skip(info):
                conv = self._conv(cid, info["name"], "direct" if info["chatType"] == "Single"
                                  else "group", info.get("isContactRequest"))
                self._members(conv)
        elif kind == "ChatDeleted" and cid:
            conv = self._chat_of(cid)
            if conv is not None:
                self.chat.remove_conv(conv)
        elif kind == "MsgsNoticed" and cid:
            conv = self._chat_of(cid)
            if conv is not None and conv.unread:
                self.chat.mark_read(conv, hook=False)
        elif kind in ("ConnectivityChanged", "ImapConnected", "SmtpConnected"):
            self._connectivity()

    @staticmethod
    def _skip(info):
        return info.get("isSelfTalk") or info.get("isDeviceChat")

    def _arrived(self, cid, mid, incoming):
        """A message the core has stored: new to us unless already shown (our
        own sends are, and IncomingMsg is followed by MsgsChanged)."""
        msgid = "%s:%d" % (self.account.id, mid)
        conv = self._chat_of(cid)
        if conv is not None and any(m.id == msgid for m in conv.history):
            return
        if conv is None:
            info = self.call("get_basic_chat_info", self.acct, cid)
            if self._skip(info):
                return
            conv = self._conv(cid, info["name"], "direct" if info["chatType"] == "Single"
                              else "group", info.get("isContactRequest"))
            self._members(conv)
        msg = self._to_message(conv, self.call("get_message", self.acct, mid))
        self.chat.add_message(conv, msg, count="s" not in msg.flags and incoming)

    # -- what the user does -----------------------------------------------------------
    def _need_up(self):
        if self.phase != "up":
            raise UserError("%s is not connected - Chat > Connect first" % self.account.display)

    INVITE = re.compile(r"^(https://i\.delta\.chat/|OPENPGP4FPR:)", re.I)

    def invite(self):
        """Our invite link (SecureJoin): whoever opens it with `join` gets
        a key exchange with us, after which both can write."""
        self._need_up()
        try:
            return self.call("get_chat_securejoin_qr_code", self.acct, None)
        except RpcError as e:
            raise UserError(str(e))

    def join(self, target):
        """Start (or find) the chat with an email address, or join someone's
        invite link (the key exchange runs in the background; its progress
        shows in the chat)."""
        self._need_up()
        addr = target.strip()
        if self.INVITE.match(addr):
            try:
                chat_id = self.call("secure_join", self.acct, addr)
                info = self.call("get_basic_chat_info", self.acct, chat_id)
                conv = self._conv(chat_id, info["name"], "direct" if info["chatType"] == "Single"
                                  else "group")
                self.chat.merge_history(conv, self._messages(conv, self._last_ids(chat_id)))
            except RpcError as e:
                raise UserError(str(e))
            return conv
        if not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", addr):
            raise UserError("a Delta Chat chat is started with an email address (%r is not one)"
                            % target)
        try:
            cid = self.call("lookup_contact_id_by_addr", self.acct, addr)
            if cid is None:
                cid = self.call("create_contact", self.acct, addr, None)
            if not self.call("get_contact", self.acct, cid).get("isKeyContact", True):
                return self._invite_by_mail(addr)    # no key yet: ask them by mail
            chat_id = self.call("create_chat_by_contact_id", self.acct, cid)
            info = self.call("get_basic_chat_info", self.acct, chat_id)
            conv = self._conv(chat_id, info["name"], "direct")
            self.chat.merge_history(conv, self._messages(conv, self._last_ids(chat_id)))
        except RpcError as e:
            raise UserError(str(e))
        return conv

    # -- invitations by mail ------------------------------------------------------
    def _mail_params(self):
        """What the mail threads need, from the account's settings: the IMAP and
        SMTP server, port, security and login, and the password."""
        o = self.account.opts

        def num(key, default):
            try:
                return int(o.get(key) or default)
            except ValueError:
                raise UserError("[account:%s] %s must be a number" % (self.account.id, key))
        host, login = self._login()
        pw = find_delta_password(self.account.id, self.addr, host, login)[0]
        if not pw:
            raise UserError("no password for %s (see the error when connecting)" % self.addr)
        imap_port = num("imap_port", 993)
        smtp_port = num("smtp_port", 587)
        smtp_user = (o.get("smtp_user") or login).strip()
        return {
            "addr": self.addr, "password": pw, "verify": _bool(o.get("verify"), True),
            "imap_host": host, "imap_port": imap_port, "imap_user": login,
            "imap_security": (o.get("imap_security") or ("ssl" if imap_port == 993 else "starttls")).strip(),
            "smtp_host": (o.get("smtp_server") or host).strip(), "smtp_port": smtp_port,
            "smtp_user": smtp_user,
            "smtp_security": (o.get("smtp_security") or ("ssl" if smtp_port == 465 else "starttls")).strip(),
        }

    def _invite_by_mail(self, addr):
        """No key for addr yet: mail them our invite link.  Returns the server
        conversation, where the progress is told; their chat appears by itself
        once they accept."""
        conv = self.server_conv()
        link = self.invite()
        try:
            p = self._mail_params()
        except UserError as e:
            raise UserError("%s - or give them this link: %s" % (e, link))
        self.system(conv, "inviting %s by mail..." % addr)
        gen = self.gen

        def done(res, err):
            if gen != self.gen:
                return
            if err is not None:
                self.system(conv, "could not mail the invitation to %s: %s - give them this link "
                                  "instead (they use Chat > Join...): %s" % (addr, err, link))
            else:
                self.system(conv, "invitation mailed to %s - the chat opens here when they accept" % addr)
        self.loop.run_in_thread(lambda: send_invite_mail(p, addr, link), done)
        return conv

    def invite_mail(self, addr):
        """Mail our invitation link to addr through tvmail (its account, its SMTP) -
        optional: only when tvmail is installed.  The result is told in the server
        window."""
        self._need_up()
        addr = addr.strip()
        if not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$", addr):
            raise UserError("%r is not an email address" % addr)
        tvmail = find_tvmail_backend()
        if tvmail is None:
            raise UserError("tvmail is not installed (it would send the mail)")
        link = self.invite()
        conv = self.server_conv()
        self.system(conv, "mailing the invitation to %s through tvmail..." % addr)
        gen = self.gen

        def done(res, err):
            if gen != self.gen:
                return
            if err is not None:
                self.system(conv, "tvmail could not send the invitation to %s: %s" % (addr, err))
            else:
                self.system(conv, "invitation mailed to %s through tvmail" % addr)
        self.loop.run_in_thread(lambda: mail_through_tvmail(tvmail, addr, self.addr, link), done)

    def _watch_invites(self):
        gen = self.gen
        if self.phase != "up":
            return
        try:
            p = self._mail_params()
        except UserError as e:
            _log.debug("%s: not looking for invitations: %s", self.account.id, e)
            self.scan_timer = self.loop.call_later(self.INVITE_POLL * 10, self._watch_invites)
            return
        self.loop.run_in_thread(lambda: scan_invites(p),
                                lambda res, err: gen == self.gen and self._scanned(res, err))

    INVITE_POLL = 30

    def _scanned(self, res, err):
        if err is not None:
            _log.debug("%s: looking for invitations failed: %s", self.account.id, err)
        for uid, sender, link in res or []:
            if uid in self.done_uids:
                continue
            key = sender.lower()
            if not link or not invite_ok(sender, link):
                if uid not in self.bad_uids:
                    self.bad_uids.add(uid)
                    self.system(self.server_conv(), "ignored a chat invitation from %s: its link is "
                                "not for that address" % (sender or "?"))
                continue
            inv = self.invites.get(key)
            if inv is None or inv["link"] != link:
                self.invites[key] = inv = {"from": sender, "link": link, "uids": []}
                self.system(self.server_conv(), "%s invites you to chat - Chat > Accept invite..." % sender)
                self.chat.events.push("invite", self.account.id, sender)
            if uid not in inv["uids"]:
                inv["uids"].append(uid)
        self.scan_timer = self.loop.call_later(self.INVITE_POLL, self._watch_invites)

    def add_invite(self, link):
        """An invitation that came another way (tvmail found the link in a mail
        and dropped it in the requests directory): it is offered like the
        others, from the address the link names."""
        sender = invite_names(link)
        if not sender:
            raise UserError("that invite link names no address")
        inv = self.invites.get(sender.lower())
        if inv is None or inv["link"] != link:
            self.invites[sender.lower()] = {"from": sender, "link": link, "uids": []}
            self.system(self.server_conv(), "%s invites you to chat - Chat > Accept invite..." % sender)
            self.chat.events.push("invite", self.account.id, sender)

    def pending_invites(self):
        return [inv["from"] for inv in self.invites.values()]

    def _invite_of(self, sender):
        inv = self.invites.get((sender or "").strip().lower())
        if inv is None:
            raise UserError("no invitation from %s" % sender)
        return inv

    def accept_invite(self, sender):
        inv = self._invite_of(sender)
        conv = self.join(inv["link"])
        self._drop_invite(inv)
        return conv

    def decline_invite(self, sender):
        self._drop_invite(self._invite_of(sender))

    def _drop_invite(self, inv):
        self.invites.pop(inv["from"].lower(), None)
        self.done_uids.update(inv["uids"])
        try:
            p = self._mail_params()
        except UserError:
            return
        self.loop.run_in_thread(lambda: delete_mails(p, list(inv["uids"])),
                                lambda res, err: err is None or _log.debug(
                                    "%s: removing the invitation mail failed: %s", self.account.id, err))

    def part(self, conv):
        """Chat > Leave: a group is left (the others are told), then the chat
        and its messages are deleted from this device.  The UI has asked first."""
        self._need_up()
        if conv.kind == "server":
            raise UserError("the server window cannot be left")
        cid = int(conv.target)
        try:
            if conv.kind == "group":
                try:
                    self.call("leave_group", self.acct, cid)
                except RpcError as e:        # already out of it: carry on and delete
                    _log.debug("%s: leave_group: %s", self.account.id, e)
            self.call("delete_chat", self.acct, cid)
        except RpcError as e:
            raise UserError(str(e))
        self.requests.discard(cid)
        self.chat.remove_conv(conv)

    SERVER_TEXT_REFUSAL = "the server window takes no messages - start a chat (Chat > Join... or /join ADDRESS)"

    def need_up(self):
        self._need_up()

    def speak(self, conv, text):
        if not text.strip():
            raise UserError("nothing to send")
        cid = int(conv.target)
        try:
            if cid in self.requests:
                self.call("accept_chat", self.acct, cid)
                self.requests.discard(cid)
            mid = self.call("misc_send_text_message", self.acct, cid, text)
            msg = self._to_message(conv, self.call("get_message", self.acct, mid))
        except RpcError as e:
            if "e2e encryption unavailable" in str(e):
                raise UserError("no encryption key for %s yet: exchange an invite first "
                                "(one side runs `tvchat-backend invite %s`, the other joins "
                                "that link)" % (conv.title, self.account.id))
            raise UserError(str(e))
        self.chat.add_message(conv, msg, count=False)
        return msg.id

    # -- the typed commands (see COMMAND_TABLE) -------------------------------------
    def _my_name(self):
        try:
            name = self.call("get_config", self.acct, "displayname")
        except RpcError:
            name = None
        return name or self.addr.partition("@")[0] or "me"

    def c_me(self, conv, rest):
        _need(rest, "/me ACTION")
        self._in_a_chat(conv, "/me")
        return (self.speak, (conv, "* %s %s" % (self._my_name(), rest)))

    def c_join(self, conv, rest):
        _need(rest and " " not in rest, "/join ADDRESS | INVITE-LINK")
        return (self._join_cmd, (rest,))

    def _join_cmd(self, target, said=""):
        """Start (or find) the chat, and say `said` in it if a chat was opened
        (a first chat with someone only mails them an invitation)."""
        conv = self.join(target)
        if said and conv.kind != "server":
            return self.speak(conv, said)
        if said:
            self.system(conv, "not sent (no key for %s yet): %s" % (target, said))
        return None

    def c_query(self, conv, rest):
        addr, _, said = rest.partition(" ")
        _need(addr, "/query ADDRESS [TEXT]")
        return (self._join_cmd, (addr, said.strip()))

    def c_msg(self, conv, rest):
        addr, _, said = rest.partition(" ")
        _need(addr and said.strip(), "/msg ADDRESS TEXT")
        return (self._join_cmd, (addr, said.strip()))

    def c_leave(self, conv, rest):
        if conv.kind == "server":
            raise UserError("the server window cannot be left - /quit disconnects")
        return (self.part, (conv,))

    def c_nick(self, conv, rest):
        _need(rest, "/nick NAME")
        return (self._nick_cmd, (conv, rest))

    def _nick_cmd(self, conv, name):
        try:
            self.call("set_config", self.acct, "displayname", name)
        except RpcError as e:
            raise UserError(str(e))
        self.system(conv, "you are now %s" % name)

    def c_invite(self, conv, rest):
        _need(rest and " " not in rest, "/invite ADDRESS")
        if conv.kind == "group":
            return (self.group_add, (conv, rest))
        return (self._join_cmd, (rest,))

    def c_name(self, conv, rest):
        _need(rest, "/name NEW NAME")
        if conv.kind != "group":
            raise UserError("/name renames a group; this is not one")
        return (self.group_rename, (conv, rest))

    def c_names(self, conv, rest):
        return (self._notes, (conv, self._names_lines(conv)))

    def _names_lines(self, conv):
        if conv.kind == "server":
            return ["no list of names in the server window"]
        if conv.kind == "group":
            people = sorted(conv.members.values(), key=lambda e: e[1].lower())
            return ["%d here besides you: %s" % (len(people), ", ".join(
                "%s <%s>" % (d, a) if d and d != a else a for a, d, _r in people) or "nobody")]
        try:
            ids = self.call("get_chat_contacts", self.acct, int(conv.target))
            who = [self.call("get_contact", self.acct, c) for c in ids if c != self.SELF]
        except RpcError as e:
            raise UserError(str(e))
        return ["you and " + ", ".join("%s <%s>" % (c["displayName"], c["address"]) for c in who)]

    def c_whois(self, conv, rest):
        _need(rest and " " not in rest, "/whois ADDRESS")
        return (self._whois_cmd, (conv, rest))

    def _whois_cmd(self, conv, addr):
        try:
            cid = self._key_contact(addr)
            if cid is None:
                lines = ["%s: no key for them yet - /join %s invites them" % (addr, addr)]
            else:
                c = self.call("get_contact", self.acct, cid)
                lines = ["%s <%s>" % (c.get("displayName") or addr, c["address"]),
                         "    end-to-end encrypted with a key we hold" if c.get("isKeyContact", True)
                         else "    no key held"]
                if c.get("status"):
                    lines.append("    status: " + c["status"])
                if c.get("lastSeen"):
                    lines.append("    last seen " + time.strftime("%Y-%m-%d %H:%M", time.localtime(c["lastSeen"])))
        except RpcError as e:
            raise UserError(str(e))
        self._notes(conv, lines)

    def c_quit(self, conv, rest):
        return (self.disconnect, ())

    def status_lines(self):
        a = self.account
        lines = ["%s (Delta Chat): %s%s" % (a.display, a.state, " - " + a.detail if a.detail else ""),
                 "mailbox %s" % self.addr]
        if self.phase == "up":
            host, login = self._login()
            lines.append("mail server %s (login %s), up %s" % (
                host, login, _dur(self.loop.clock() - self.t_up) if self.t_up else "?"))
        lines.append(self.counts())
        if self.invites:
            lines.append("invitations waiting: " + ", ".join(i["from"] for i in self.invites.values()))
        return lines

    # -- groups -------------------------------------------------------------------
    ADDRESS = re.compile(r"^[^@\s,]+@[^@\s,]+\.[^@\s,]+$")

    def _key_contact(self, addr):
        """The core's id for the key-contact with this address, or None: only a
        person we hold a key for can be put in an encrypted group."""
        for c in self.call("get_contacts", self.acct, 0, addr):
            if (c.get("address") or "").lower() == addr.lower():
                return c["id"]
        return None

    def _members_for(self, chat_id, addrs):
        """Add each address to the group; those with no key yet are invited by
        mail instead.  Returns (added, invited)."""
        added, invited = [], []
        for addr in addrs:
            cid = self._key_contact(addr)
            if cid is None:
                invited.append(addr)
                continue
            self.call("add_contact_to_chat", self.acct, chat_id, cid)
            added.append(addr)
        return added, invited

    def _check_addresses(self, addrs):
        for a in addrs:
            if not self.ADDRESS.match(a):
                raise UserError("%r is not an email address" % a)

    def new_group(self, name, addrs):
        """A new encrypted group.  It reaches the other members with the first
        message sent to it; people we hold no key for are invited by mail and can
        be added once they have accepted."""
        self._need_up()
        name = (name or "").strip()
        if not name:
            raise UserError("a group needs a name")
        addrs = [a.strip() for a in addrs if a.strip()]
        self._check_addresses(addrs)
        try:
            chat_id = self.call("create_group_chat", self.acct, name, False)
            added, invited = self._members_for(chat_id, addrs)
            conv = self._conv(chat_id, name, "group")
            self._members(conv)
        except RpcError as e:
            raise UserError(str(e))
        self.system(conv, "group created: it reaches the members with the first message you send"
                          + ("" if not added else " (%s)" % ", ".join(added)))
        for addr in invited:
            try:
                self._invite_by_mail(addr)
            except UserError as e:           # the group stays; say what could not be done
                self.system(conv, "%s has no key yet and could not be invited: %s" % (addr, e))
                continue
            self.system(conv, "%s has no key yet: invited by mail - add them (Chat > Add member) "
                              "once they have accepted" % addr)
        return conv

    def _group(self, conv):
        self._need_up()
        if conv.kind != "group":
            raise UserError("%s is not a group" % conv.title)
        return int(conv.target)

    def group_add(self, conv, addr):
        chat_id = self._group(conv)
        addr = addr.strip()
        self._check_addresses([addr])
        try:
            added, invited = self._members_for(chat_id, [addr])
            self._members(conv)
        except RpcError as e:
            raise UserError(str(e))
        if invited:
            try:
                self._invite_by_mail(addr)
            except UserError as e:
                raise UserError("%s has no key yet and could not be invited: %s" % (addr, e))
            raise UserError("%s has no key yet: invited by mail - add them once they have accepted" % addr)
        self.system(conv, "added %s" % addr)

    def group_remove(self, conv, addr):
        chat_id = self._group(conv)
        try:
            cid = self._key_contact(addr.strip())
            if cid is None or addr.strip().lower() not in conv.members:
                raise UserError("%s is not in this group" % addr)
            self.call("remove_contact_from_chat", self.acct, chat_id, cid)
            self._members(conv)
        except RpcError as e:
            raise UserError(str(e))
        self.system(conv, "removed %s" % addr)

    def group_rename(self, conv, name):
        chat_id = self._group(conv)
        name = (name or "").strip()
        if not name:
            raise UserError("a group needs a name")
        try:
            self.call("set_chat_name", self.acct, chat_id, name)
        except RpcError as e:
            raise UserError(str(e))
        conv.title = name
        self.chat.events.push("conv-new", *conv.fields())    # the lists re-read the title

    def marked_read(self, conv, msgid):
        """The chat was read here: tell the core (it sends read receipts, if
        the user's settings say so)."""
        if self.phase != "up" or conv.kind == "server":
            return
        ids = []
        for m in conv.history:
            if "r" not in m.flags and self._core_id(m) is not None:
                ids.append(self._core_id(m))
            if msgid is not None and m.id == msgid:
                break
        try:
            self.call("marknoticed_chat", self.acct, int(conv.target))
            if ids:
                self.call("markseen_msgs", self.acct, ids)
        except RpcError as e:
            _log.debug("%s: marking read failed: %s", self.account.id, e)


# --------------------------------------------------------------------------
# Floyd: a robot to talk to, after Infocom's Planetfall.  No network and no
# server - the "protocol" is a small keyword-driven personality (FloydMind)
# behind the same adapter interface as the real ones, so he shows up as an
# account with a conversation of his own, answers after a typing pause, and
# now and then starts talking by himself.  Floyd speaks of himself in the
# third person, is delighted by everything, and is a terrible hider.
# --------------------------------------------------------------------------
class FloydMemory(object):
    """What Floyd remembers between sessions, like an Eggdrop's user file: who
    was last seen saying what, messages left for people (!tell), karma, quotes,
    learned facts, and the conversations he is attached to.  One small JSON
    file; path None keeps it in memory only.  Each list is capped."""

    CAPS = {"seen": 2000, "tells": 200, "quotes": 500, "facts": 1000, "karma": 2000}

    def __init__(self, path=None):
        self.path = path
        self.data = {"seen": {}, "tells": [], "karma": {}, "quotes": [], "facts": {},
                     "attached": [], "levels": {}}
        if path:
            try:
                with open(path, encoding="utf-8") as fh:
                    stored = json.load(fh)
                for k, v in self.data.items():
                    if isinstance(stored.get(k), type(v)):
                        self.data[k] = stored[k]
            except (OSError, ValueError, AttributeError):
                pass

    def save(self):
        if not self.path:
            return
        d = self.data
        for k, cap in self.CAPS.items():
            if len(d[k]) > cap:
                if isinstance(d[k], list):
                    d[k] = d[k][-cap:]
                else:                    # a dict: drop the oldest-inserted
                    for old in list(d[k])[:len(d[k]) - cap]:
                        del d[k][old]
        try:
            os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
            tmp = self.path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(d, fh)
            os.replace(tmp, self.path)
        except OSError as e:
            _log.debug("floyd: cannot save %s: %s", self.path, e)

    def seen_set(self, who, when, where, text):
        self.data["seen"].pop(who, None)         # keep the newest last
        self.data["seen"][who] = [when, where, text]
        self.save()

    def add_tell(self, to, frm, text, when):
        self.data["tells"].append({"to": to, "from": frm, "text": text, "ts": when})
        self.save()

    def take_tells(self, to):
        mine = [t for t in self.data["tells"] if t["to"] == to]
        if mine:
            self.data["tells"] = [t for t in self.data["tells"] if t["to"] != to]
            self.save()
        return mine

    def karma_add(self, thing, delta):
        k = self.data["karma"]
        k[thing] = k.get(thing, 0) + delta
        self.save()
        return k[thing]


