# tvchat configuration - read by tvchat-backend.
#
# Copy to  ~/.config/tvchat/tvchat.conf  and edit.  $TVCHAT_CONF points one
# run at another file.  No file at all simply means no chat accounts.
#
# NO PASSWORDS HERE.  They are looked up for the SASL login, first match wins:
#   $TVCHAT_PASS_<ACCOUNT>   e.g. $TVCHAT_PASS_LIBERA for [account:libera]
#   ~/.mu-tickets            irc://yournick:PASS@irc.libera.chat
#   ~/.netrc  (chmod 600)    machine irc.libera.chat login yournick password PASS
# The values below are placeholders - pick your own nick, channel and address.

[chat]
# connect these accounts when tvchat starts (comma-separated section names)
autoconnect = libera

# The terminal while tvchat runs (read by tvchat itself).
[ui]
# n (the default): no talk(1) requests or write / wall messages from ordinary
#   users land on top of the window - the terminal's group-write bit is
#   cleared, as `mesg n` does, and put back on exit.  Root's messages still
#   get through: Ctrl-L (Window > Redraw screen) clears them off the screen.
# y: leave the terminal as it is.
#mesg = n
# A toast announces a new message in a conversation you are not looking at, or
# in the one shown after you have touched no key for idle SECONDS (default 60,
# 0 = only the first kind).
#idle = 60
# beep = y: also send a BEL with the toast (a terminal beeps or flashes its
#   window).  Default n.
#beep = n

# One section per account, [account:NAME].  NAME is the account's id in the
# UI and in conversation ids, so no '/', '\' or spaces in it.
#   protocol = irc | deltachat      (required)
#   display  = shown in titles      (default: NAME)

[account:libera]
protocol = irc
display  = Libera
host     = irc.libera.chat
port     = 6697
tls      = true
# verify the server certificate (default true); for a LAN server with a
# self-signed cert, point cafile at its .pem instead of turning this off
verify   = true
#cafile  = /etc/ssl/certs/my-ircd.pem   (or ~/.config/tvchat/my-ircd.pem)
nick     = yournick
realname = Your Name
# SASL account name (a nick registered with NickServ); leave it out to
# connect unauthenticated.  The password comes from one of the places above.
sasl     = yournick
# joined on every connect, comma-separated
channels = #tvmail-test
# plain-text port 6667 only if you mean it:  tls = false  (port follows)

[account:talk]
# talk(1) through chat-setup's talkd on the LAN master (one talkd for the
# LAN; chrispollitt/POSIX chat-setup/scripts/configure-talkd.sh sets it up).
# No password: talk has none, so talkd answers the LAN only.
protocol  = talk
display   = cpbee talk
host      = cpbee
# port   = 518
# your user name there (default: your login name here)
#user    = yourname
# how a talk conversation starts: classic (talk's split screen, every
# keystroke sent) or irc (the log, whole lines, "... is typing")
talk_view = classic

# Floyd, the robot from Infocom's Planetfall.  He now lives on the LAN master as
# a bot with his own IRC nick (configure/floyd.conf.example, INSTALL.md): talk to
# Floyd there.  To run him inside this session anyway, add local = yes and remove
# the leading # from these lines to have him in the Servers list.
#[account:floyd]
#protocol = floyd
#local    = yes
# off | minimal | helpful | chatty | clippy - how much he does (see floyd.conf.example)
#level    = chatty
#display  = Floyd
# what Floyd calls you (default: your login name)
#nick     = yourname
# seconds of quiet before Floyd speaks up by himself (default 180, 0 = never)
#idle     = 180
# conversations he is attached to every time (comma-separated conversation ids,
# ACCOUNT/target in lower case, * matches); /floyd on|off does it from the chat
#attach   = libera/#tvmail-test
# he speaks as you in those, behind this tag (default "[Floyd] ")
#tag      = [Floyd]
# what he remembers (seen, tells, karma, quotes, facts); "none" keeps nothing
#memory   = ~/.local/share/tvchat/floyd/floyd.json

[account:delta]
protocol = deltachat
display  = Delta Chat
# a DEDICATED address: Delta Chat moves (and may delete) chat mail on the
# server, which would confuse tvmail's view of an everyday inbox
addr     = chat@example.org
# The password comes from the same places as IRC's ($TVCHAT_PASS_DELTA, then
# ~/.mu-tickets, then ~/.netrc) and is needed only for the first connect:
#   machine mail.example.org  login chat@example.org  password ...
# (the machine is the address's domain, or imap_server when you set it)
# The official core, found on PATH by default (see INSTALL.md); a full path works
rpc_server = deltachat-rpc-server
# your name as the people you write to see it (set on every connect)
#name     = Your Name
# only if autoconfiguration cannot work the mailbox out
#imap_server = mail.example.org
#imap_port   = 993
#smtp_server = mail.example.org
#smtp_port   = 465
# a server with a self-signed certificate
#verify   = false
