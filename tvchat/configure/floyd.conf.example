# The central Floyd: configuration for `tvchat-backend floyd-daemon`.
#
# On the LAN master (cpbee), chrispollitt/POSIX chat-setup/scripts/configure-floyd.sh
# writes this to /etc/tvchat/floyd.conf (with his nick, the account and the admins
# filled in), installs configure/tvchat-floyd.service and starts it.  Or copy it there
# and edit it yourself.  It is an ordinary tvchat.conf: an IRC
# account (Floyd's own nick, logged in to services) and a protocol = floyd
# account that listens through it.
#
# NO PASSWORDS HERE.  Floyd's NickServ password goes in /etc/tvchat/floyd.env
# (chmod 600) as
#   TVCHAT_PASS_CPBEE=...
# or in the service user's ~/.netrc:  machine cpbee  login Floyd  password ...
# configure-floyd.sh registers the nick and writes that file.

[account:cpbee]
protocol = irc
display  = cpbee
host     = cpbee
port     = 6697
tls      = true
cafile   = /opt/ergo/ca.pem
nick     = Floyd
realname = Floyd, B-19-7 (a robot)
# his services account; the password is looked up as above
sasl     = Floyd
# joined on every start; anyone can also /invite him (he joins at once) or /msg him
channels = #test


# Delta Chat (optional): Floyd's own mailbox, so people can /invite floyd@HOST from
# a Delta Chat account.  He reads his INBOX for invitations every 30 s and accepts
# every one (as on IRC), then answers in the chat like anywhere else.  Needs
# deltachat-rpc-server (pip install deltachat-rpc-server, as the service user), his
# mailbox password in floyd.env as TVCHAT_PASS_DELTA (this account's name, upper
# case), and the account in attach = below.  Uncomment and adjust:
#[account:delta]
#protocol    = deltachat
#display     = Delta Chat
#addr        = floyd@cpbee.cmnet
# only when autoconfiguration cannot work it out (the master's own mail server):
#imap_server = localhost
#imap_user   = floyd
#smtp_server = localhost
#smtp_user   = floyd
#smtp_port   = 587
#verify      = false


# Mail (optional): people can also EMAIL him, and he answers in an email (a reply in
# the same thread, one mail per question).  He reads his INBOX every 30 s, answers
# what is for him as in any chat (!commands, "floyd: ...", plain questions), skips
# robots (Auto-Submitted, bulk, lists, noreply, bounces) and answers one address at
# most 5 times an hour (60 in all).  A From line proves nothing, so a mail is an admin
# only when the sender is in known= AND the receiving server verified their DKIM
# signature for the From domain (SpamAssassin's DKIM_VALID_AU in the topmost
# X-Spam-Report / X-Ham-Report); the name in known= is then their account name, so
# put it in admins= too (!claude).  Anyone else is refused.  Its mailbox password is in
# floyd.env as TVCHAT_PASS_MAIL (the account's name, upper case).  Uncomment, adjust, and add mail/* to
# attach = below.
#[account:mail]
#protocol    = mail
#display     = Floyd's mail
#addr        = floyd@cpbee.cmnet
#name        = Floyd
# who he talks to by mail: name=address, comma-separated.  Mail from anyone else is
# dropped without a word, and he never mails anyone else (mail from his own mailbox's
# domain is still answered).  Empty = no limit.
#known       = michelle=michelle.houle@gmail.com, chris=chris.pollitt@gmail.com
# the master's own mail server, if the address's domain is not it:
#imap_server = localhost
#imap_user   = floyd
#smtp_server = localhost
#smtp_user   = floyd
#smtp_port   = 587
#verify      = false

[account:floyd]
protocol = floyd
# he listens in every conversation of that account, private messages included
# add delta/* and mail/* once those accounts above are on:  attach   = cpbee/*, delta/*, mail/*
attach   = cpbee/*
# speaks as himself, so no "[Floyd] " tag
tag      =
# no wandering about in his own empty conversation
idle     = 0
# how much he does: off | minimal | helpful | chatty | clippy
#   off      deaf and mute (only "!level" is heard)
#   minimal  answers when spoken to and runs !commands, including !calc, !convert, !time in X,
#            !todo, !note, !catchup; no banter, no karma, no unprompted anything
#   helpful  + the same in plain words ("floyd: what is 12*7"), karma, !tell delivery
#   chatty   + banter and games (the default)
#   clippy   + unprompted tips: "Floyd not clippy but it looks like you ..." (one per conversation
#            per clippy_gap seconds; "floyd: shoo" mutes him for an hour)
# Admins change it per conversation with "!level NAME" (this is the default).
#level      = chatty
#clippy_gap = 300
# who may give him orders: NickServ account names (case does not matter).  The
# server vouches for the account on every line (IRCv3 account-tag); a nick, or
# a name inside a message, counts for nothing.  "!whoami" tells anyone what
# Floyd knows of them.
admins   = chris
# Floyd can ask the Claude CLI for an admin: "!claude QUESTION" in a channel,
# or "claude QUESTION" in a private message.  The CLI runs as the service user
# with only the tools below, so it can read but not run or change anything.
# Read is not confined to claude_dir: it reads whatever that user can.  The service
# runs as the floyd user (configure-floyd.sh's default), so that is only what floyd can
# read; he needs his own login:  sudo -u floyd -H bash -l, then  claude
# The CLI is also cut off from every connector (Google Drive, GitHub ... that the login's
# account has) and from skills: an empty strict --mcp-config, ENABLE_CLAUDEAI_MCP_SERVERS=false.
claude   = yes
#claude_cmd     = claude
#claude_tools   = Read,Grep,Glob
# (~ is the service user's home; configure-floyd.sh --claude-dir DIR sets it)
claude_dir      = ~
#claude_model   =
# any more command-line arguments, e.g. --max-turns 8
#claude_args    =
# seconds to wait for an answer, and lines of it that are passed on (default 180, 10)
#claude_timeout = 180
#claude_lines   = 10
# what he remembers (seen, tells, karma, quotes, facts)
#memory   = ~/.local/share/tvchat/floyd/floyd.json
