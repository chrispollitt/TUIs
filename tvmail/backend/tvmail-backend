    return 0


def cmd_host(a):
    """The box the UI is actually talking to: the IMAP host in remote mode
    (same resolution _imap() uses - [imap] host, else ~/.mail), or this
    machine's own hostname when local IS the mailstore."""
    if _is_remote():
        c = _conf()
        mu = _mu_mailbox() or {}
        host = c.get("imap", "host", fallback=None) or mu.get("host") or ""
    else:
        host = socket.gethostname().split(".")[0]
    sys.stdout.write(host + "\n")
    return 0


# --------------------------------------------------------------------------
# serve: a persistent request loop so the tvmail UI stops paying Python
# start-up (and, on Cygwin, fork/exec) three times per folder switch.
# --------------------------------------------------------------------------
class _CapStream:
    """stdout stand-in for serve mode.  Sub-commands write either str (print,
    cmd_show, cmd_compose_template) or bytes via .buffer (cmd_raw); both land
    in one BytesIO so the whole reply can be framed and sent down the pipe."""

    def __init__(self):
        self.buffer = io.BytesIO()

    def write(self, s):
        self.buffer.write(s.encode("utf-8", "replace") if isinstance(s, str) else s)
        return len(s)

    def writelines(self, seq):
        for s in seq:
            self.write(s)

    def flush(self):
        pass

    def isatty(self):
        return False


# verbs that consume stdin or take over the terminal - never run them inside
# the serve loop (they would eat the request stream)
_SERVE_BLOCKED = frozenset(("serve", "send", "save-draft", "pull"))
_COMMANDS = frozenset(("list", "show", "raw", "parts", "save", "delete",
                       "mark", "purge", "compose-template", "send",
                       "save-draft", "aliases", "pull", "ping", "mode",
                       "host", "serve"))


def _dispatch(parser, argv):
    """Run one request argv.  Returns (status:int, body:bytes)."""
    if argv and argv[0] in _SERVE_BLOCKED:
        return 2, ("tvmail-backend: '%s' is not available in serve mode\n"
                   % argv[0]).encode("utf-8")
    cap = _CapStream()
    real = sys.stdout
    sys.stdout = cap
    try:
        ns = parser.parse_args(argv)
        return (ns.fn(ns) or 0), cap.buffer.getvalue()
    except SystemExit as e:
        code = e.code
        if isinstance(code, str):               # sys.exit("message") -> error
            cap.write(code if code.endswith("\n") else code + "\n")
            return 2, cap.buffer.getvalue()
        return (int(code) if code else 0), cap.buffer.getvalue()
    except Exception as e:                       # keep the server alive
        cap.write("tvmail-backend: %s: %s\n" % (type(e).__name__, e))
        return 2, cap.buffer.getvalue()
    finally:
        sys.stdout = real


def cmd_serve(a):
    import shlex
    raw_out = getattr(sys.stdout, "buffer", sys.stdout)
    try:                                         # stray output mustn't hit the TUI
        sys.stderr = open(os.devnull, "w")
    except OSError:
        pass
    parser = build_parser()

    def emit(status, body):
        raw_out.write(("%d %d\n" % (status, len(body))).encode("ascii") + body)
        raw_out.flush()

    emit(0, b"ready")                            # handshake banner
    while True:
        line = sys.stdin.readline()
        if not line:                            # parent closed the pipe
            break
        line = line.strip()
        if not line:
            continue
        if line in ("quit", "exit"):
            break
        try:
            argv = shlex.split(line)
        except ValueError:
            emit(2, b"tvmail-backend serve: unparseable request line\n")
            continue
        try:
            st, body = _dispatch(parser, argv)
        except BrokenPipeError:
            raise
        except Exception as e:
            st, body = 2, ("tvmail-backend serve: %s\n" % e).encode("utf-8")
        emit(st, body)
    if _IMAP is not None:                        # drop the warm IMAP connection
        try:
            _IMAP.logout()
        except Exception:
            pass
    return 0


def build_parser():
    ap = argparse.ArgumentParser(prog="tvmail-backend", add_help=True)
    ap.add_argument("--debug", nargs="?", const="debug.log", metavar="FILE",
                    help="write diagnostic logging to FILE (default: debug.log)")
    ap.add_argument("--trace", nargs="?", const="trace.log", metavar="FILE",
                    help="write cProfile data to FILE (default: trace.log)")
    ap.add_argument("--version", action="version",
                    version="tvmail-backend %s" % __version__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("list");  p.add_argument("mbox", nargs="?"); p.set_defaults(fn=cmd_list)
    p = sub.add_parser("show");  p.add_argument("idx", type=int); p.add_argument("mbox", nargs="?"); p.add_argument("--mark-read", action="store_true", dest="mark_read"); p.set_defaults(fn=cmd_show)
    p = sub.add_parser("raw");   p.add_argument("idx", type=int); p.add_argument("mbox", nargs="?"); p.set_defaults(fn=cmd_raw)
    p = sub.add_parser("parts"); p.add_argument("idx", type=int); p.add_argument("mbox", nargs="?"); p.set_defaults(fn=cmd_parts)
    p = sub.add_parser("save");  p.add_argument("idx", type=int); p.add_argument("partno", type=int)
    p.add_argument("dest"); p.add_argument("mbox", nargs="?"); p.set_defaults(fn=cmd_save)
    p = sub.add_parser("delete"); p.add_argument("idx", type=int, nargs="+"); p.add_argument("--mbox", dest="mbox"); p.add_argument("--trash", dest="trash"); p.set_defaults(fn=cmd_delete)
    p = sub.add_parser("mark");  p.add_argument("idx", type=int); p.add_argument("state", choices=("read", "unread")); p.add_argument("mbox", nargs="?"); p.set_defaults(fn=cmd_mark)
    p = sub.add_parser("purge"); p.add_argument("mbox", nargs="?")
    p.add_argument("--from", dest="getfrom"); p.add_argument("--subject")
    p.add_argument("--to"); p.add_argument("--older-than", type=int, dest="older_than", metavar="DAYS")
    p.add_argument("--seen", action="store_true"); p.add_argument("--unseen", action="store_true")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--to-folder", "--trash", dest="to_folder", metavar="DEST",
                   default="trash")           # where matches go (default: trash)
    g.add_argument("--expunge", action="store_true")   # or delete outright
    p.add_argument("-n", "--dry-run", action="store_true", dest="dry_run")
    p.set_defaults(fn=cmd_purge)
    p = sub.add_parser("compose-template")
    p.add_argument("--from", dest="getfrom"); p.add_argument("--to", action="append", default=[])
    p.add_argument("--subject"); p.add_argument("--in-reply-to", type=int)
    p.add_argument("--forward", type=int); p.add_argument("--reply-all", action="store_true")
    p.add_argument("mbox", nargs="?")
    p.set_defaults(fn=cmd_compose_template)
    p = sub.add_parser("send")
    p.add_argument("--from", dest="getfrom"); p.add_argument("--to", action="append", default=[])
    p.add_argument("--subject"); p.set_defaults(fn=cmd_send)
    p = sub.add_parser("save-draft"); p.set_defaults(fn=cmd_save_draft)
    p = sub.add_parser("aliases");    p.set_defaults(fn=cmd_aliases)
    p = sub.add_parser("pull"); p.set_defaults(fn=cmd_pull)
    p = sub.add_parser("ping"); p.set_defaults(fn=cmd_ping)
    p = sub.add_parser("mode"); p.set_defaults(fn=cmd_mode)
    p = sub.add_parser("host"); p.set_defaults(fn=cmd_host)
    p = sub.add_parser("serve"); p.set_defaults(fn=cmd_serve)
    return ap


def _normalize_cli(argv):
    """Keep a bare diagnostic flag from consuming the subcommand as a path."""
    out = []
    for i, value in enumerate(argv):
        if value in ("--debug", "--trace"):
            next_value = argv[i + 1] if i + 1 < len(argv) else None
            if next_value is None or next_value.startswith("-") or next_value in _COMMANDS:
                out.append(value + ("=debug.log" if value == "--debug" else "=trace.log"))
                continue
        out.append(value)
    return out


def main():
    a = build_parser().parse_args(_normalize_cli(sys.argv[1:]))
    if a.debug:
        logging.basicConfig(filename=a.debug, level=logging.DEBUG,
                            format="%(asctime)s %(levelname)s %(message)s")
        _log.debug("command: %s", " ".join(sys.argv[1:]))

    def run():
        try:
            sys.exit(a.fn(a))
        except BrokenPipeError:
            sys.exit(0)
        except KeyboardInterrupt:
            sys.exit(130)
        except PermissionError as e:
            sys.exit("tvmail-backend: %s\n"
                     "  (rewriting a spool mbox needs write access to its directory "
                     "- on a mail server use IMAP/remote mode, not local)" % e)
        except OSError as e:                    # -> one line, not a traceback dialog
            sys.exit("tvmail-backend: %s" % e)

    if a.trace:
        import cProfile
        profiler = cProfile.Profile()
        try:
            profiler.enable()
            run()
        finally:
            profiler.disable()
            profiler.dump_stats(a.trace)
    else:
        run()


if __name__ == "__main__":
    main()
