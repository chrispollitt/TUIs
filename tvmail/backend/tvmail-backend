#!/usr/bin/env python3

"""tvmail-backend - mail-format helper for the tvmail Turbo Vision client.

All the mbox / MIME / send grunt work lives here so the C++ front-end can stay
small.  Stdlib only.

LOCAL vs REMOTE.  One host (a Pi / small server) owns the mail store and relays
outbound through the smarthost.  Every other machine - Cygwin, WSL, a VM - is a
thin client that reads over IMAP and submits over SMTP to that master.  Same UI,
same sub-commands; this program swaps its mbox layer for imaplib/smtplib when it
is not the master.  Configure with ~/.config/tvmail/tvmail.conf (see the shipped
tvmail.conf.example), or let it inherit GNU Mailutils' own ~/.mail (host/port)
and ~/.mu-tickets (credentials) - passwords otherwise live only in ~/.netrc.

Sub-commands (mailbox defaults to $MAIL or /var/mail/$USER; over IMAP the
shorthands spool/mbox/trash/drafts/sent/spam map to
INBOX/Archive/Trash/Drafts/Sent/Junk):

  list  [MBOX]              one line per message, TAB-separated:
                            idx <TAB> flags <TAB> date <TAB> from <TAB> subject
                            (idx = 0-based position; flags: 'N' new/unread, '.' seen)
  show  IDX [MBOX] [--mark-read]   decoded headers + best-effort text/plain
                            body on stdout; --mark-read also flags it \\Seen,
                            reusing this call's IMAP SELECT/SEARCH instead of
                            a separate 'mark' round trip (remote mode)
  raw   IDX [MBOX]          the raw RFC822 message on stdout
  parts IDX [MBOX]          list MIME parts: partno <TAB> content-type <TAB> filename <TAB> bytes
  save  IDX PARTNO DEST [MBOX]   write one MIME part's decoded payload to DEST
  delete IDX [IDX...] [--mbox MBOX]   remove message(s); a .bak is kept
  purge [MBOX] [--from S] [--subject S] [--to S] [--older-than DAYS]
        [--seen|--unseen] [--to-folder DEST | --expunge] [-n]
                            bulk-move (default DEST=trash) by filter (needs >=1)
  mark  IDX (read|unread) [MBOX]
  send  [--from ADDR]       read an RFC822 message (or a bare body with --to/--subject)
        [--to ADDR ...]     from stdin, submit it, and file a copy in 'sent'
        [--subject TEXT]    ([folders] sent = <blank> in tvmail.conf disables the copy)
  compose-template [--to A] [--subject S] [--in-reply-to IDX [--reply-all]]
                   [--forward IDX] [MBOX]
                            print a draft skeleton (for $EDITOR) on stdout
  pull                      local: run 'pop-pull', then file tagged spam
                            remote: file tagged spam ('***SPAM***' subject ->
                            the 'spam' folder; tag/dest set in tvmail.conf)
  ping                      print 'pong' - a liveness check
  mode                      print 'local' or 'remote'
  host                      print the IMAP host (remote) or this machine's
                            own hostname (local) - whichever mailbox the UI
                            is actually showing
  serve                     persistent mode: read one request (an argv) per
                            line on stdin, write a framed reply per request:
                                <status> <nbytes>\\n  then <nbytes> bytes
                            Keeps the mbox/MIME machinery warm so the tvmail
                            UI pays Python start-up once, not once per action.

Exit status: 0 ok, 1 usage/not-found, 2 runtime error.
"""

import sys, os, io, json, argparse, subprocess, tempfile, shutil, email, email.utils
import logging
import configparser, socket
import email.policy
from mailbox import mbox
from email.header import decode_header, make_header


__version__ = "1.0.0"
_log = logging.getLogger("tvmail-backend")


def _me():
    for k in ("USER", "LOGNAME"):
        if os.environ.get(k):
            return os.environ[k]
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_name
    except Exception:
        return "nobody"


def _sendmail():
    """Find a sendmail-compatible MTA.  Overridable with $SENDMAIL."""
    env = os.environ.get("SENDMAIL")
    if env:
        return env
    for c in ("/usr/sbin/sendmail", "/usr/lib/sendmail",
              "/usr/local/sbin/sendmail", "/usr/local/bin/sendmail",
              "/run/current-system/sw/bin/sendmail"):   # NixOS
        if os.path.exists(c):
            return c
    for name in ("sendmail", "msmtp"):
        p = shutil.which(name)
        if p:
            return p
    return "/usr/sbin/sendmail"                          # last resort; will error


def _spool():
    for d in ("/var/mail", "/var/spool/mail"):
        cand = os.path.join(d, _me())
        if os.path.exists(cand) or os.path.isdir(d):
            return cand
    return "/var/mail/" + _me()


def _data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")


def mbox_path(p=None):
    """Resolve a mailbox argument.
    Shorthands: spool/mbox/trash/drafts/sent/dead."""
    if p in (None, "", "spool"):
        return os.environ.get("MAIL") or _spool()
    if p == "mbox":
        return os.path.expanduser("~/mbox")
    if p == "trash":
        d = os.path.join(_data_home(), "tvmail")
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, "trash.mbox")
    if p == "drafts":
        d = _maildir()
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, "drafts")
    if p == "sent":
        d = _maildir()
        os.makedirs(d, exist_ok=True)
        rec = (_mailrc_var("record") or "sent").lstrip("+")   # honour `set record`
        return rec if os.path.isabs(rec) else os.path.join(d, rec)
    if p == "spam":
        d = _maildir()
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, _conf().get("folders", "spam", fallback="Junk"))
    if p == "dead":
        return _dead_path()
    return os.path.expanduser(p)


# --------------------------------------------------------------------------
# ~/.mailrc interop:  folder / DEAD variables, alias / group address book
# --------------------------------------------------------------------------
def _mailrc_files():
    fs = ["/etc/mailrc"]
    fs.append(os.environ.get("MAILRC") or os.path.expanduser("~/.mailrc"))
    return [f for f in fs if os.path.isfile(f)]


def _mailrc_var(name, default=None):
    """Last `set NAME=VALUE` (or bare `set NAME`) across the mailrc files."""
    import shlex
    val = default
    for f in _mailrc_files():
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for ln in lines:
            ln = ln.strip()
            if not ln.startswith("set "):
                continue
            try:
                toks = shlex.split(ln[4:])
            except ValueError:
                continue
            for tok in toks:
                if tok == name:
                    val = ""
                elif tok.startswith(name + "="):
                    val = tok[len(name) + 1:]
    return val


def _maildir():
    d = _mailrc_var("folder")
    return os.path.expanduser(d) if d else os.path.expanduser("~/Mail")


def _dead_path():
    return (os.environ.get("DEAD") or _mailrc_var("DEAD")
            or os.path.expanduser("~/dead.letter"))


def _dead_msg():
    p = _dead_path()
    if not os.path.exists(p) or os.path.getsize(p) == 0:
        return None
    with open(p, "rb") as f:
        return email.message_from_binary_file(f)


def _aliases():
    """{name: [addr, ...]} from mailrc alias/group lines, expanded recursively."""
    import shlex
    raw = {}
    for f in _mailrc_files():
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for ln in lines:
            ln = ln.strip()
            head = ln.split(None, 1)
            if len(head) == 2 and head[0] in ("alias", "group"):
                try:
                    toks = shlex.split(head[1])
                except ValueError:
                    continue
                if len(toks) >= 2:
                    raw[toks[0]] = toks[1:]

    def expand(name, seen):
        out = []
        for a in raw.get(name, [name]):
            if a in raw and a not in seen:
                out += expand(a, seen | {a})
            else:
                out.append(a)
        return out

    return {k: expand(k, {k}) for k in raw}


def _expand_recipients(addrs):
    al = _aliases()
    out = []
    for a in addrs:
        a = a.strip()
        if a:
            out += al.get(a, [a])
    return out


def _rcpts(msg, headers):
    out = []
    for h in headers:
        for v in (msg.get_all(h) or []):
            out += [x.strip() for x in str(v).split(",") if x.strip()]
    return out


def _hdr(msg, name, default=""):
    v = msg.get(name)
    if not v:
        return default
    try:
        return str(make_header(decode_header(v)))
    except Exception:
        return v


def _clean(s, maxlen=0):
    s = "".join(ch if ch >= " " and ch != "\x7f" else " " for ch in (s or ""))
    s = s.replace("\t", " ").strip()
    if maxlen and len(s) > maxlen:
        s = s[: maxlen - 1] + "…"
    return s


def _short_from(raw):
    name, addr = email.utils.parseaddr(raw)
    return _clean(name or addr or raw)


def _short_date(raw):
    dt = email.utils.parsedate_to_datetime(raw) if raw else None
    if not dt:
        return _clean(raw, 16)
    try:
        return dt.astimezone().strftime("%Y-%m-%d %H:%M")
    except Exception:
        return dt.strftime("%Y-%m-%d %H:%M")


# --------------------------------------------------------------------------
# GNU Mailutils interop:  ~/.mail  and  ~/.mu-tickets.
#
# mail(1) from GNU Mailutils does NOT keep its host/port/credentials in
# ~/.mailrc (that traditional file only ever holds the `set`/`alias`/`group`
# lines handled above).  It uses its own block-syntax config,
# ~/.mail  ($TVMAIL_MU_CONF overrides the path):
#   mailbox { mailbox-pattern "imap://user@host:port/box"; };
#   mailer  { url "smtp://host:port"; };
# and a tickets file for credentials, ~/.mu-tickets ($TVMAIL_MU_TICKETS):
#   scheme://user:pass@host[:port][/path]      # scheme "*" matches any
# with user/pass percent (URL) encoded.  These are read as a fallback
# behind explicit tvmail.conf [imap]/[smtp] settings and $TVMAIL_IMAP_PASS /
# $TVMAIL_SMTP_PASS / ~/.netrc, so the two mail clients can share one setup.
# --------------------------------------------------------------------------
def _mu_url(u):
    """Parse scheme://[user[:pass]@]host[:port][/path], percent-decoding
    user/pass.  Accepts the '*' wildcard scheme used in ~/.mu-tickets.
    None if u is falsy or does not parse."""
    if not u:
        return None
    import re
    from urllib.parse import unquote
    m = re.match(
        r'^(?P<scheme>\*|[A-Za-z][\w+.-]*)://'
        r'(?:(?P<user>[^:@/]*)(?::(?P<pass>[^@/]*))?@)?'
        r'(?P<host>[^:/]+)(?::(?P<port>\d+))?(?P<path>/.*)?$',
        u.strip())
    if not m:
        return None
    d = m.groupdict()
    return {
        "scheme": d["scheme"],
        "user": unquote(d["user"]) if d["user"] else None,
        "pass": unquote(d["pass"]) if d["pass"] else None,
        "host": d["host"],
        "port": int(d["port"]) if d["port"] else None,
        "path": (d["path"] or "").lstrip("/"),
    }


def _mu_conf_path():
    return os.environ.get("TVMAIL_MU_CONF") or os.path.expanduser("~/.mail")


def _mu_conf():
    """Parse ~/.mail's block syntax - name { key "value"; key2 val2; }; -
    into {block: {key: value}}.  One level of nesting is enough for the
    mailbox{} / mailer{} blocks tvmail cares about."""
    import re
    try:
        with open(_mu_conf_path(), encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return {}
    text = re.sub(r'#.*', '', text)
    blocks = {}
    for name, body in re.findall(r'([\w-]+)\s*\{([^{}]*)\}\s*;', text):
        stmts = {}
        for key, val in re.findall(r'([\w-]+)\s+"([^"]*)"\s*;', body):
            stmts[key] = val
        for key, val in re.findall(r'([\w-]+)\s+([^\s"][^\s;]*)\s*;', body):
            stmts.setdefault(key, val)
        blocks.setdefault(name, {}).update(stmts)
    return blocks


def _mu_mailbox():
    """The [imap]-equivalent parsed from ~/.mail's mailbox{} block, or None."""
    return _mu_url(_mu_conf().get("mailbox", {}).get("mailbox-pattern"))


def _mu_mailer():
    """The [smtp]-equivalent parsed from ~/.mail's mailer{} block, or None."""
    return _mu_url(_mu_conf().get("mailer", {}).get("url"))


def _mu_tickets_path():
    return os.environ.get("TVMAIL_MU_TICKETS") or os.path.expanduser("~/.mu-tickets")


def _mu_ticket_pass(scheme, host, user):
    """Password for (scheme, host[, user]) from ~/.mu-tickets.  Prefers an
    entry whose user matches; falls back to the first matching host/scheme."""
    try:
        with open(_mu_tickets_path(), encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except OSError:
        return None
    fallback = None
    for ln in lines:
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        t = _mu_url(ln)
        if not t or not t["host"] or t["host"].lower() != (host or "").lower():
            continue
        if t["scheme"] not in ("*", scheme):
            continue
        if t["pass"] is None:
            continue
        if user and t["user"] == user:
            return t["pass"]
        if fallback is None:
            fallback = t["pass"]
    return fallback


# ==========================================================================
# Local master  vs.  remote (IMAP/SMTP) client
#
# ~/.config/tvmail/tvmail.conf   ($TVMAIL_CONF overrides the path):
#   [service] mode = auto|local|remote        master = host1 ; host2
#   [imap]    host=  port=993  ssl=true  user=
#   [smtp]    host=  port=587  starttls=true  user=
#   [folders] saved=Archive  trash=Trash  drafts=Drafts
# Host/port/user fall back to ~/.mail (see above) when unset here.  Passwords
# are NEVER in that file - ~/.mu-tickets, ~/.netrc (machine <host> login <u>
# password <p>, chmod 600), or $TVMAIL_IMAP_PASS / $TVMAIL_SMTP_PASS.
# ==========================================================================
def _conf_path():
    return os.environ.get("TVMAIL_CONF") or os.path.expanduser(
        "~/.config/tvmail/tvmail.conf")


def _conf():
    c = configparser.ConfigParser()
    try:
        c.read(_conf_path())
    except configparser.Error:
        pass
    return c


def _mode():
    """'local' or 'remote'."""
    import re
    c = _conf()
    m = (os.environ.get("TVMAIL_MODE")
         or c.get("service", "mode", fallback="auto")).strip().lower()
    if m in ("local", "remote"):
        return m
    masters = [x.lower() for x in
               re.split(r"[;,\s]+", c.get("service", "master", fallback="")) if x]
    if socket.gethostname().split(".")[0].lower() in masters:
        return "local"
    mu = _mu_mailbox()
    has_imap = c.has_section("imap") or bool(
        mu and (mu["scheme"] or "").startswith("imap"))
    return "remote" if has_imap else "local"


def _is_remote():
    return _mode() == "remote"


def _cred(host, user, envvar, scheme=None):
    """Password from $<envvar>, ~/.mu-tickets, or ~/.netrc; abort with
    guidance if none of them have it."""
    v = os.environ.get(envvar)
    if v:
        return v
    pw = _mu_ticket_pass(scheme, host, user)
    if pw is not None:
        return pw
    try:
        import netrc
        auth = netrc.netrc(os.path.expanduser("~/.netrc")).authenticators(host)
        if auth and auth[2]:
            return auth[2]
    except FileNotFoundError:
        pass
    except netrc.NetrcParseError as e:
        sys.exit("tvmail-backend: ~/.netrc: %s (is it mode 600?)" % e)
    sys.exit("tvmail-backend: no password for %s - add it to ~/.mu-tickets "
             "(%s://%s:PASS@%s), ~/.netrc (machine %s login %s password "
             "...), or set $%s"
             % (host, scheme or "*", user, host, host, user, envvar))


_IMAP = None


def _q_mbox(name):
    """Quote an IMAP mailbox name if it needs it (imaplib does not)."""
    return '"%s"' % name if (" " in name and not name.startswith('"')) else name


def _imap():
    """A logged-in IMAP4 connection, reused across serve-mode requests."""
    global _IMAP
    if _IMAP is not None:
        try:
            _IMAP.noop()
            return _IMAP
        except Exception:
            _IMAP = None
    c = _conf()
    mu = _mu_mailbox() or {}
    host = c.get("imap", "host", fallback=None) or mu.get("host")
    if not host:
        sys.exit("tvmail-backend: remote mode but no IMAP host in "
                 + _conf_path() + " or " + _mu_conf_path())
    import imaplib, ssl as _ssl
    scheme = mu.get("scheme") or "imaps"
    default_ssl = scheme != "imap"           # imaps (or no ~/.mail) -> TLS
    use_ssl = c.getboolean("imap", "ssl", fallback=default_ssl)
    port = (c.getint("imap", "port", fallback=None) or mu.get("port")
            or (993 if use_ssl else 143))
    user = c.get("imap", "user", fallback=None) or mu.get("user") or _me()
    verify = c.getboolean("imap", "verify", fallback=True)
    cafile = c.get("imap", "cafile", fallback="").strip() or None
    ctx = _ssl.create_default_context(cafile=cafile)
    if not verify:                              # LAN box with a self-signed cert
        ctx.check_hostname = False
        ctx.verify_mode = _ssl.CERT_NONE
    try:
        if use_ssl:
            M = imaplib.IMAP4_SSL(host, port, ssl_context=ctx)
        else:
            M = imaplib.IMAP4(host, port)
            if "STARTTLS" in getattr(M, "capabilities", ()):
                M.starttls(ssl_context=ctx)
        M.login(user, _cred(host, user, "TVMAIL_IMAP_PASS", scheme))
    except (imaplib.IMAP4.error, OSError, _ssl.SSLError) as e:
        sys.exit("tvmail-backend: IMAP %s:%d - %s" % (host, port, e))
    _IMAP = M
    return M


_SPECIALUSE_ATTR = {"saved": "\\archive", "trash": "\\trash",
                    "drafts": "\\drafts", "sent": "\\sent", "spam": "\\junk"}


def _imap_specialuse_map(M):
    """RFC 6154 SPECIAL-USE folder discovery: {'\\sent': 'INBOX.Sent', ...}.
    Servers disagree on namespace layout - cmpi's folders sit at the top
    ("Sent"), mail.u-l.ca's sit under an "INBOX." prefix ("INBOX.Sent") - so a
    folder name that is correct on one 404s on the other ("Client tried to
    access nonexistent namespace"). Both still tag their special folders per
    RFC 6154, so LIST's attributes name the real mailbox on either server
    without tvmail having to know its namespace convention. Cached as an
    attribute on the connection object itself (not in a module-level dict
    keyed by id(M)) - CPython can and does reuse a freed object's id for an
    unrelated new one, which made a stale entry wrongly match a different,
    later connection (bit us via the test suite's per-test FakeIMAP
    instances, but the same hazard exists for a real reconnect)."""
    cached = getattr(M, "_tvmail_specialuse", None)
    if cached is not None:
        return cached
    out = {}
    try:
        import re
        typ, data = M.list()
        if typ == "OK":
            pat = re.compile(r'^\((?P<attrs>[^)]*)\)\s+"[^"]*"\s+(?P<name>.+)$')
            for line in data or []:
                if isinstance(line, bytes):
                    line = line.decode("utf-8", "replace")
                m = pat.match(line)
                if not m:
                    continue
                name = m.group("name").strip()
                if name.startswith('"') and name.endswith('"'):
                    name = name[1:-1]
                for attr in m.group("attrs").split():
                    if attr.lower() in _SPECIALUSE_ATTR.values():
                        out[attr.lower()] = name
    except Exception:
        pass
    M._tvmail_specialuse = out
    return out


def _imap_folder(p):
    """Map a tvmail mailbox shorthand to an IMAP folder name."""
    c = _conf()
    key = {None: "inbox", "": "inbox", "spool": "inbox",
           "mbox": "saved"}.get(p, p)
    default = {"inbox": "INBOX", "saved": "Archive", "trash": "Trash",
              "drafts": "Drafts", "sent": "Sent", "spam": "Junk"}.get(key)
    if default is None:
        return p
    if c.has_option("folders", key):
        return c.get("folders", key)          # explicit override always wins
    attr = _SPECIALUSE_ATTR.get(key)
    if attr:
        try:
            found = _imap_specialuse_map(_imap()).get(attr)
        except (Exception, SystemExit):
            # _imap() sys.exit()s (SystemExit, not caught by "except
            # Exception") on a bad/missing connection - folder-name lookup
            # must degrade to the hardcoded default rather than take the
            # whole process down; the real connection error, if any, surfaces
            # properly moments later when the caller actually uses the
            # folder for real IMAP work.
            found = None
        if found:
            return found
    return default


def _imap_copy_to(M, uid, dest):
    """COPY uid to dest, creating dest first if it doesn't exist yet (IMAP
    has no local mbox_path()-style auto-create; a plain COPY to a missing
    folder just fails - and the old code never checked that, so a message
    got marked \\Deleted and expunged even though the copy never landed
    anywhere).  Exits with a clear error rather than silently losing mail."""
    typ, _ = M.uid("COPY", uid, _q_mbox(dest))
    if typ == "OK":
        return
    try:
        M.create(_q_mbox(dest))
    except Exception:
        pass
    typ, resp = M.uid("COPY", uid, _q_mbox(dest))
    if typ != "OK":
        sys.exit("tvmail-backend: IMAP COPY to %s failed (%s) - nothing deleted"
                 % (dest, resp))


def _imap_select(M, folder, readonly):
    """SELECT/EXAMINE folder, skipping the round trip if this connection
    already has it open in the same mode. SELECT only switches mailbox
    context - it doesn't refresh data (SEARCH/FETCH already see live server
    state on an already-selected mailbox), so re-selecting the same folder
    is a pure no-op round trip. Arrow-key navigation re-does this on every
    keystroke; on a slow link (a shared webhost vs. the LAN master) that
    round trip is real, felt latency. All SELECTs must go through here -
    a stray M.select() would desync the cache from the connection's real
    state and make a later skip wrong. Cached as an attribute on M itself,
    not in a module-level dict keyed by id(M) - see _imap_specialuse_map()'s
    docstring for why that's unsafe (id() reuse across connections)."""
    if getattr(M, "_tvmail_selected", None) == (folder, readonly):
        return
    typ, _ = M.select(_q_mbox(folder), readonly=readonly)
    if typ != "OK":
        M._tvmail_selected = None
        sys.exit("tvmail-backend: IMAP SELECT %s failed" % folder)
    M._tvmail_selected = (folder, readonly)


def _imap_uids(folder, readonly=True):
    M = _imap()
    _imap_select(M, folder, readonly)
    typ, data = M.uid("SEARCH", None, "ALL")
    if typ != "OK":
        sys.exit("tvmail-backend: IMAP SEARCH failed")
    return sorted(int(x) for x in (data[0] or b"").split())


def _imap_uid_at(folder, idx, readonly=True):
    uids = _imap_uids(folder, readonly)
    if not (0 <= idx < len(uids)):
        sys.exit("tvmail-backend: no message at index %d" % idx)
    return uids, uids[idx]


def _imap_msg(folder, idx, readonly=True):
    """Fetch message idx in folder, returning (uid, parsed message). Opens
    writable (readonly=False) when the caller is about to STORE flags right
    after - e.g. show --mark-read - so that STORE reuses this SELECT instead
    of paying for a second one under a fresh EXAMINE-vs-SELECT mismatch."""
    _, uid = _imap_uid_at(folder, idx, readonly=readonly)
    typ, data = _imap().uid("FETCH", str(uid), "(BODY.PEEK[])")
    for item in (data or []):
        if isinstance(item, tuple) and item[1]:
            return uid, email.message_from_bytes(item[1])
    sys.exit("tvmail-backend: IMAP FETCH %d failed" % idx)


def _imap_list(folder):
    import re
    M = _imap()
    uids = _imap_uids(folder)
    if not uids:
        return
    typ, data = M.uid("FETCH", ",".join(map(str, uids)),
                      "(FLAGS BODY.PEEK[HEADER.FIELDS (DATE FROM SUBJECT)])")
    meta = {}
    for item in (data or []):
        if not (isinstance(item, tuple) and item[1]):
            continue
        head = item[0].decode("latin-1", "replace")
        mu = re.search(r"UID (\d+)", head)
        mf = re.search(r"FLAGS \(([^)]*)\)", head)
        if mu:
            meta[int(mu.group(1))] = (mf.group(1) if mf else "",
                                      email.message_from_bytes(item[1]))
    for i, u in enumerate(uids):
        fl, msg = meta.get(u, ("", email.message.Message()))
        print("\t".join((
            str(i),
            "." if "\\Seen" in fl else "N",
            _short_date(msg.get("Date", "")),
            _clean(_short_from(msg.get("From", "")), 28),
            _clean(_hdr(msg, "Subject", "(no subject)"), 200),
        )))


def _smtp_send(msg, rcpts):
    """Submit via [smtp] (or ~/.mail's mailer{}) to the master.  False -> no
    host configured, caller falls back to local sendmail."""
    c = _conf()
    mu = _mu_mailer() or {}
    host = c.get("smtp", "host", fallback=None) or mu.get("host")
    if not host:
        return False
    import smtplib, ssl as _ssl
    scheme = mu.get("scheme") or "smtp"
    port = c.getint("smtp", "port", fallback=None) or mu.get("port") or 587
    user = c.get("smtp", "user", fallback=None) or mu.get("user") or _me()
    use_ssl = c.getboolean("smtp", "ssl",
                           fallback=(scheme == "smtps" or port == 465))
    starttls = c.getboolean("smtp", "starttls", fallback=not use_ssl)
    do_auth = c.getboolean("smtp", "auth", fallback=True)  # false: mynetworks relay
    verify = c.getboolean("smtp", "verify", fallback=True)
    cafile = c.get("smtp", "cafile", fallback="").strip() or None
    ctx = _ssl.create_default_context(cafile=cafile)
    if not verify:                              # LAN box with a self-signed cert
        ctx.check_hostname = False
        ctx.verify_mode = _ssl.CERT_NONE
    # This box can't receive, so force the sender to the real mailbox: the
    # master then just relays, no server-side rewrite needed.
    forced = c.get("smtp", "from", fallback="").strip()
    if forced:
        del msg["From"]
        msg["From"] = forced
    frm = email.utils.parseaddr(msg.get("From", ""))[1] or user
    try:
        S = (smtplib.SMTP_SSL(host, port, timeout=30, context=ctx) if use_ssl
             else smtplib.SMTP(host, port, timeout=30))
        try:
            S.ehlo()
            if starttls and not use_ssl:
                S.starttls(context=ctx)
                S.ehlo()
            if do_auth:
                pw = _cred(host, user, "TVMAIL_SMTP_PASS", scheme)
                if pw:
                    S.login(user, pw)
            S.sendmail(frm, rcpts, msg.as_bytes())
        finally:
            try:
                S.quit()
            except Exception:
                pass    # don't let a failed cleanup mask the real error above
    except (smtplib.SMTPException, OSError) as e:
        sys.exit("tvmail-backend: SMTP %s:%d - %s" % (host, port, e))
    return True


def _save_sent(msg):
    """Best-effort copy of an outgoing message into the sent folder.
    Disabled by an empty  [folders] sent  in tvmail.conf."""
    c = _conf()
    if _is_remote():
        name = _imap_folder("sent")
        if not name:
            return
        import imaplib, time as _t
        try:
            _imap().append(_q_mbox(name), r"(\Seen)",
                           imaplib.Time2Internaldate(_t.time()), msg.as_bytes())
        except Exception:
            pass
        return
    if c.has_option("folders", "sent") and not c.get("folders", "sent"):
        return
    try:
        p = mbox_path("sent")
        d = os.path.dirname(p)
        if d:
            os.makedirs(d, exist_ok=True)
        if "Date" not in msg:
            msg["Date"] = email.utils.formatdate(localtime=True)
        b = mbox(p, factory=None, create=True)
        b.lock()
        try:
            b.add(msg)
            b.flush()
        finally:
            b.close()                 # unlocks + closes the file handle
    except OSError:
        pass


def _sweep_locks(path, older_than=300, temps_only=False):
    """Remove stale mailbox lock/temp cruft left next to the spool file.

    Python's mailbox module leaves two kinds of debris on Cygwin (where its
    os.link() hardlink dance and atomic rename are flaky, and a hard kill
    orphans whatever was mid-flight):

      <mbox>.lock.<time>.<host>.<pid>   lock() hitching post
      <mbox>.<time>.<host>.<pid>        flush() rewrite temp

    Sweep both patterns (and, unless temps_only, a bare '<mbox>.lock') once
    they're older than `older_than` seconds.
    """
    import re, time
    now = time.time()
    d = os.path.dirname(path) or "."
    base = os.path.basename(path)
    junk = re.compile(re.escape(base) + r"\.(?:lock\.)?\d{9,}\.[^.]+\.\d+\Z")
    try:
        names = os.listdir(d)
    except OSError:
        names = []
    victims = [os.path.join(d, n) for n in names if junk.match(n)]
    if not temps_only:
        victims.append(path + ".lock")
    for f in victims:
        try:
            if os.path.isfile(f) and now - os.path.getmtime(f) > older_than:
                os.unlink(f)
        except OSError:
            pass


def open_box(path, create=False):
    _sweep_locks(path)
    if not create and not os.path.exists(path):
        sys.exit("tvmail-backend: no such mailbox: " + path)
    return mbox(path, factory=None, create=True)


def cmd_list(a):
    if a.mbox == "dead":
        import time
        m = _dead_msg()
        if m is None:
            return 0
        dt = _short_date(m.get("Date", "")) or time.strftime(
            "%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(_dead_path())))
        print("\t".join(("0", "N", dt,
                         _clean(_short_from(m.get("From", "")), 28),
                         _clean(_hdr(m, "Subject", "(dead.letter)"), 200))))
        return 0
    if _is_remote():
        _imap_list(_imap_folder(a.mbox))
        return 0
    path = mbox_path(a.mbox)
    if not os.path.exists(path):
        return 0                       # a not-yet-created mailbox lists as empty
    box = open_box(path)               # read-only: no lock (this is the hot path
    for i, msg in enumerate(box):      # the 3-pane UI hammers on every keystroke)
        status = (msg.get("Status", "") or "") + (msg.get("X-Status", "") or "")
        flags = "." if "R" in status else "N"
        print("\t".join((
            str(i),
            flags,
            _short_date(msg.get("Date", "")),
            _clean(_short_from(msg.get("From", "")), 28),
            _clean(_hdr(msg, "Subject", "(no subject)"), 200),
        )))
    return 0


def _get_msg(a):
    if a.mbox == "dead":
        m = _dead_msg()
        if m is None:
            sys.exit("tvmail-backend: dead.letter is empty")
        if a.idx != 0:
            sys.exit("tvmail-backend: no message at index %d" % a.idx)
        return None, m
    if _is_remote():
        _, msg = _imap_msg(_imap_folder(a.mbox), a.idx)
        return None, msg
    box = open_box(mbox_path(a.mbox))
    try:
        return box, box[a.idx]
    except (IndexError, KeyError):
        sys.exit("tvmail-backend: no message at index %d" % a.idx)


def _best_body(msg):
    """Return decoded text/plain, falling back to a de-tagged text/html."""
    plain = html = None
    for part in msg.walk():
        ct = part.get_content_type()
        if part.is_multipart():
            continue
        disp = (part.get("Content-Disposition") or "").lower()
        if "attachment" in disp:
            continue
        try:
            payload = part.get_payload(decode=True) or b""
            charset = part.get_content_charset() or "utf-8"
            text = payload.decode(charset, "replace")
        except Exception:
            continue
        if ct == "text/plain" and plain is None:
            plain = text
        elif ct == "text/html" and html is None:
            html = text
    if plain is not None:
        return plain
    if html is not None:
        import re
        t = re.sub(r"(?is)<(script|style).*?</\1>", "", html)
        t = re.sub(r"(?s)<[^>]+>", "", t)
        return email.utils.unquote(t)
    return "(no text/plain part)"


def cmd_show(a):
    mark_read = getattr(a, "mark_read", False)
    uid = None
    box = None
    if mark_read and a.mbox != "dead" and _is_remote():
        # Open writable up front and keep the uid, so the STORE below reuses
        # this SELECT+SEARCH instead of "mark" redoing them from scratch -
        # that redundant round trip is what made remote mode feel sluggish.
        uid, msg = _imap_msg(_imap_folder(a.mbox), a.idx, readonly=False)
    else:
        # Local mode: keep the open box too, so mark-read below (if asked
        # for) reuses this handle instead of _mark() opening a second one -
        # see _mark()'s docstring for why that combination is unsafe.
        box, msg = _get_msg(a)
    out = []
    for h in ("Date", "From", "To", "Cc", "Subject"):
        v = _hdr(msg, h)
        if v:
            out.append("%-8s %s" % (h + ":", v))
    atts = [p.get_filename() for p in msg.walk()
            if p.get_filename() and "attachment" in
            (p.get("Content-Disposition") or "").lower()]
    if atts:
        out.append("%-8s %s" % ("Attach:", ", ".join(a for a in atts if a)))
    out.append("")
    out.append(_best_body(msg).replace("\r\n", "\n").rstrip() + "\n")
    if mark_read:
        _mark(a.mbox, a.idx, "read", uid=uid, box=box)
    sys.stdout.write("\n".join(out))
    return 0


def cmd_raw(a):
    _, msg = _get_msg(a)
    sys.stdout.buffer.write(msg.as_bytes())
    return 0


def cmd_parts(a):
    _, msg = _get_msg(a)
    for n, part in enumerate(msg.walk()):
        if part.is_multipart():
            continue
        payload = part.get_payload(decode=True) or b""
        print("\t".join((str(n), part.get_content_type(),
                          _clean(part.get_filename() or ""), str(len(payload)))))
    return 0


def cmd_save(a):
    """partno is the number cmd_parts printed - the index into msg.walk(),
    not a 0-based count of leaf parts (those differ whenever a message has
    more than one multipart container, e.g. a mixed/alternative nesting)."""
    _, msg = _get_msg(a)
    for n, part in enumerate(msg.walk()):
        if part.is_multipart():
            continue
        if n == a.partno:
            with open(a.dest, "wb") as f:
                f.write(part.get_payload(decode=True) or b"")
            print("wrote", a.dest)
            return 0
    sys.exit("tvmail-backend: no part %d" % a.partno)


def cmd_delete(a):
    if a.mbox == "dead":
        p = _dead_path()
        if os.path.exists(p):
            if getattr(a, "trash", None):
                m = _dead_msg()
                tp = mbox_path(a.trash)
                d = os.path.dirname(tp)
                if d:
                    os.makedirs(d, exist_ok=True)
                tb = mbox(tp, factory=None, create=True)
                tb.lock()
                try:
                    if m is not None:
                        tb.add(m)
                    tb.flush()
                finally:
                    tb.unlock()
            os.remove(p)
        print("deleted 1 message(s)")
        return 0
    if _is_remote():
        folder = _imap_folder(a.mbox)
        requested = getattr(a, "trash", None)
        dest = _imap_folder(requested) if requested else None
        copy = dest and folder != dest
        uids = _imap_uids(folder, readonly=False)
        victims = sorted(set(a.idx))
        if any(not (0 <= v < len(uids)) for v in victims):
            sys.exit("tvmail-backend: index out of range")
        M = _imap()
        for v in victims:
            u = str(uids[v])
            if copy:
                _imap_copy_to(M, u, dest)
            typ, resp = M.uid("STORE", u, "+FLAGS", r"(\Deleted)")
            if typ != "OK":
                sys.exit("tvmail-backend: IMAP STORE failed (%s) - nothing deleted"
                         % resp)
        typ, resp = M.expunge()
        if typ != "OK":
            sys.exit("tvmail-backend: IMAP EXPUNGE failed (%s) - nothing deleted"
                     % resp)
        print("deleted %d message(s)" % len(victims))
        return 0
    path = mbox_path(a.mbox)
    box = open_box(path)
    box.lock()
    try:
        keys = list(box.keys())
        victims = sorted(set(a.idx))
        if any(not (0 <= v < len(keys)) for v in victims):
            sys.exit("tvmail-backend: index out of range")
        if getattr(a, "trash", None):
            tp = mbox_path(a.trash)
            d = os.path.dirname(tp)
            if d:
                os.makedirs(d, exist_ok=True)
            tbox = mbox(tp, factory=None, create=True)
            tbox.lock()
            try:
                for v in victims:
                    tbox.add(box[keys[v]])
                tbox.flush()
            finally:
                tbox.unlock()
        bdir = os.path.join(_data_home(), "tvmail", "backup")
        os.makedirs(bdir, exist_ok=True)
        shutil.copy2(path, os.path.join(bdir, os.path.basename(path) + ".bak"))
        for v in victims:
            box.remove(keys[v])
        box.flush()
    finally:
        box.unlock()
        _sweep_locks(path, older_than=30, temps_only=True)   # tidy our own leak
    print("deleted %d message(s)" % len(victims))
    return 0


def _purge_filter(a):
    """(predicate, have_filter) for local mbox purge."""
    subs = [(h, n.lower()) for h, n in
            (("From", a.getfrom), ("Subject", a.subject), ("To", a.to)) if n]
    cutoff = None
    if a.older_than is not None:
        import time
        cutoff = time.time() - a.older_than * 86400
    have = bool(subs) or cutoff is not None or a.seen or a.unseen

    def match(msg):
        for h, needle in subs:
            if needle not in _hdr(msg, h, "").lower():
                return False
        if cutoff is not None:
            raw = msg.get("Date", "")
            dt = email.utils.parsedate_to_datetime(raw) if raw else None
            if dt is None or dt.timestamp() >= cutoff:   # undatable -> keep
                return False
        if a.seen or a.unseen:
            seen = "R" in (msg.get("Status", "") or "")
            if a.seen and not seen:
                return False
            if a.unseen and seen:
                return False
        return True

    return match, have


def _purge_preview(msg):
    print("\t".join((_short_date(msg.get("Date", "")),
                     _clean(_short_from(msg.get("From", "")), 28),
                     _clean(_hdr(msg, "Subject", "(no subject)"), 120))))


def _local_purge(a):
    match, have = _purge_filter(a)
    if not have:
        sys.exit("tvmail-backend purge: refusing to run with no filter")
    path = mbox_path(a.mbox)
    if not os.path.exists(path):
        print("purged 0 message(s)")
        return 0
    if a.dry_run:
        n = 0
        for msg in open_box(path):
            if match(msg):
                n += 1
                _purge_preview(msg)
        print("would purge %d message(s)" % n)
        return 0
    box = open_box(path)
    box.lock()
    try:
        victims = [k for k in box.keys() if match(box[k])]
        if not victims:
            print("purged 0 message(s)")
            return 0
        if not a.expunge:
            tp = mbox_path(getattr(a, "to_folder", None) or "trash")
            d = os.path.dirname(tp)
            if d:
                os.makedirs(d, exist_ok=True)
            tb = mbox(tp, factory=None, create=True)
            tb.lock()
            try:
                for k in victims:
                    tb.add(box[k])
                tb.flush()
            finally:
                tb.close()
        bdir = os.path.join(_data_home(), "tvmail", "backup")
        os.makedirs(bdir, exist_ok=True)
        shutil.copy2(path, os.path.join(bdir, os.path.basename(path) + ".bak"))
        for k in victims:
            box.remove(k)
        box.flush()
    finally:
        box.close()
        _sweep_locks(path, older_than=30, temps_only=True)
    print("purged %d message(s)" % len(victims))
    return 0


def _imap_purge(a):
    crit = []
    if a.getfrom:
        crit += ["FROM", '"%s"' % a.getfrom.replace('"', "")]
    if a.subject:
        crit += ["SUBJECT", '"%s"' % a.subject.replace('"', "")]
    if a.to:
        crit += ["TO", '"%s"' % a.to.replace('"', "")]
    if a.seen:
        crit += ["SEEN"]
    if a.unseen:
        crit += ["UNSEEN"]
    if a.older_than is not None:
        import time
        crit += ["BEFORE", time.strftime(
            "%d-%b-%Y", time.gmtime(time.time() - a.older_than * 86400))]
    if not crit:
        sys.exit("tvmail-backend purge: refusing to run with no filter")
    folder = _imap_folder(a.mbox)
    M = _imap()
    _imap_select(M, folder, a.dry_run)
    typ, data = M.uid("SEARCH", None, *crit)
    if typ != "OK":
        sys.exit("tvmail-backend: IMAP SEARCH failed")
    uids = (data[0] or b"").split()
    if a.dry_run:
        for u in uids:
            _, d = M.uid("FETCH", u,
                         "(BODY.PEEK[HEADER.FIELDS (DATE FROM SUBJECT)])")
            for it in (d or []):
                if isinstance(it, tuple) and it[1]:
                    _purge_preview(email.message_from_bytes(it[1]))
        print("would purge %d message(s)" % len(uids))
        return 0
    if not uids:
        print("purged 0 message(s)")
        return 0
    dest = _imap_folder(getattr(a, "to_folder", None) or "trash")
    copy = not a.expunge and folder != dest
    for u in uids:
        if copy:
            _imap_copy_to(M, u, dest)
        M.uid("STORE", u, "+FLAGS", r"(\Deleted)")
    M.expunge()
    print("purged %d message(s)" % len(uids))
    return 0


def cmd_purge(a):
    if a.mbox == "dead":
        sys.exit("tvmail-backend purge: not applicable to dead.letter")
    return _imap_purge(a) if _is_remote() else _local_purge(a)


def _mark(mbox, idx, state, uid=None, box=None):
    """Set/clear \\Seen for message idx in mbox.
    uid, when the caller already has it (show --mark-read reuses the
    SELECT+SEARCH it just paid for), skips the extra IMAP round trip
    _imap_uid_at() would otherwise repeat.
    box, when the caller already has the local mbox open (same case), must
    be reused rather than reopened: flush() rewrites-and-renames the file,
    and a second, independently-opened handle on the same path still open
    when that happens breaks the rename on some filesystems (hit this for
    real via show --mark-read - Cygwin/NTFS rename-over-an-open-handle is
    flaky, same class of bug as the stale .lock* cleanup this project
    already has to do elsewhere)."""
    if mbox == "dead":
        return                          # dead.letter has no per-message flags
    if _is_remote():
        if uid is None:
            _, uid = _imap_uid_at(_imap_folder(mbox), idx, readonly=False)
        op = "+FLAGS" if state == "read" else "-FLAGS"
        _imap().uid("STORE", str(uid), op, r"(\Seen)")
        return
    owns_box = box is None
    if owns_box:
        box = open_box(mbox_path(mbox))
    box.lock()
    try:
        msg = box[idx]
        status = "".join(c for c in (msg.get("Status", "") or "") if c in "ROU")
        if state == "read":
            status = "".join(sorted(set(status + "RO")))
        else:
            status = status.replace("R", "")
        del msg["Status"]
        if status:
            msg["Status"] = status
        box[idx] = msg
        box.flush()
    finally:
        box.unlock()
        if owns_box:
            box.close()


def cmd_mark(a):
    _mark(a.mbox, a.idx, a.state)
    return 0


def cmd_compose_template(a):
    frm = a.getfrom or (os.environ.get("USER") or os.environ.get("LOGNAME")
                        or "nobody") + "@" + os.uname().nodename
    to = ", ".join(a.to) if a.to else ""
    subj = a.subject or ""
    body = ""
    cc = ""
    if getattr(a, "forward", None) is not None:
        _, src = _get_msg(argparse.Namespace(mbox=a.mbox, idx=a.forward))
        if not subj:
            s = _hdr(src, "Subject", "")
            subj = s if s.lower().startswith("fwd:") else "Fwd: " + s
        body = ("\n---------- Forwarded message ----------\n"
                "From: %s\nDate: %s\nSubject: %s\nTo: %s\n\n%s\n"
                % (_hdr(src, "From"), _hdr(src, "Date"), _hdr(src, "Subject"),
                   _hdr(src, "To"), _best_body(src)))
    elif a.in_reply_to is not None:
        _, src = _get_msg(argparse.Namespace(mbox=a.mbox, idx=a.in_reply_to))
        if not to:
            to = _hdr(src, "Reply-To") or _hdr(src, "From")
        if not subj:
            s = _hdr(src, "Subject", "")
            subj = s if s.lower().startswith("re:") else "Re: " + s
        who = _short_from(src.get("From", "someone"))
        quoted = "\n".join("> " + ln for ln in _best_body(src).splitlines())
        body = "\nOn %s, %s wrote:\n%s\n" % (_short_date(src.get("Date", "")), who, quoted)
        if getattr(a, "reply_all", False):
            # Cc = original To+Cc, minus whatever just landed in the new To.
            seen = {addr.lower() for _, addr in email.utils.getaddresses([to])}
            cc_addrs = []
            for name, addr in email.utils.getaddresses(_rcpts(src, ("To", "Cc"))):
                key = addr.lower()
                if addr and key not in seen:
                    seen.add(key)
                    cc_addrs.append(email.utils.formataddr((name, addr)) if name else addr)
            cc = ", ".join(cc_addrs)
    out = "From: %s\nTo: %s\n" % (frm, to)
    if cc:
        out += "Cc: %s\n" % cc
    out += "Subject: %s\n\n%s" % (subj, body)
    sys.stdout.write(out)
    return 0


def cmd_send(a):
    data = sys.stdin.buffer.read()
    looks_rfc822 = data[:200].lstrip().lower().startswith((
        b"from:", b"to:", b"subject:", b"date:", b"cc:", b"mime-version:",
        b"content-type:", b"reply-to:", b"message-id:"))
    if looks_rfc822:
        msg = email.message_from_bytes(data)
    else:
        msg = email.message.EmailMessage()
        msg.set_content(data.decode("utf-8", "replace"))
    if a.getfrom and "From" not in msg:
        msg["From"] = a.getfrom
    if a.subject and "Subject" not in msg:
        msg["Subject"] = a.subject
    for t in a.to:
        msg["To"] = t

    # Address book: expand ~/.mailrc alias/group names in To:/Cc:/Bcc:
    to_hdr = _expand_recipients(_rcpts(msg, ("To",)))
    cc_hdr = _expand_recipients(_rcpts(msg, ("Cc",)))
    bcc    = _expand_recipients(_rcpts(msg, ("Bcc",)))
    del msg["To"], msg["Cc"], msg["Bcc"]
    if to_hdr:
        msg["To"] = ", ".join(to_hdr)
    if cc_hdr:
        msg["Cc"] = ", ".join(cc_hdr)

    rcpts = to_hdr + cc_hdr + bcc
    if not rcpts:
        sys.exit("tvmail-backend send: no recipients (--to or a To: header)")

    if _is_remote() and _smtp_send(msg, rcpts):
        _save_sent(msg)
        print("sent")
        return 0

    sm = _sendmail()
    if not (os.path.exists(sm) or shutil.which(sm)):
        sys.exit("tvmail-backend: no sendmail MTA found "
                 "(looked for /usr/sbin/sendmail, msmtp, ...; set $SENDMAIL)")
    p = subprocess.run([sm, "-oi"] + rcpts, input=msg.as_bytes())
    if p.returncode != 0:
        sys.exit("tvmail-backend: %s exited %d" % (os.path.basename(sm), p.returncode))
    _save_sent(msg)
    print("sent")
    return 0


def cmd_save_draft(a):
    data = sys.stdin.buffer.read()
    m = email.message_from_bytes(data)
    if "Date" not in m:
        m["Date"] = email.utils.formatdate(localtime=True)
    if _is_remote():
        import imaplib, time as _t
        folder = _imap_folder("drafts")
        _imap().append(_q_mbox(folder), r"(\Draft)",
                       imaplib.Time2Internaldate(_t.time()), m.as_bytes())
        print("draft saved")
        return 0
    dp = mbox_path("drafts")
    d = os.path.dirname(dp)
    if d:
        os.makedirs(d, exist_ok=True)
    box = mbox(dp, factory=None, create=True)
    box.lock()
    try:
        box.add(m)
        box.flush()
    finally:
        box.unlock()
    print("draft saved")
    return 0


def cmd_aliases(a):
    for name, addrs in sorted(_aliases().items()):
        print("%s\t%s" % (name, ", ".join(addrs)))
    return 0


def _sweep_spam():
    """Move INBOX messages whose Subject carries the SpamAssassin tag into the
    spam folder.  Returns how many moved.  [folders] spam = <blank> disables."""
    import re
    c = _conf()
    if c.has_option("folders", "spam") and not c.get("folders", "spam"):
        return 0
    tag = c.get("spam", "subject", fallback="***SPAM***")
    ns = argparse.Namespace(mbox="spool", getfrom=None, subject=tag, to=None,
                            older_than=None, seen=False, unseen=False,
                            to_folder="spam", expunge=False, dry_run=False)
    buf, real = io.StringIO(), sys.stdout
    sys.stdout = buf
    try:
        cmd_purge(ns)
    except SystemExit:
        pass
    finally:
        sys.stdout = real
    m = re.search(r"purged (\d+)", buf.getvalue())
    return int(m.group(1)) if m else 0


def cmd_pull(a):
    if _is_remote():
        n = _sweep_spam()                       # F3 on a client = "file the spam"
        print("filed %d spam message(s)" % n if n else "no spam to file")
        return 0
    exe = shutil.which("pop-pull")
    if not exe or not os.path.exists(exe):
        sys.exit("tvmail-backend: pop-pull not found - run configure-mail-pull.sh")
    rc = subprocess.run([exe, "-v"]).returncode
    n = _sweep_spam()
    if n:
        print("filed %d spam message(s)" % n)
    return rc


