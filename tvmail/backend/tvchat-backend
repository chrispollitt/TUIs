ADAPTERS = {"irc": IrcAdapter, "deltachat": DeltaChatAdapter}


# --------------------------------------------------------------------------
# The chat service: the accounts, the event queue and the protocol adapters,
# behind the verbs the UI calls.  One instance per process.
# --------------------------------------------------------------------------
class Chat:
    def __init__(self, loop=None, clock=time.time):
        self.loop = loop or Loop()
        self.events = EventQueue(clock)
        # A broken tvchat.conf must not kill the co-process before its banner
        # (tvmail would just see a dead backend); keep the complaint and give
        # it, as a user-facing error, to every verb that needs the accounts.
        self.conf_error = None
        try:
            self.accounts, self.autoconnect = load_config()
        except UserError as e:
            self.conf_error = e
            self.accounts, self.autoconnect = [], []
        self.by_id = dict((a.id, a) for a in self.accounts)
        self.adapters = {}

    def check_config(self):
        if self.conf_error is not None:
            raise self.conf_error

    def account(self, ident):
        self.check_config()
        a = self.by_id.get(ident)
        if a is None:
            raise UserError("no chat account %r - see tvchat.conf" % ident)
        return a

    def adapter(self, account):
        ad = self.adapters.get(account.id)
        if ad is None:
            ad = self.adapters[account.id] = ADAPTERS[account.protocol](self, account)
        return ad

    def conv(self, conv_id):
        ident, _, target = conv_id.partition("/")
        acct = self.account(ident)
        conv = acct.convs.get(conv_id)
        if conv is None:
            raise UserError("no conversation %r" % conv_id)
        return conv

    def set_state(self, account, state, detail=""):
        account.state, account.detail = state, detail
        self.events.push("state", account.id, state, detail)

    def ensure_conv(self, account, target, kind, title=None):
        cid = "%s/%s" % (account.id, target)
        conv = account.convs.get(cid)
        if conv is None:
            conv = account.convs[cid] = Conversation(account, target, kind, title)
            self.events.push("conv-new", conv.id, conv.kind, conv.unread, conv.title)
        return conv

    def remove_conv(self, conv):
        if conv.account.convs.pop(conv.id, None) is not None:
            self.events.push("conv-gone", conv.id, conv.kind, conv.unread, conv.title)

    def add_message(self, conv, msg, count=True):
        conv.history.append(msg)
        self.events.push("msg", *msg.fields())
        if count:
            conv.unread += 1
            self.events.push("unread", conv.id, conv.unread)

    def set_topic(self, conv, text):
        conv.topic = text
        self.events.push("topic", conv.id, text)

    def mark_read(self, conv, msgid=None):
        for msg in conv.history:
            if "r" not in msg.flags:
                msg.flags += "r"
            if msgid is not None and msg.id == msgid:
                break
        if conv.unread:
            conv.unread = 0
            self.events.push("unread", conv.id, 0)

    def connect(self, account):
        try:
            self.adapter(account).connect()
        except UserError as e:
            self.set_state(account, "error", str(e))
            raise

    def start(self):
        """Connect the [chat] autoconnect accounts; a failure is an event."""
        for ident in self.autoconnect:
            try:
                self.connect(self.by_id[ident])
            except UserError:
                pass                     # already reported as a state event

    def close(self):
        for ad in self.adapters.values():
            try:
                ad.disconnect()
            except Exception:
                pass


_CHAT = None


def _chat():
    global _CHAT
    if _CHAT is None:
        _CHAT = Chat()
    return _CHAT


def cmd_accounts(a):
    chat = _chat()
    chat.check_config()
    for acct in chat.accounts:
        sys.stdout.write(acct.wire())
    return 0


def cmd_connect(a):
    chat = _chat()
    chat.connect(chat.account(a.account))
    return 0


def cmd_disconnect(a):
    chat = _chat()
    chat.adapter(chat.account(a.account)).disconnect()
    return 0


def cmd_convs(a):
    chat = _chat()
    accts = [chat.account(a.account)] if a.account else (chat.check_config() or chat.accounts)
    for acct in accts:
        for conv in acct.convs.values():
            sys.stdout.write(conv.wire())
    return 0


def cmd_join(a):
    chat = _chat()
    acct = chat.account(a.account)
    sys.stdout.write(chat.adapter(acct).join(a.target).id + "\n")
    return 0


def cmd_part(a):
    chat = _chat()
    conv = chat.conv(a.conv)
    chat.adapter(conv.account).part(conv)
    return 0


def cmd_send(a):
    chat = _chat()
    conv = chat.conv(a.conv)
    sys.stdout.write(chat.adapter(conv.account).send(conv, a.text) + "\n")
    return 0


def cmd_history(a):
    conv = _chat().conv(a.conv)
    msgs = list(conv.history)
    if a.before:
        ids = [m.id for m in msgs]
        msgs = msgs[:ids.index(a.before)] if a.before in ids else []
    for msg in msgs[-a.limit:] if a.limit > 0 else []:
        sys.stdout.write(line(*msg.fields()))
    return 0


def cmd_members(a):
    conv = _chat().conv(a.conv)
    for addr, disp, role in sorted(conv.members.values(),
                                   key=lambda e: (ROLE_RANK.get(e[2], 9), e[0].lower())):
        sys.stdout.write(line(addr, disp, role))
    return 0


def cmd_mark_read(a):
    chat = _chat()
    chat.mark_read(chat.conv(a.conv), a.msgid)
    return 0


def cmd_events(a):
    for ev in _chat().events.drain(a.after):
        sys.stdout.write(EventQueue.wire(ev))
    return 0


def cmd_ping(a):
    sys.stdout.write("pong\n")
    return 0


# --------------------------------------------------------------------------
# irc-tail: a debugging aid, no tvmail needed.  Connects one account and
# prints its events as plain text; a typed line is sent to the newest
# channel or query ("/join #chan" and "/quit" also work).
# --------------------------------------------------------------------------
def _tail_format(fields):
    etype, rest = fields[0], fields[1:]
    if etype == "msg":
        _, conv, when, _, who, flags, text = rest
        hhmm = time.strftime("%H:%M", time.localtime(parse_server_time(when) or 0))
        where = conv.split("/", 1)[1]
        if "a" in flags:
            return "%s %s * %s %s" % (hhmm, where, who, text)
        if "n" in flags and not who:
            return "%s %s -- %s" % (hhmm, where, text)
        mark = "-%s-" if "n" in flags else "<%s>"
        return "%s %s %s %s" % (hhmm, where, mark % who, text)
    return "** %s %s" % (etype, " ".join(str(x) for x in rest))


def cmd_irc_tail(a):
    chat = _chat()
    acct = chat.account(a.account)
    if acct.protocol != "irc":
        raise UserError("%s is not an IRC account" % acct.id)
    loop = chat.loop
    out = sys.stdout
    cur = [None]
    seen = [None]
    fd = sys.stdin.fileno()

    def pump():
        for seq, fields in chat.events.drain(seen[0]):
            seen[0] = seq
            if fields[0] == "conv-new" and fields[2] != "server":
                cur[0] = fields[1]
            out.write(_tail_format(fields) + "\n")
        out.flush()
        loop.call_later(0.1, pump)

    def on_stdin():
        data = os.read(fd, 4096)
        if not data:
            loop.stop()
            return
        for ln in data.decode("utf-8", "replace").splitlines():
            try:
                if ln.startswith("/quit"):
                    loop.stop()
                elif ln.startswith("/join "):
                    cur[0] = chat.adapter(acct).join(ln[6:]).id
                elif ln.strip() and cur[0]:
                    chat.adapter(acct).send(chat.conv(cur[0]), ln)
                elif ln.strip():
                    out.write("** nothing to send to yet - /join a channel\n")
            except UserError as e:
                out.write("** %s\n" % e)

    chat.connect(acct)
    loop.add_reader(fd, on_stdin)
    loop.call_later(0, pump)
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    finally:
        chat.close()
        for seq, fields in chat.events.drain(seen[0]):
            out.write(_tail_format(fields) + "\n")
    return 0


# --------------------------------------------------------------------------
# serve: the persistent co-process tvmail talks to.  Same framing as
# tvmail-backend serve, but stdin is one of several sources in the selectors
# loop, so incoming chat traffic is read (and queued) while the UI is idle.
# Every request is answered at once - anything slow (connecting) replies
# immediately and reports progress as events - so a reply always beats the
# UI's 8 s read timeout.
# --------------------------------------------------------------------------
class _CapStream:
    """stdout stand-in while a verb runs: its output becomes the reply body."""

    def __init__(self):
        self.buffer = io.BytesIO()

    def write(self, s):
        self.buffer.write(s.encode("utf-8", "replace") if isinstance(s, str) else s)
        return len(s)

    def flush(self):
        pass

    def isatty(self):
        return False


_SERVE_BLOCKED = frozenset(("serve", "irc-tail"))


def dispatch(parser, argv):
    """Run one request argv.  Returns (status:int, body:bytes)."""
    if argv and argv[0] in _SERVE_BLOCKED:
        return 2, ("tvchat-backend: '%s' is not available in serve mode\n"
                   % argv[0]).encode("utf-8")
    real = sys.stdout
    cap = _CapStream()
    sys.stdout = cap
    try:
        ns = parser.parse_args(argv)
        return (ns.fn(ns) or 0), cap.buffer.getvalue()
    except UserError as e:
        return 1, (str(e) + "\n").encode("utf-8", "replace")
    except SystemExit as e:                      # argparse: unknown verb &c
        code = e.code
        if isinstance(code, str):
            cap.write(code if code.endswith("\n") else code + "\n")
            return 2, cap.buffer.getvalue()
        return (int(code) if code else 0), cap.buffer.getvalue()
    except Exception as e:                       # keep the server alive
        cap.write("tvchat-backend: %s: %s\n" % (type(e).__name__, e))
        return 2, cap.buffer.getvalue()
    finally:
        sys.stdout = real


class _ArgParser(argparse.ArgumentParser):
    """argparse that says what went wrong in the reply body (serve mode has
    stderr pointed at /dev/null) instead of printing usage to stderr."""

    def error(self, message):
        raise SystemExit("%s: %s" % (self.prog, message))


def cmd_serve(a):
    raw_out = getattr(sys.stdout, "buffer", sys.stdout)
    try:                                         # stray output mustn't hit the TUI
        sys.stderr = open(os.devnull, "w")
    except OSError:
        pass
    parser = build_parser()
    chat = _chat()
    loop = chat.loop
    fd = sys.stdin.fileno()
    pending = [b""]

    def emit(status, body):
        raw_out.write(("%d %d\n" % (status, len(body))).encode("ascii") + body)
        raw_out.flush()

    def handle(text):
        text = text.strip()
        if not text:
            return
        if text in ("quit", "exit"):
            loop.stop()
            return
        try:
            argv = shlex.split(text)
        except ValueError:
            emit(2, b"tvchat-backend serve: unparseable request line\n")
            return
        try:
            st, body = dispatch(parser, argv)
        except Exception as e:
            st, body = 2, ("tvchat-backend serve: %s\n" % e).encode("utf-8")
        emit(st, body)

    def on_stdin():
        data = os.read(fd, 65536)
        if not data:                             # parent closed the pipe
            if pending[0]:
                handle(pending[0].decode("utf-8", "replace"))
            loop.stop()
            return
        pending[0] += data
        while b"\n" in pending[0] and loop.running:
            req, pending[0] = pending[0].split(b"\n", 1)
            handle(req.decode("utf-8", "replace"))

    emit(0, b"ready")                            # handshake banner
    loop.add_reader(fd, on_stdin)
    chat.start()                                 # [chat] autoconnect
    try:
        loop.run()
    finally:
        loop.remove_reader(fd)
        chat.close()
    return 0


def build_parser():
    ap = _ArgParser(prog="tvchat-backend", add_help=True)
    ap.add_argument("--version", action="version",
                    version="tvchat-backend %s" % __version__)
    sub = ap.add_subparsers(dest="cmd", parser_class=_ArgParser)
    sub.required = True

    p = sub.add_parser("accounts"); p.set_defaults(fn=cmd_accounts)
    p = sub.add_parser("connect"); p.add_argument("account"); p.set_defaults(fn=cmd_connect)
    p = sub.add_parser("disconnect"); p.add_argument("account"); p.set_defaults(fn=cmd_disconnect)
    p = sub.add_parser("convs"); p.add_argument("account", nargs="?"); p.set_defaults(fn=cmd_convs)
    p = sub.add_parser("join"); p.add_argument("account"); p.add_argument("target"); p.set_defaults(fn=cmd_join)
    p = sub.add_parser("part"); p.add_argument("conv"); p.set_defaults(fn=cmd_part)
    p = sub.add_parser("send"); p.add_argument("conv"); p.add_argument("text"); p.set_defaults(fn=cmd_send)
    p = sub.add_parser("history"); p.add_argument("conv"); p.add_argument("--before")
    p.add_argument("--limit", type=int, default=50); p.set_defaults(fn=cmd_history)
    p = sub.add_parser("members"); p.add_argument("conv"); p.set_defaults(fn=cmd_members)
    p = sub.add_parser("mark-read"); p.add_argument("conv"); p.add_argument("msgid", nargs="?")
    p.set_defaults(fn=cmd_mark_read)
    p = sub.add_parser("events"); p.add_argument("--after", type=int); p.set_defaults(fn=cmd_events)
    p = sub.add_parser("ping"); p.set_defaults(fn=cmd_ping)
    p = sub.add_parser("serve"); p.set_defaults(fn=cmd_serve)
    p = sub.add_parser("irc-tail"); p.add_argument("account"); p.set_defaults(fn=cmd_irc_tail)
    return ap


def main():
    a = build_parser().parse_args(sys.argv[1:])
    try:
        sys.exit(a.fn(a))
    except UserError as e:
        sys.exit("tvchat-backend: %s" % e)
    except BrokenPipeError:
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
