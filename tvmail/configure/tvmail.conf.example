# tvmail-backend configuration.
#
# Copy to  ~/.config/tvmail/tvmail.conf  and edit.  Only the client machines
# need this; the master (the host that owns the mailstore) can run without it.
#
# Already run GNU Mailutils' mail(1) against the same server?  You can skip
# [imap]/[smtp] host/port/user entirely - tvmail falls back to the same
# ~/.mail  it uses:
#     mailbox { mailbox-pattern "imap://chris@cpbee:143/INBOX"; };
#     mailer  { url "smtp://cpbee:25"; };
# Anything you DO set below wins over ~/.mail.
#
# NO PASSWORDS HERE.  Put them in ~/.mu-tickets (chmod 600, URL-encoded):
#     *://chris:s3cr3t@cpbee.lan
# ...or ~/.netrc (chmod 600):
#     machine cpbee.lan  login chris  password s3cr3t
# ...or the environment: $TVMAIL_IMAP_PASS / $TVMAIL_SMTP_PASS.

[service]
# local : always use the on-disk mbox + local sendmail (the master).
#         Defaults to this if unset (or the file is missing entirely), so the
#         master needs no [service] section at all.
# remote: always talk IMAP/SMTP to the master (a client) - must be set
#         explicitly.  Override per-run with $TVMAIL_MODE.
mode   = remote

[imap]
host = cpbee
port = 993
ssl  = true
user = chris
# verify the server cert (default true).  Set false for a LAN box with the
# stock self-signed cert, or point cafile at its .pem.
verify = false
#cafile = /etc/ssl/certs/cpbee-dovecot.pem

[smtp]
host     = cpbee
port     = 587
starttls = true
user     = chris
# same as [imap] verify/cafile above - the master's self-signed cert on
# STARTTLS needs one or the other, or send fails with CERTIFICATE_VERIFY_FAILED.
verify = false
#cafile = /etc/ssl/certs/cpbee-dovecot.pem
# This box can't receive replies, so submitted mail always goes out as this
# address (header From + envelope) - the master just relays it, no rewrite.
from     = chris via LAN <cwp@u-l.ca>
# If the master's Postfix trusts the LAN in mynetworks you can skip auth -
# most LAN-facing Postfixes only offer AUTH on 587/465, not on 25, so this is
# usually required (not just optional) when pointing at port 25:
#   port = 25   auth = false     (no ~/.netrc / ~/.mu-tickets entry needed)
auth = true

# These are the DEFAULTS - the whole [folders] section is optional.  Listed so
# you can retarget one: e.g. reuse an existing "Junk E-mail" instead of "Junk".
# 'dead.letter' is always a local file, never an IMAP folder.
#   sent  = <blank>   stop filing a copy of every outgoing message
#   spam  = <blank>   stop the F3 / pull spam sweep
[folders]
saved  = Archive
trash  = Trash
drafts = Drafts
sent   = Sent
spam   = Junk

# Spam filing is ON by default.  F3 (and, on the master, every pull) moves
# INBOX messages whose Subject contains this tag into the spam folder.
# Default is SpamAssassin's ***SPAM*** prefix; change it if your server differs.
[spam]
subject = ***SPAM***

# Master (local mode) only: what F3 / 'tvmail-backend pull' runs to fetch
# remote mail.  Unset = mail-setup's 'mail-pull' wrapper (whichever of pop-pull
# or getmail ./configure.sh set up last), else a bare 'pop-pull'.  A command
# line; $TVMAIL_PULL overrides it for one run.
#[local]
#pull = getmail --getmaildir ~/.config/getmail

# File > Out of office...  keeps a Sieve "vacation" script on the master and
# switches it over ManageSieve (port 4190).  The master needs managesieve
# enabled: run mail-setup's configure-sieve.sh there as root (INSTALL.md,
# "Out of office").  Every key is optional; host and user follow [imap].
# The password is looked up like the IMAP one (~/.mu-tickets, ~/.netrc).
#[sieve]
#host = cpbee
#port = 4190
#tls  = starttls          # none = send the password in clear (don't)
#verify = false           # default follows [imap] verify
# The addresses mail for you arrives at.  A master like cpbee hides behind one
# public mailbox (cwp@u-l.ca): it fetches that mail over POP and delivers it to
# a local user, and rewrites local senders back to it on the way out - a NAT.
# Incoming mail is addressed to the PUBLIC address, and the server only answers
# mail addressed to one of these, so list it.  Together with [smtp] from, your
# ~/.mail mailer user and (on the master) your own line in /etc/postfix/generic
# this forms the default for the dialog's Addresses field.  Per user: each
# local user has their own tvmail.conf, script and addresses.
#addresses = cwp@u-l.ca
# Plus addressing: ONE public mailbox shared by several local users.  Mail for
# cwp+chris@u-l.ca lands in cwp@u-l.ca and the part after the "+" says whose it
# is.  plus = true lists cwp+chris@u-l.ca instead of cwp@u-l.ca; both lists the
# two; false (default) leaves the addresses as given.  tag defaults to your
# local user name.  This only affects what the vacation reply answers - the
# mail still has to be sorted to the right local user on arrival (the puller
# routes on the tag) and sent out with the tagged sender (postfix generic map).
#plus = true
#tag  = chris

# The terminal while tvmail runs (read by tvmail itself).
[ui]
# n (the default): no talk(1) requests or write / wall messages from ordinary
#   users land on top of the windows - the terminal's group-write bit is
#   cleared, as `mesg n` does, and put back on exit.  Root's messages still
#   get through: Ctrl-L (Window > Redraw screen) clears them off the screen.
# y: leave the terminal as it is.
#mesg = n
