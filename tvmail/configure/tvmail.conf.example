# tvmail-backend configuration.
#
# Copy to  ~/.config/tvmail/tvmail.conf  and edit.  Only the client machines
# need this; the master (the host that owns the mailstore) can run without it.
#
# Already run GNU Mailutils' mail(1) against the same server?  You can skip
# [imap]/[smtp] host/port/user entirely - tvmail falls back to the same
# ~/.mail  it uses:
#     mailbox { mailbox-pattern "imap://chris@cmpi:143/INBOX"; };
#     mailer  { url "smtp://cmpi:25"; };
# Anything you DO set below wins over ~/.mail.
#
# NO PASSWORDS HERE.  Put them in ~/.mu-tickets (chmod 600, URL-encoded):
#     *://chris:s3cr3t@cmpi.lan
# ...or ~/.netrc (chmod 600):
#     machine cmpi.lan  login chris  password s3cr3t
# ...or the environment: $TVMAIL_IMAP_PASS / $TVMAIL_SMTP_PASS.

[service]
# local : always use the on-disk mbox + local sendmail (the master).
#         Defaults to this if unset (or the file is missing entirely), so the
#         master needs no [service] section at all.
# remote: always talk IMAP/SMTP to the master (a client) - must be set
#         explicitly.  Override per-run with $TVMAIL_MODE.
mode   = remote

[imap]
host = cmpi
port = 993
ssl  = true
user = chris
# verify the server cert (default true).  Set false for a LAN box with the
# stock self-signed cert, or point cafile at its .pem.
verify = false
#cafile = /etc/ssl/certs/cmpi-dovecot.pem

[smtp]
host     = cmpi
port     = 587
starttls = true
user     = chris
# same as [imap] verify/cafile above - the master's self-signed cert on
# STARTTLS needs one or the other, or send fails with CERTIFICATE_VERIFY_FAILED.
verify = false
#cafile = /etc/ssl/certs/cmpi-dovecot.pem
# This box can't receive replies, so submitted mail always goes out as this
# address (header From + envelope) - the master just relays it, no rewrite.
from     = chris via LAN <cwp@u-l.ca>
# If the master's Postfix trusts the LAN in mynetworks you can skip auth -
# most LAN-facing Postfixes only offer AUTH on 587/465, not on 25, so this is
# usually required (not just optional) when pointing at port 25:
#   port = 25   auth = false     (no ~/.netrc / ~/.mu-tickets entry needed)
auth = true

# These are the DEFAULTS - the whole [folders] section is optional.  Listed so
# you can retarget one: e.g. reuse an existing "Junk E-mail" instead of "Junk".
# 'dead.letter' is always a local file, never an IMAP folder.
#   sent  = <blank>   stop filing a copy of every outgoing message
#   spam  = <blank>   stop the F3 / pull spam sweep
[folders]
saved  = Archive
trash  = Trash
drafts = Drafts
sent   = Sent
spam   = Junk

# Spam filing is ON by default.  F3 (and, on the master, every pull) moves
# INBOX messages whose Subject contains this tag into the spam folder.
# Default is SpamAssassin's ***SPAM*** prefix; change it if your server differs.
[spam]
subject = ***SPAM***
