def describe(it, date=None):
    if it.kind == "event":
        ev = it.read_event()
        d = date or ev.date.isoformat()
        day = dt.date.fromisoformat(d)
        s = "%s %s" % (WEEKDAYS[day.weekday()].capitalize(), d)
        if ev.start:
            s += " " + ev.start + ("-" + ev.end if ev.end else "")
        s = "%s - %s" % (ev.summary, s)
        return s + (" (%s)" % ev.location if ev.location else "")
    t = it.read_todo()
    return "to do: %s%s" % (t.summary, " (due %s)" % t.due.isoformat() if t.due else "")


