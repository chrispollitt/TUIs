class _Cap:
    def __init__(self):
        self.buffer = io.BytesIO()

    def write(self, s):
        self.buffer.write(s.encode("utf-8", "replace") if isinstance(s, str) else s)
        return len(s)

    def flush(self):
        pass

    def isatty(self):
        return False


class _ArgParser(argparse.ArgumentParser):
    def error(self, message):
        raise SystemExit("%s: %s" % (self.prog, message))


def dispatch(parser, argv):
    if argv and argv[0] == "serve":
        return 2, b"tvcal-backend: 'serve' is not available in serve mode\n"
    real, cap = sys.stdout, _Cap()
    sys.stdout = cap
    try:
        ns = parser.parse_args(argv)
        return (ns.fn(ns) or 0), cap.buffer.getvalue()
    except UserError as e:
        return 1, (str(e) + "\n").encode("utf-8", "replace")
    except SystemExit as e:
        code = e.code
        if isinstance(code, str):
            cap.write(code if code.endswith("\n") else code + "\n")
            return 2, cap.buffer.getvalue()
        return (int(code) if code else 0), cap.buffer.getvalue()
    except Exception as e:
        _log.exception("request %r failed", argv)
        cap.write("tvcal-backend: %s: %s\n" % (type(e).__name__, e))
        return 2, cap.buffer.getvalue()
    finally:
        sys.stdout = real


def cmd_serve(a):
    raw_out = getattr(sys.stdout, "buffer", sys.stdout)
    try:
        sys.stderr = open(os.devnull, "w")
    except OSError:
        pass
    parser = build_parser()

    def emit(status, body):
        raw_out.write(("%d %d\n" % (status, len(body))).encode("ascii") + body)
        raw_out.flush()

    emit(0, b"ready")
    for text in sys.stdin:
        text = text.strip()
        if not text:
            continue
        if text in ("quit", "exit"):
            break
        try:
            argv = shlex.split(text)
        except ValueError:
            emit(2, b"tvcal-backend serve: unparseable request line\n")
            continue
        t0 = time.monotonic()
        st, body = dispatch(parser, argv)
        emit(st, body)
        if argv[:1] != ["due"] or body:
            _log.debug("request: %s -> %d, %d bytes, %.1f ms", text[:200], st, len(body),
                       (time.monotonic() - t0) * 1000)
    return 0


def build_parser():
    ap = _ArgParser(prog="tvcal-backend", add_help=True)
    ap.add_argument("--version", action="version", version="tvcal-backend %s" % __version__)
    ap.add_argument("--debug", nargs="?", const="debug.tvcal.backend.log", metavar="FILE")
    ap.add_argument("--trace", nargs="?", const="trace.tvcal.backend.log", metavar="FILE")
    sub = ap.add_subparsers(dest="cmd", parser_class=_ArgParser)
    sub.required = True

    def ev_opts(p):
        for o in ("date", "start", "end", "days", "location", "notes", "repeat", "interval", "until", "remind"):
            p.add_argument("--" + o, default=None)

    def todo_opts(p):
        for o in ("due", "prio", "cats", "notes"):
            p.add_argument("--" + o, default=None)

    def add(name, fn, *args, **kw):
        p = sub.add_parser(name)
        for x in args:
            p.add_argument(x)
        p.set_defaults(fn=fn)
        return p

    add("serve", cmd_serve)
    add("ping", cmd_ping)
    add("range", cmd_range, "frm", "to")
    add("show", cmd_show, "uid")
    p = add("add-event", cmd_add_event)
    ev_opts(p)
    p.add_argument("words", nargs="*")
    p = add("set-event", cmd_set_event, "uid")
    ev_opts(p)
    p.add_argument("words", nargs="*")
    p = add("todos", cmd_todos)
    p.add_argument("--all", action="store_true")
    p = add("add-todo", cmd_add_todo)
    todo_opts(p)
    p.add_argument("words", nargs="*")
    p = add("set-todo", cmd_set_todo, "uid")
    todo_opts(p)
    p.add_argument("--summary", default=None)
    p = add("done", cmd_done, "uid")
    p.add_argument("--undo", action="store_true")
    add("rm", cmd_rm, "uid")
    p = add("find", cmd_find)
    p.add_argument("words", nargs="*")
    add("due", cmd_due)
    p = add("describe", cmd_describe, "uid")
    p.add_argument("date", nargs="?", default=None)
    p = add("ics", cmd_ics)
    p.add_argument("uid", nargs="?", default="")
    add("import", cmd_import, "file")
    add("mail-event", cmd_mail_event, "uid", "address")
    add("has-tvmail", cmd_has_tvmail)
    add("requests", cmd_requests)
    add("pending", cmd_pending)
    add("pending-get", cmd_pending_get, "id")
    add("pending-drop", cmd_pending_drop, "id")
    add("check-config", cmd_check_config, "file")
    add("settings", cmd_settings)
    p = add("norm-date", cmd_norm_date)
    p.add_argument("words", nargs="*")
    p = add("floyd", cmd_floyd)
    p.add_argument("words", nargs="*")
    return ap


_COMMANDS = frozenset(("serve", "ping", "range", "show", "add-event", "set-event", "todos", "add-todo",
                       "set-todo", "done", "rm", "find", "due", "describe", "ics", "import", "mail-event",
                       "has-tvmail", "requests", "pending", "pending-get", "pending-drop", "check-config",
                       "settings", "norm-date", "floyd"))


def _normalize_cli(argv):
    out = []
    for i, value in enumerate(argv):
        if value in ("--debug", "--trace"):
            nxt = argv[i + 1] if i + 1 < len(argv) else None
            if nxt is None or nxt.startswith("-") or nxt in _COMMANDS:
                out.append(value + ("=debug.tvcal.backend.log" if value == "--debug" else "=trace.tvcal.backend.log"))
                continue
        out.append(value)
    return out


def main():
    a = build_parser().parse_args(_normalize_cli(sys.argv[1:]))
    if a.debug:
        logging.basicConfig(filename=a.debug, level=logging.DEBUG,
                            format="%(asctime)s %(levelname)s %(message)s")
        _log.debug("tvcal-backend %s, python %s: %s", __version__, sys.version.split()[0], " ".join(sys.argv[1:]))

    def run():
        try:
            sys.exit(a.fn(a))
        except UserError as e:
            sys.exit("tvcal-backend: %s" % e)
        except BrokenPipeError:
            sys.exit(0)
        except KeyboardInterrupt:
            sys.exit(130)

    if a.trace:
        import cProfile
        profiler = cProfile.Profile()
        try:
            profiler.enable()
            run()
        finally:
            profiler.disable()
            profiler.dump_stats(a.trace)
    else:
        run()


if __name__ == "__main__":
    main()
