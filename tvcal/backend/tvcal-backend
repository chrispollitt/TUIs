def cover(ev, d):
    """All days an occurrence starting at d covers."""
    return [d + dt.timedelta(days=i) for i in range(ev.days if ev.allday else 1)]


def range_rows(store, lo, hi):
    rows = []
    for it in store.items("event"):
        ev = it.read_event()
        if ev.date is None:
            continue
        rep = ev.repeat_fields()[0]
        for s in occurrences(ev, lo - dt.timedelta(days=max(0, ev.days - 1)), hi):
            for d in cover(ev, s):
                if lo <= d <= hi:
                    rows.append((d.isoformat(), ev.start, ev.end, ev.uid, ev.summary, ev.location, rep,
                                 "" if ev.remind is None else ev.remind))
    rows.sort(key=lambda r: (r[0], r[1] or "00:00", r[4].lower()))
    return rows


def cmd_range(a):
    lo, hi = norm_date(a.frm), norm_date(a.to)
    if hi < lo or (hi - lo).days > 3700:
