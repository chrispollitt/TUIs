# --------------------------------------------------------- configuration ---
KNOWN = {"cal": {"file", "remind", "week_start"},
         "floyd": {"level"},
         "server": {"url", "user", "ca", "insecure", "mode"},
         "ui": {"share", "beep", "mesg", "idle"}}


def check_config(path):
    errors, warnings = [], []
    c = configparser.ConfigParser(interpolation=None)
    try:
        with open(path, encoding="utf-8") as fh:
            c.read_file(fh)
    except configparser.Error as e:
        return ["%s" % str(e).splitlines()[0]], [], ""
    except OSError as e:
        return ["cannot read %s: %s" % (path, e)], [], ""
    for sec in c.sections():
        if sec not in KNOWN:
            warnings.append("unknown section [%s]" % sec)
            continue
        for k in c[sec]:
            if k not in KNOWN[sec]:
                warnings.append("[%s] %s is not a setting" % (sec, k))
    r = c.get("cal", "remind", fallback="15").strip().lower()
    if r not in ("off", "no", "none", "-1", "") and not r.isdigit():
        errors.append("[cal] remind is a number of minutes, or off")
    w = c.get("cal", "week_start", fallback="mon").strip().lower()
    if w not in ("mon", "sun", "monday", "sunday"):
        errors.append("[cal] week_start is mon or sun")
    u = c.get("server", "url", fallback="").strip()
    if u and not u.startswith(("http://", "https://")):
        errors.append("[server] url is an http:// or https:// address of the calendar collection")
    if u and not c.get("server", "user", fallback="").strip():
        errors.append("[server] user is needed with a url")
    if c.get("server", "mode", fallback="").strip().lower() not in ("", "local", "remote"):
        errors.append("[server] mode is local or remote")
    f = c.get("cal", "file", fallback="")
    if f and not os.path.isdir(os.path.dirname(os.path.expanduser(f)) or "."):
        warnings.append("[cal] file: the directory does not exist yet (it is made when something is saved)")
    return errors, warnings, "calendar in %s" % (os.path.expanduser(f) if f else data_path())


def cmd_check_config(a):
    errors, warnings, summary = check_config(a.file)
    for e in errors:
        sys.stdout.write("error: %s\n" % e)
    for w in warnings:
        sys.stdout.write("warning: %s\n" % w)
    if not errors:
        sys.stdout.write("ok: %s\n" % summary)
    return 1 if errors else 0


# --------------------------------------------------------------- Floyd ---
# Floyd, the assistant of tvmail and tvchat, answers here too: the calculator, units, time zones,
# notes, and - because it is the calendar's own program - !todo, !cal and !event on the very list
# and calendar tvcal shows.  His words come from tvcommon's tvfloyd.py (beside this file, in
# ../../tvcommon/py in the source tree, or in ../share/tvcal once installed).
def _load_tvfloyd():
    import importlib.util
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (here, os.path.join(here, "..", "..", "tvcommon", "py"), os.path.join(here, "..", "share", "tvcal"),
              "/usr/local/share/tvcal", "/usr/share/tvcal"):
        path = os.path.join(d, "tvfloyd.py")
        if os.path.isfile(path):
            try:
                spec = importlib.util.spec_from_file_location("tvfloyd", path)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                return mod
            except Exception:
                _log.debug("cannot load %s", path, exc_info=True)
    return None


FLOYD_HELP = ("Floyd helps with: !todo [add TEXT | done N | rm N | clear], !cal [today | tomorrow | week | DATE], "
              "!event [DATE] [HH:MM[-HH:MM]] TITLE, !calc 12*7, !convert 5 km to mi, !time in Tokyo, !note TEXT.")


def cmd_floyd(a):
    """floyd TEXT: what Floyd says to that (one line each)."""
    tvf = _load_tvfloyd()
    text = " ".join(a.words).strip()
    if tvf is None:
        raise UserError("Floyd's words (tvfloyd.py) are not installed beside tvcal-backend")
    c = config()
    level = tvf.parse_level(os.environ.get("TVCAL_FLOYD_LEVEL") or c.get("floyd", "level", fallback=""), None) \
        or tvf.DEFAULT_LEVEL
    if level == "off":
        sys.stdout.write("Floyd is off. Set [floyd] level in tvcal.conf to wake him.\n")
        return 0
    notes = tvf.CalNotes(os.path.join(state_dir(), "notes.json"), tvcal=os.path.abspath(sys.argv[0]))
    verb, _, rest = text.lstrip("!").partition(" ")
    verb = verb.lower()
    if verb in ("help", "?", ""):
        sys.stdout.write(FLOYD_HELP + "\n")
        return 0
    try:
        arg = rest if verb not in ("todo", "note", "notes", "event", "appointment") else text.lstrip("!").partition(" ")[2]
        out = tvf.run_tool(verb, arg, notes, time.time())
        if out is None and tvf.at_least(level, "helpful"):
            out = tvf.natural(text, notes, time.time())
    except tvf.CalcError as e:
        out = "Floyd can't. %s" % e
    if out is None:
        out = ("Floyd doesn't understand, but Floyd likes the way you say it. " if tvf.at_least(level, "chatty")
               else "Floyd doesn't know that one. ") + "Say help."
    sys.stdout.write(out + "\n")
    return 0


