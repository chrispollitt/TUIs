def merge_into(store, comps):
    """Add VEVENT/VTODO comps (an update to a uid already here replaces it); count."""
    n = 0
    for c in comps:
        if c.name not in ("VEVENT", "VTODO"):
            continue
        uid = c.text("UID")
        if not uid:
            c.set("UID", new_uid())
        else:
            store.root.kids = [k for k in store.root.kids
                               if not (k.name in ("VEVENT", "VTODO") and k.text("UID") == uid)]
        if not c.get("DTSTAMP"):
            c.set("DTSTAMP", stamp())
        if c.name == "VEVENT" and Item(c).read_event().date is None:
            continue
        store.add(c)
        n += 1
    return n


def comps_of(roots):
    out = []
    for r in roots:
        if r.name == "VCALENDAR":
            out.extend(k for k in r.kids if k.name in ("VEVENT", "VTODO"))
        elif r.name in ("VEVENT", "VTODO"):
            out.append(r)
    return out


def read_small(path, limit=2 * 1024 * 1024):
    try:
        if os.path.getsize(path) > limit:
            raise UserError("%s is too big" % path)
        with open(path, "rb") as fh:
            return fh.read()
    except OSError as e:
        raise UserError("cannot read %s: %s" % (path, e))


def cmd_import(a):
    s = Store()
    comps = comps_of(parse_ics(read_small(os.path.expanduser(a.file)).decode("utf-8", "replace")))
    n = merge_into(s, comps)
    if n:
        s.save()
    sys.stdout.write("imported %d\n" % n)
    return 0


def find_tvmail_backend():
    found = shutil.which("tvmail-backend")
    if found:
        return found
    for d in ("/usr/local/bin", "~/bin", "~/.local/bin"):
        p = os.path.join(os.path.expanduser(d), "tvmail-backend")
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


