class UserError(Exception):
    pass


# ------------------------------------------------------------------ places ---
def conf_path():
    return os.environ.get("TVCAL_CONF") or os.path.expanduser("~/.config/tvcal/tvcal.conf")


def config():
    c = configparser.ConfigParser(interpolation=None)
    try:
        c.read(conf_path(), encoding="utf-8")
    except (configparser.Error, OSError):
        pass
    return c


def data_path():
    p = os.environ.get("TVCAL_DATA") or config().get("cal", "file", fallback="")
    return os.path.expanduser(p) if p else os.path.expanduser("~/.local/share/tvcal/calendar.ics")


def state_dir():
    d = os.environ.get("TVCAL_STATE")
    if d:
        return d
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "tvcal")


def requests_dir():
    return os.environ.get("TVCAL_REQUESTS") or os.path.join(state_dir(), "requests")


def default_remind():
    v = config().get("cal", "remind", fallback="15").strip().lower()
    if v in ("off", "no", "none", "-1", ""):
        return None
    try:
        return max(0, int(v))
    except ValueError:
        return 15


def _mkdirs(path):
    os.makedirs(path, mode=0o700, exist_ok=True)


def _write_atomic(path, data, mode=0o600):
    _mkdirs(os.path.dirname(path) or ".")
    tmp = "%s.tmp%d" % (path, os.getpid())
    with open(tmp, "wb") as fh:
        fh.write(data)
    try:
        os.chmod(tmp, mode)
    except OSError:
        pass
    os.replace(tmp, path)


# ------------------------------------------------------------- iCalendar ---
class Comp:
    """A component: NAME, its properties [name, params, value] (value as in the
    file, i.e. still escaped) and child components."""

    def __init__(self, name):
        self.name = name
        self.props = []
        self.kids = []

    def get(self, name):
        for p in self.props:
            if p[0] == name:
                return p
        return None

    def text(self, name, default=""):
        p = self.get(name)
        return unesc(p[2]) if p else default

    def set(self, name, value, params=""):
        """value None removes the property."""
        self.props = [p for p in self.props if p[0] != name]
        if value is not None:
            self.props.append([name, params, value])


def esc(s):
    return (s.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\r\n", "\\n").replace("\n", "\\n").replace("\r", "\\n"))


def unesc(s):
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            n = s[i + 1]
            out.append("\n" if n in "nN" else n)
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def unfold(text):
    lines = []
    for ln in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if ln[:1] in (" ", "\t") and lines:
            lines[-1] += ln[1:]
        else:
            lines.append(ln)
    return lines


def parse_line(ln):
    """NAME;PARAMS:VALUE -> (NAME, ";PARAMS", VALUE); the colon inside quotes does not count."""
    quoted = False
    for i, c in enumerate(ln):
        if c == '"':
            quoted = not quoted
        elif c == ":" and not quoted:
            head, value = ln[:i], ln[i + 1:]
            name, semi, params = head.partition(";")
            return name.upper(), (";" + params if semi else ""), value
    return None


def parse_ics(text):
    """The top-level components (VCALENDAR) of an iCalendar text."""
    roots, stack = [], []
    for ln in unfold(text):
        if not ln.strip():
            continue
        p = parse_line(ln)
        if p is None:
            continue
        name, params, value = p
        if name == "BEGIN":
            c = Comp(value.strip().upper())
            if stack:
                stack[-1].kids.append(c)
            else:
                roots.append(c)
            stack.append(c)
        elif name == "END":
            if stack:
                stack.pop()
        elif stack:
            stack[-1].props.append([name, params, value])
    return roots


def fold(line):
    b = line.encode("utf-8")
    if len(b) <= 75:
        return line
    out, cur, n = [], "", 0
    for ch in line:
        w = len(ch.encode("utf-8"))
        if n + w > (75 if not out else 74):
            out.append(cur)
            cur, n = "", 0
        cur += ch
        n += w
    out.append(cur)
    return "\r\n ".join(out)


def write_comp(c, out):
    out.append("BEGIN:" + c.name)
    for name, params, value in c.props:
        out.append(fold("%s%s:%s" % (name, params, value)))
    for k in c.kids:
        write_comp(k, out)
    out.append("END:" + c.name)


def comp_text(c):
    out = []
    write_comp(c, out)
    return "\r\n".join(out) + "\r\n"


# ---------------------------------------------------------------- dates ---
DATE_RE = re.compile(r"^(\d{4})-(\d{2})-(\d{2})$")
TIME_RE = re.compile(r"^(\d{1,2}):(\d{2})$")
WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
BYDAY = ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]


def today():
    return dt.date.today()


def norm_date(s, base=None):
    """today, tomorrow, +N, a weekday (the next one), MM-DD (the next one), YYYY-MM-DD, YYYYMMDD."""
    s = (s or "").strip().lower()
    base = base or today()
    if not s:
        raise UserError("a date is needed")
    if s == "today":
        return base
    if s == "tomorrow":
        return base + dt.timedelta(days=1)
    if s == "yesterday":
        return base - dt.timedelta(days=1)
    m = re.match(r"^\+(\d+)$", s)
    if m:
        return base + dt.timedelta(days=int(m.group(1)))
    if s[:3] in WEEKDAYS and (len(s) == 3 or "monday tuesday wednesday thursday friday saturday sunday".find(s) >= 0):
        ahead = (WEEKDAYS.index(s[:3]) - base.weekday()) % 7 or 7
        return base + dt.timedelta(days=ahead)
    for pat in (r"^(\d{4})-(\d{1,2})-(\d{1,2})$", r"^(\d{4})(\d{2})(\d{2})$"):
        m = re.match(pat, s)
        if m:
            try:
                return dt.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
            except ValueError:
                raise UserError("not a date: %s" % s)
    m = re.match(r"^(\d{1,2})-(\d{1,2})$", s)
    if m:
        try:
            d = dt.date(base.year, int(m.group(1)), int(m.group(2)))
        except ValueError:
            raise UserError("not a date: %s" % s)
        return d if d >= base else dt.date(base.year + 1, d.month, d.day)
    raise UserError("not a date: %s (try 2026-11-05, 11-05, tomorrow, +3, fri)" % s)


def norm_time(s):
    s = (s or "").strip()
    if not s:
        return ""
    m = TIME_RE.match(s)
    if not m and re.match(r"^\d{3,4}$", s):
        m = re.match(r"^(\d{1,2})(\d{2})$", s)
    if not m:
        raise UserError("not a time: %s (try 14:30)" % s)
    h, mi = int(m.group(1)), int(m.group(2))
    if h > 23 or mi > 59:
        raise UserError("not a time: %s" % s)
    return "%02d:%02d" % (h, mi)


def ics_date(d):
    return d.strftime("%Y%m%d")


def ics_dt(d, t):
    return "%sT%s00" % (ics_date(d), t.replace(":", ""))


def parse_ics_when(prop):
    """(date, 'HH:MM' or '', allday) from a DTSTART/DTEND/DUE property; None if unreadable."""
    if prop is None:
        return None
    params, v = prop[1].upper(), prop[2].strip()
    try:
        if "VALUE=DATE" in params and "DATE-TIME" not in params or len(v) == 8:
            d = dt.datetime.strptime(v[:8], "%Y%m%d").date()
            return d, "", True
        if v.endswith("Z"):
            u = dt.datetime.strptime(v, "%Y%m%dT%H%M%SZ").replace(tzinfo=dt.timezone.utc)
            loc = u.astimezone()
            return loc.date(), loc.strftime("%H:%M"), False
        x = dt.datetime.strptime(v[:15], "%Y%m%dT%H%M%S")
        return x.date(), x.strftime("%H:%M"), False
    except ValueError:
        return None


def parse_rrule(v):
    r = {}
    for part in v.split(";"):
        k, _, x = part.partition("=")
        r[k.upper()] = x
    return r


def trigger_minutes(v):
    """-PT15M / -P1D / PT0S -> minutes before the start (>= 0), or None."""
    m = re.match(r"^(-?)P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?$", v.strip())
    if not m:
        return None
    wk, dy, hr, mi, se = (int(x or 0) for x in m.group(2, 3, 4, 5, 6))
    n = wk * 10080 + dy * 1440 + hr * 60 + mi + se // 60
    return n if m.group(1) == "-" or n == 0 else 0


# ------------------------------------------------------------ the model ---
class Item:
    """Event or to-do view of a Comp."""

    def __init__(self, comp):
        self.c = comp
        self.kind = "event" if comp.name == "VEVENT" else "todo"
        self.uid = comp.text("UID")
        self.summary = comp.text("SUMMARY")
        self.notes = comp.text("DESCRIPTION")

    # -- events
    def read_event(self):
        c = self.c
        self.location = c.text("LOCATION")
        w = parse_ics_when(c.get("DTSTART"))
        if w is None:
            self.date, self.start, self.allday = None, "", True
        else:
            self.date, self.start, self.allday = w
        self.end, self.days = "", 1
        e = parse_ics_when(c.get("DTEND"))
        if e is not None and self.date is not None:
            if self.allday:
                self.days = max(1, (e[0] - self.date).days)
            elif e[0] == self.date:
                self.end = e[1]
            # a timed event ending on a later day: the end is not shown
        elif self.date is not None and not self.allday and c.get("DURATION"):
            mins = trigger_minutes("-" + c.get("DURATION")[2].lstrip("+")) or 0
            if mins:
                x = dt.datetime.combine(self.date, dt.time(int(self.start[:2]), int(self.start[3:]))) \
                    + dt.timedelta(minutes=mins)
                if x.date() == self.date:
                    self.end = x.strftime("%H:%M")
        rr = c.get("RRULE")
        self.rrule = parse_rrule(rr[2]) if rr else None
        self.exdates = set()
        for p in c.props:
            if p[0] == "EXDATE":
                for v in p[2].split(","):
                    d = parse_ics_when(["EXDATE", p[1], v])
                    if d:
                        self.exdates.add(d[0])
        self.remind = None
        for k in c.kids:
            if k.name == "VALARM":
                t = k.get("TRIGGER")
                if t:
                    self.remind = trigger_minutes(t[2])
                    break
        return self

    def repeat_fields(self):
        r = self.rrule
        if not r:
            return "none", 1, ""
        freq = r.get("FREQ", "").lower()
        if freq not in ("daily", "weekly", "monthly", "yearly"):
            return "none", 1, ""
        until = ""
        if r.get("UNTIL"):
            w = parse_ics_when(["UNTIL", "", r["UNTIL"]])
            until = w[0].isoformat() if w else ""
        return freq, int(r.get("INTERVAL", "1") or 1), until

    # -- to-dos
    def read_todo(self):
        c = self.c
        w = parse_ics_when(c.get("DUE"))
        self.due = w[0] if w else None
        try:
            self.prio = int(c.text("PRIORITY", "0") or 0)
        except ValueError:
            self.prio = 0
        st = c.text("STATUS").upper()
        self.done = st == "COMPLETED" or c.text("PERCENT-COMPLETE") == "100"
        self.cats = c.text("CATEGORIES")
        return self


def occurrences(ev, lo, hi):
    """Start dates of event ev (read) within lo..hi, repeats expanded; an event
    spanning days is returned by its first day, the caller covers the rest."""
    d0 = ev.date
    if d0 is None:
        return []
    r = ev.rrule
    out = []
    if not r or r.get("FREQ", "") not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        if lo <= d0 <= hi:
            out.append(d0)
        return out
    freq = r["FREQ"]
    try:
        step = max(1, int(r.get("INTERVAL", "1") or 1))
    except ValueError:
        step = 1
    count = int(r["COUNT"]) if r.get("COUNT", "").isdigit() else None
    end = hi
    if r.get("UNTIL"):
        w = parse_ics_when(["UNTIL", "", r["UNTIL"]])
        if w:
            end = min(end, w[0])
    cap = 20000

    def emit(d, i):
        if count is not None and i >= count:
            return False
        if d > end:
            return False
        if d >= lo and d not in ev.exdates:
            out.append(d)
        return True

    if freq == "DAILY":
        n = 0
        if count is None and lo > d0:
            n = (lo - d0).days // step
        d = d0 + dt.timedelta(days=n * step)
        while cap > 0 and emit(d, n):
            n, cap = n + 1, cap - 1
            d = d0 + dt.timedelta(days=n * step)
    elif freq == "WEEKLY":
        days = sorted(BYDAY.index(x[-2:]) for x in r.get("BYDAY", "").split(",") if x[-2:] in BYDAY) \
            or [d0.weekday()]
        wk0 = d0 - dt.timedelta(days=d0.weekday())
        w, i = 0, 0
        if count is None and lo > d0:
            w = max(0, ((lo - wk0).days // 7) // step - 1)
        done = False
        while not done and cap > 0:
            for wd in days:
                d = wk0 + dt.timedelta(days=7 * step * w + wd)
                if d < d0:
                    continue
                if not emit(d, i):
                    done = True
                    break
                i += 1
            w, cap = w + 1, cap - 1
            if wk0 + dt.timedelta(days=7 * step * w) > end:
                break
    elif freq == "MONTHLY":
        n, i = 0, 0
        while cap > 0:
            mi = d0.month - 1 + n * step
            y, m = d0.year + mi // 12, mi % 12 + 1
            if dt.date(y, m, 1) > end:
                break
            if d0.day <= _cal.monthrange(y, m)[1]:
                if not emit(dt.date(y, m, d0.day), i):
                    break
                i += 1
            n, cap = n + 1, cap - 1
    else:  # YEARLY
        n, i = 0, 0
        while cap > 0:
            y = d0.year + n * step
            if y > end.year:
                break
            if d0.month != 2 or d0.day != 29 or _cal.isleap(y):
                if not emit(dt.date(y, d0.month, d0.day), i):
                    break
                i += 1
            n, cap = n + 1, cap - 1
    return out


# ---------------------------------------------------------- the server ---
class Remote:
    """The calendar on the server (a CalDAV collection, Radicale on cpbee): the whole
    collection is one GET (an .ics of everything), a changed item one PUT, a removed one a
    DELETE.  A copy is kept in the state directory: reads within CACHE_SECONDS use it, and
    when the server cannot be reached reads fall back on it (writes then fail, saying so).
    Settings: [server] url, user, ca (a certificate file) or insecure = yes; the password comes
    from $TVCAL_PASS, ~/.mu-tickets or ~/.netrc, never the configuration file."""

    CACHE_SECONDS = 15

    def __init__(self, url, user, ca="", insecure=False):
        self.url = url if url.endswith("/") else url + "/"
        self.user = user
        self.ca, self.insecure = ca, insecure
        self.offline = False

    @staticmethod
    def configured():
        c = config()
        url = c.get("server", "url", fallback="").strip()
        mode = c.get("server", "mode", fallback="").strip().lower()
        if mode == "local" or not url or os.environ.get("TVCAL_DATA"):
            return None
        return Remote(url, c.get("server", "user", fallback="").strip(), c.get("server", "ca", fallback="").strip(),
                      c.get("server", "insecure", fallback="no").strip().lower() in ("yes", "true", "1", "y"))

    def cache_path(self):
        return os.path.join(state_dir(), "cache.ics")

    def touch(self):
        try:
            os.utime(self.cache_path(), None)
        except OSError:
            pass

    def password(self):
        pw = os.environ.get("TVCAL_PASS")
        if pw:
            return pw
        import urllib.parse
        u = urllib.parse.urlparse(self.url)
        # ~/.mu-tickets first - the file tvmail and tvchat share: https://USER:PASS@HOST[:PORT]  # allowlist secret
        # (scheme * matches any); only an entry for this very user counts
        try:
            with open(os.environ.get("TVMAIL_MU_TICKETS") or os.path.expanduser("~/.mu-tickets"),
                      encoding="utf-8", errors="replace") as fh:
                for ln in fh:
                    ln = ln.strip()
                    if not ln or ln.startswith("#"):
                        continue
                    t = urllib.parse.urlparse(ln)
                    if (t.scheme in ("https", "http", "*") or ln.startswith("*://")) and \
                            (ln.split("://", 1)[-1].rpartition("@")[2].split("/")[0].partition(":")[0].lower()
                             == (u.hostname or "").lower()):
                        tail = ln.split("://", 1)[-1]
                        cred = tail.rpartition("@")[0]
                        user, _, pw = cred.partition(":")
                        port = tail.rpartition("@")[2].split("/")[0].partition(":")[2]
                        if urllib.parse.unquote(user) == self.user and pw and (not port or not u.port or
                                                                             port == str(u.port)):
                            return urllib.parse.unquote(pw)
        except OSError:
            pass
        # ~/.netrc holds other logins for the same machine (mail, IRC): match host AND login exactly,
        # "host:port" first (what configure-radicale.sh writes), then the host alone
        wanted = [("%s:%s" % (u.hostname, u.port)) if u.port else None, u.hostname or ""]
        found = {}
        try:
            with open(os.path.expanduser("~/.netrc"), encoding="utf-8", errors="replace") as fh:
                toks = fh.read().split()
        except OSError:
            toks = []
        cur = None
        i = 0
        while i < len(toks):
            t = toks[i]
            if t in ("machine", "default") and (t == "default" or i + 1 < len(toks)):
                cur = {"machine": toks[i + 1] if t == "machine" else "*"}
                i += 2 if t == "machine" else 1
                continue
            if cur is not None and t in ("login", "password", "account") and i + 1 < len(toks):
                cur[t] = toks[i + 1]
                if t == "password" and "login" in cur:
                    found.setdefault((cur["machine"], cur["login"]), cur["password"])
                i += 2
                if "login" in cur and "password" in cur:
                    found.setdefault((cur["machine"], cur["login"]), cur["password"])
                continue
            i += 1
        for m in wanted:
            if m and (m, self.user) in found:
                return found[(m, self.user)]
        return ""

    def request(self, method, url, body=None, headers=None):
        import urllib.request, urllib.error, ssl, base64
        req = urllib.request.Request(url, data=body, method=method, headers=headers or {})
        tok = base64.b64encode(("%s:%s" % (self.user, self.password())).encode("utf-8")).decode("ascii")
        req.add_header("Authorization", "Basic " + tok)
        ctx = None
        if url.startswith("https"):
            ctx = ssl.create_default_context(cafile=os.path.expanduser(self.ca) if self.ca else None)
            if self.insecure:
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
        try:
            with urllib.request.urlopen(req, timeout=8, context=ctx) as r:
                return r.status, r.read()
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                raise UserError("the calendar server refused the login for %s (password: $TVCAL_PASS, ~/.mu-tickets or ~/.netrc)"
                                % (self.user or "(no user)"))
            if e.code == 404 and method == "GET":
                return 404, b""
            raise UserError("the calendar server said %d %s" % (e.code, e.reason))
        except (urllib.error.URLError, OSError) as e:
            raise ConnectionError(str(getattr(e, "reason", e)))

    def fetch(self):
        cache = self.cache_path()
        try:
            if time.time() - os.path.getmtime(cache) < self.CACHE_SECONDS:
                with open(cache, "rb") as fh:
                    return fh.read().decode("utf-8", "replace")
        except OSError:
            pass
        try:
            st, data = self.request("GET", self.url, headers={"Accept": "text/calendar"})
        except ConnectionError as e:
            self.offline = True
            try:
                with open(cache, "rb") as fh:
                    return fh.read().decode("utf-8", "replace")
            except OSError:
                raise UserError("cannot reach the calendar server (%s) and there is no copy yet" % e)
        text = data.decode("utf-8", "replace") if st == 200 else ""
        _write_atomic(cache, text.encode("utf-8"))
        return text

    def item_url(self, uid):
        import urllib.parse
        return self.url + urllib.parse.quote(uid, safe="") + ".ics"

    def wrap(self, comp):
        cal = Comp("VCALENDAR")
        cal.props = [["VERSION", "", "2.0"], ["PRODID", "", "-//chrispollitt//tvcal %s//EN" % __version__]]
        cal.kids = [comp]
        return comp_text(cal).encode("utf-8")

    def put(self, uid, comp):
        if self.offline:
            raise UserError("the calendar server cannot be reached: nothing was saved")
        try:
            self.request("PUT", self.item_url(uid), self.wrap(comp), {"Content-Type": "text/calendar; charset=utf-8"})
        except ConnectionError as e:
            raise UserError("the calendar server cannot be reached (%s): nothing was saved" % e)

    def delete(self, uid):
        if self.offline:
            raise UserError("the calendar server cannot be reached: nothing was deleted")
        try:
            self.request("DELETE", self.item_url(uid))
        except ConnectionError as e:
            raise UserError("the calendar server cannot be reached (%s): nothing was deleted" % e)
        except UserError as e:
            if " 404 " not in str(e):
                raise


# ----------------------------------------------------------------- store ---
class Store:
    def __init__(self, path=None):
        self.path = path or data_path()
        self.root = None
        self.remote = Remote.configured() if path is None else None
        if self.remote:
            self.path = self.remote.cache_path()
        self.load()

    def load(self):
        try:
            if self.remote:
                text = self.remote.fetch()
            else:
                with open(self.path, "rb") as fh:
                    text = fh.read().decode("utf-8", "replace")
            roots = parse_ics(text)
        except FileNotFoundError:
            roots = []
        except OSError as e:
            raise UserError("cannot read %s: %s" % (self.path, e))
        self.before = {}
        cals = [r for r in roots if r.name == "VCALENDAR"]
        if cals:
            self.root = cals[0]
            for extra in cals[1:]:
                self.root.kids.extend(extra.kids)
        else:
            self.root = Comp("VCALENDAR")
            self.root.props = [["VERSION", "", "2.0"], ["PRODID", "", "-//chrispollitt//tvcal %s//EN" % __version__]]
        if self.remote:     # what the server held, to send only what changed
            self.before = {k.text("UID"): comp_text(k) for k in self.root.kids if k.name in ("VEVENT", "VTODO")}

    def save(self):
        if self.remote:
            now = {k.text("UID"): k for k in self.root.kids if k.name in ("VEVENT", "VTODO")}
            for uid, k in now.items():
                if self.before.get(uid) != comp_text(k):
                    self.remote.put(uid, k)
            for uid in self.before:
                if uid not in now:
                    self.remote.delete(uid)
            self.before = {u: comp_text(k) for u, k in now.items()}
        _write_atomic(self.path, comp_text(self.root).encode("utf-8"))
        if self.remote:
            self.remote.touch()

    def items(self, kind=None):
        for k in self.root.kids:
            if k.name in ("VEVENT", "VTODO"):
                it = Item(k)
                if kind is None or it.kind == kind:
                    yield it

    def find(self, uid):
        for it in self.items():
            if it.uid == uid:
                return it
        raise UserError("no event or to-do %s" % uid)

    def add(self, comp):
        self.root.kids.append(comp)

    def remove(self, uid):
        n = len(self.root.kids)
        self.root.kids = [k for k in self.root.kids if not (k.name in ("VEVENT", "VTODO") and k.text("UID") == uid)]
        if len(self.root.kids) == n:
            raise UserError("no event or to-do %s" % uid)


def stamp():
    return dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def new_uid():
    host = os.uname().nodename if hasattr(os, "uname") else "tvcal"
    return "%s@%s" % (uuid.uuid4(), host)


def new_comp(name):
