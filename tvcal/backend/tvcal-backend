def field(s):
    return str(s).replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r")


def row(*fields):
    sys.stdout.write("\t".join(field(f) for f in fields) + "\n")


def prio_sort(p):
    return p if p else 10          # 1 first, none last


def todo_row(it):
