def apply_event(c, o, creating):
    """Set the VEVENT c from the options o (argparse namespace: None = leave alone)."""
    if o.summary is not None:
        s = o.summary.strip()
        if not s:
            raise UserError("an event needs a title")
        c.set("SUMMARY", esc(s))
    cur = Item(c).read_event() if not creating else None
    date = cur.date if cur else None
    start = cur.start if cur else ""
    end = cur.end if cur else ""
    days = cur.days if cur else 1
    allday = cur.allday if cur else True
    if o.date is not None:
        date = norm_date(o.date)
    if date is None:
        raise UserError("an event needs a date")
    if o.start is not None:
        start = norm_time(o.start)
        allday = not start
        if allday:
            end = ""
    if o.end is not None:
        end = norm_time(o.end)
        if end and not start:
            raise UserError("an end time needs a start time")
    if o.days is not None:
        days = max(1, int(o.days or 1))
    if start and end and end <= start:
        raise UserError("the event ends (%s) before it starts (%s)" % (end, start))
    if allday:
        c.set("DTSTART", ics_date(date), ";VALUE=DATE")
        c.set("DTEND", ics_date(date + dt.timedelta(days=days)), ";VALUE=DATE")
    else:
        c.set("DTSTART", ics_dt(date, start))
        if end:
            c.set("DTEND", ics_dt(date, end))
        else:
            c.set("DTEND", None)
    if o.location is not None:
        c.set("LOCATION", esc(o.location.strip()) if o.location.strip() else None)
    if o.notes is not None:
        c.set("DESCRIPTION", esc(o.notes.strip()) if o.notes.strip() else None)
    if o.repeat is not None or o.interval is not None or o.until is not None:
        old = Item(c).read_event() if not creating else None
        rep, interval, until = old.repeat_fields() if old and old.rrule else ("none", 1, "")
        if o.repeat is not None:
            rep = (o.repeat or "none").lower()
            if rep not in ("none", "daily", "weekly", "monthly", "yearly"):
                raise UserError("repeat is none, daily, weekly, monthly or yearly")
        if o.interval is not None:
            interval = max(1, int(o.interval or 1))
        if o.until is not None:
            until = norm_date(o.until, date).isoformat() if o.until.strip() else ""
        if rep == "none":
            c.set("RRULE", None)
            c.set("EXDATE", None)
        else:
            rule = "FREQ=%s" % rep.upper()
            if interval > 1:
                rule += ";INTERVAL=%d" % interval
            if until:
                rule += ";UNTIL=%s" % until.replace("-", "")
            keep = old.rrule.get("BYDAY") if old and old.rrule and old.rrule.get("FREQ", "").lower() == rep else None
            if keep:
                rule += ";BYDAY=" + keep
            c.set("RRULE", rule)
    if o.remind is not None:
        c.kids = [k for k in c.kids if k.name != "VALARM"]
        v = o.remind.strip().lower()
        if v not in ("", "off", "no", "none", "-1"):
            try:
                mins = int(v)
            except ValueError:
                raise UserError("remind is a number of minutes before, or off")
            a = Comp("VALARM")
            a.props = [["ACTION", "", "DISPLAY"], ["DESCRIPTION", "", "Reminder"],
                       ["TRIGGER", "", "-PT%dM" % mins if mins else "PT0S"]]
            c.kids.append(a)
    c.set("LAST-MODIFIED", stamp())


def apply_todo(c, o, creating):
    if o.summary is not None:
        s = o.summary.strip()
        if not s:
            raise UserError("a to-do needs some text")
        c.set("SUMMARY", esc(s))
    if o.due is not None:
        c.set("DUE", ics_date(norm_date(o.due)) if o.due.strip() else None, ";VALUE=DATE")
        if not o.due.strip():
            c.set("DUE", None)
    if o.prio is not None:
        p = int(o.prio or 0)
        if not 0 <= p <= 9:
            raise UserError("priority is 0 (none) to 9; 1 is the highest")
        c.set("PRIORITY", str(p) if p else None)
    if o.cats is not None:
        c.set("CATEGORIES", ",".join(esc(x.strip()) for x in o.cats.split(",") if x.strip()) or None)
    if o.notes is not None:
        c.set("DESCRIPTION", esc(o.notes.strip()) if o.notes.strip() else None)
    if creating:
        c.set("STATUS", "NEEDS-ACTION")
    c.set("LAST-MODIFIED", stamp())


