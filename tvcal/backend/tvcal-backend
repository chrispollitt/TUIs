def fired_path():
    return os.path.join(state_dir(), "fired.json")


def cmd_due(a):
    """Reminders that fell due; each is reported once."""
    now = dt.datetime.now()
    try:
        with open(fired_path(), encoding="utf-8") as fh:
            fired = json.load(fh)
    except (OSError, ValueError):
        fired = {}
    fired = {k: v for k, v in fired.items() if now.timestamp() - v < 4 * 86400}
    s = Store()
    out = []
    t = now.date()
    for it in s.items("event"):
        ev = it.read_event()
        if ev.remind is None or ev.date is None:
            continue
        for d in occurrences(ev, t - dt.timedelta(days=1), t + dt.timedelta(days=1)):
            begin = dt.datetime.combine(d, dt.time(int(ev.start[:2]), int(ev.start[3:]))) if ev.start \
                else dt.datetime.combine(d, dt.time(9, 0))
            fire = begin - dt.timedelta(minutes=ev.remind)
            over = begin + dt.timedelta(hours=1) if ev.start else dt.datetime.combine(d, dt.time(23, 59))
            key = "e:%s:%s" % (ev.uid, d.isoformat())
            if fire <= now < over and key not in fired:
                fired[key] = now.timestamp()
                out.append(("event", ev.uid, d.isoformat(), ev.start, ev.summary,
                            max(0, int((begin - now).total_seconds() // 60))))
    for it in s.items("todo"):
        td = it.read_todo()
        if td.done or td.due is None or td.due > t:
            continue
        key = "t:%s:%s" % (td.uid, t.isoformat())
        if key not in fired:
            fired[key] = now.timestamp()
            out.append(("todo", td.uid, td.due.isoformat(), td.summary, "today" if td.due == t else "overdue"))
    if out:
        _write_atomic(fired_path(), json.dumps(fired).encode("utf-8"))
    for r in out:
        row(*r)
    return 0


