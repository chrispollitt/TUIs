    sys.stdout.write("yes\n" if find_tvmail_backend() else "no\n")
    return 0


def cmd_mail_event(a):
    tvmail = find_tvmail_backend()
    if not tvmail:
        raise UserError("tvmail is not installed here: this hands the invitation to tvmail to send")
    if "@" not in a.address or " " in a.address:
        raise UserError("not an address: %s" % a.address)
    s = Store()
    it = s.find(a.uid)
    cal = Comp("VCALENDAR")
    cal.props = [["VERSION", "", "2.0"], ["PRODID", "", "-//chrispollitt//tvcal %s//EN" % __version__],
                 ["METHOD", "", "REQUEST" if it.kind == "event" else "PUBLISH"]]
    cal.kids = [it.c]
    msg = email.message.EmailMessage()
    msg["Subject"] = "Invitation: " + it.summary if it.kind == "event" else "To do: " + it.summary
    msg["To"] = a.address
    msg.set_content("%s\n\nThe calendar entry is attached (an .ics file any calendar program opens).\n"
                    % describe(it))
    msg.add_attachment(comp_text(cal).encode("utf-8"), maintype="text", subtype="calendar",
                       filename="invite.ics", params={"method": "REQUEST" if it.kind == "event" else "PUBLISH"})
    p = subprocess.run([tvmail, "send", "--to", a.address], input=msg.as_bytes(), stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, timeout=90)
    if p.returncode != 0:
        raise UserError((p.stdout.decode("utf-8", "replace").strip() or "tvmail-backend send failed")[:300])
    sys.stdout.write("sent to %s\n" % a.address)
    return 0


