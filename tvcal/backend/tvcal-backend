    return {"kind": "todo", "source": source, "summary": td.summary or "(no title)",
            "date": td.due.isoformat() if td.due else "", "notes": td.notes, "prio": td.prio, "cats": td.cats,
            "uid": td.uid, "ics": comp_text(c)}


def requests_once():
    """Take in the request files; returns notices."""
    d = requests_dir()
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".req"))
    except OSError:
        return []
    notes = []
    pend = pending_load()
    for n in names[:30]:
        path = os.path.join(d, n)
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                line = fh.readline().strip()
        except OSError:
            continue
        try:
            os.unlink(path)
        except OSError:
            pass
        kind, _, arg = line.partition(" ")
        kind, _, source = kind.partition("@")
        source = source or "another program"
        arg = arg.strip()
        new = []
        try:
            if kind == "todo" and arg:
                new.append({"kind": "todo", "source": source, "summary": " ".join(arg.split())[:300], "date": "",
                            "notes": "", "prio": 0, "cats": ""})
            elif kind == "event" and arg:
                m = ONE_LINER.match(arg)
                day, t0, t1, title = m.group(1), m.group(2), m.group(3), " ".join(m.group(4).split())
                new.append({"kind": "event", "source": source, "summary": title[:300] or "(no title)",
                            "date": norm_date(day).isoformat() if day else today().isoformat(),
                            "start": norm_time(t0) if t0 else "", "end": norm_time(t1) if t1 else "",
                            "location": "", "notes": ""})
            elif kind in ("eml", "ics") and arg:
                raw = read_small(arg)
                if kind == "eml":
                    msg = email.message_from_bytes(raw, policy=email.policy.default)
                    comps = []
                    for part in msg.walk():
                        if part.get_content_type() == "text/calendar":
                            comps += comps_of(parse_ics(part.get_content()))
                    if comps:
                        new += [x for x in (pending_from_comp(c, source) for c in comps) if x]
                    else:
                        subj = " ".join(str(msg.get("Subject", "")).split()) or "(no subject)"
                        who = str(msg.get("From", ""))
                        when = None
                        try:
                            when = email.utils.parsedate_to_datetime(str(msg.get("Date", ""))).date()
                        except (TypeError, ValueError):
                            pass
                        new.append({"kind": "event", "source": source, "summary": subj[:300],
                                    "date": max(when, today()).isoformat() if when else today().isoformat(),
                                    "start": "", "end": "", "location": "",
                                    "notes": "From: %s\nDate: %s" % (who, msg.get("Date", ""))})
                    # a copy tvmail left in our own state directory is ours to remove
                    if os.path.abspath(arg).startswith(os.path.abspath(state_dir()) + os.sep):
                        try:
                            os.unlink(arg)
                        except OSError:
                            pass
                else:
                    new += [x for x in (pending_from_comp(c, source)
                                        for c in comps_of(parse_ics(raw.decode("utf-8", "replace")))) if x]
            else:
                notes.append("ignored a request I do not understand: %s" % line[:60])
                continue
        except UserError as e:
            notes.append("request '%s' failed: %s" % (line[:50], e))
            continue
        for x in new:
            if len(pend) >= PENDING_MAX:
                notes.append("too many requests are waiting - Calendar > Incoming...")
                break
            x["id"] = uuid.uuid4().hex[:8]
            pend.append(x)
            notes.append("%s asks to add %s \"%s\" - Calendar > Incoming..." %
                         (source, "a to-do" if x["kind"] == "todo" else "an event", x["summary"][:50]))
    if names:
        pending_save(pend)
    return notes


def cmd_requests(a):
    for n in requests_once():
        row("notice", n)
    return 0


