def pending_from_comp(c, source):
    it = Item(c)
    if c.name == "VEVENT":
        ev = it.read_event()
        if ev.date is None:
            return None
        return {"kind": "event", "source": source, "summary": ev.summary or "(no title)", "date": ev.date.isoformat(),
