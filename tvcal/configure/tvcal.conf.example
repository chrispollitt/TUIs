# tvcal configuration (read by tvcal-backend).  NO PASSWORDS HERE: $TVCAL_PASS or ~/.mu-tickets
# (https://USER:PASS@HOST:PORT, percent-encoded, mode 0600; ~/.netrc works too).  Nothing in this file is needed for a  # allowlist secret
# local calendar (~/.local/share/tvcal/calendar.ics).

[server]
# The calendar on the server (Radicale on the mail / chat host; see configure-radicale.sh).
# One collection per calendar: https://HOST/radicale/USER/calendar/
#url = https://cpbee.cmnet/radicale/chris/calendar/
#user = chris
# A self-signed server: its certificate file, or (not recommended) insecure = yes
#ca = ~/.config/tvcal/cpbee-ca.pem
#insecure = no
# mode = local ignores the url for one machine
#mode = remote

[cal]
# default reminder for a new event: minutes before, or off
#remind = 15
# mon or sun
#week_start = mon

[ui]
# which toasts go to tvmail and tvchat on their own: error (default), warn, info, off.
# Reminders always go.
#share = error
#beep = n
#mesg = n

# Floyd, the assistant (F7).  level: off | minimal | helpful | chatty (the default) | clippy
[floyd]
# The master Floyd (tvchat-floyd on the server): when `server` answers, HE answers - one memory, and Claude
# from the server (so this machine needs no Claude CLI).  When it does not (cpbee down, laptop elsewhere),
# the local Floyd below answers by himself.  Leave `server` out to stay local.  !status says which.
#server = cpbee            # HOST or HOST:PORT (default port 7077)
#token = ...               # the shared secret from the server's floyd-gate.token
#server_timeout = 2        # seconds before giving up (a miss is not retried for a minute)
#level = chatty
# !claude QUESTION in his window asks the Claude CLI (read-only: only the tools named in claude_tools, no
# MCP servers, no skills); the answer appears in the window when it is ready.  claude = no turns it off.
#claude = yes
#claude_cmd = claude
#claude_tools = Read,Grep,Glob
#claude_model =
#claude_timeout = 120
#claude_lines = 10
#claude_dir = ~
# where he keeps what he learns (!learn, !addquote); "none" = nowhere
#memory = ~/.local/share/tvfloyd/memory.json

[contacts]
# The address book on the server (Radicale, CardDAV): File > Contacts... adds, edits and deletes entries in tvmail, tvchat
# and tvcal alike, and tvmail's Address book and To: field use it.  Nothing here is needed if tvcal's [server] is set: the
# book is then the one beside its calendar (calendar/ replaced by contacts/).  The password is found like tvcal's
# ($TVCONTACTS_PASS, ~/.mu-tickets, ~/.netrc).  The first of tvmail.conf, tvchat.conf, tvcal.conf with a url wins.
#url = https://cpbee.cmnet/radicale/chris/contacts/
#user = chris
#ca = ~/.config/tvmail/cpbee-ca.pem
#insecure = no
# A shared book (the family's), read together with your own; new entries ask which book, old ones stay where they are.
# Write it with:  tvcontacts shared https://cpbee:5232/chris/family/   (the server side: configure-radicale.sh share-book)
#shared = https://cpbee:5232/chris/family/
#shared_label = family
# enabled = no switches the address book off for every app
#enabled = yes
